---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section class="border-y border-gray-200 bg-cream-100 py-16 lg:py-20 dark:border-gray-800 dark:bg-gray-900">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      {
        stats.map((stat, index) => (
          <div
            class="text-center"
            data-animate="fade-in-up"
            data-delay={index * 100}
          >
            <div class="text-4xl font-bold text-primary-600 lg:text-5xl dark:text-primary-400">
              <span data-counter={stat.value}>0</span>
            </div>
            <div class="mt-2 text-sm font-medium text-gray-600 dark:text-gray-400">
              {stat.label}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
