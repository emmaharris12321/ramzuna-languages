---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  badge?: string;
  title: string;
  description: string;
  items: FaqItem[];
}

const { badge, title, description, items } = Astro.props;
---

<section id="faq" class="bg-white py-20 lg:py-28 dark:bg-gray-950">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      {
        badge && (
          <div
            class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300"
            data-animate="fade-in-up"
          >
            {badge}
          </div>
        )
      }
      <h2
        class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
        data-animate="fade-in-up"
        data-delay="100"
      >
        {title}
      </h2>
      <p
        class="mt-4 text-lg text-gray-600 dark:text-gray-400"
        data-animate="fade-in-up"
        data-delay="200"
      >
        {description}
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-3xl">
      <div class="divide-y divide-gray-200 dark:divide-gray-800">
        {
          items.map((item, index) => (
            <div
              class="py-6"
              data-animate="fade-in-up"
              data-delay={100 + index * 50}
            >
              <button
                type="button"
                data-faq-toggle
                class="flex w-full items-center justify-between text-left"
              >
                <span class="text-lg font-semibold text-gray-900 dark:text-white">
                  {item.question}
                </span>
                <span
                  class="ml-4 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition-transform duration-200 dark:bg-gray-800 dark:text-gray-400"
                  data-faq-icon
                >
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6v12M6 12h12"
                    />
                  </svg>
                </span>
              </button>
              <div
                class="overflow-hidden transition-all duration-300"
                style="max-height: 0px; opacity: 0;"
              >
                <p class="pt-4 text-gray-600 dark:text-gray-400">
                  {item.answer}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
