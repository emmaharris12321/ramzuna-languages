m}.grammar-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.grammar-grid article{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:24px}.grammar-grid h3{font-size:1.3rem;font-weight:600;margin-bottom:10px}.grammar-grid p,.grammar-grid li{font-size:.85rem;line-height:1.7}.grammar-grid ul{margin-top:12px;display:grid;gap:8px}fieldset{margin:22px 0;padding:18px;border:1px solid var(--line);border-radius:12px;background:var(--paper)}legend{font-weight:600;padding:0 8px}legend>span:first-child{color:#986345;font-size:.75rem;margin-right:10px}.choices{display:flex;flex-wrap:wrap;gap:10px}.choices label{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:8px;padding:10px 16px;cursor:pointer}.choices label:has(input:checked){outline:2px solid #738959}input{accent-color:#304e3d}.feedback{font-size:.8rem;margin-top:12px}fieldset[data-result=correct]{border-color:#53783c}fieldset[data-result=incorrect]{border-color:#a45939}.quiz-actions{display:flex;gap:12px;flex-wrap:wrap}button,.next{display:inline-block;background:#304e3d;color:#fff;padding:13px 22px;border-radius:10px;font-weight:600;cursor:pointer}button.secondary{background:var(--paper);color:var(--ink);border:1px solid var(--line)}#quiz-score{margin-top:16px}.speaking{list-style:decimal;padding-left:24px;display:grid;gap:12px;line-height:1.7}.example{font-family:Georgia,serif;font-size:1.5rem;background:var(--paper);padding:24px;border-radius:12px;margin:24px 0}.next{margin-top:24px}.source{border-top:1px solid var(--line);margin-top:48px;padding-top:24px;color:var(--muted)}.source h2{font-family:inherit;font-size:1rem;font-weight:600}.source p{font-size:.75rem;margin-top:10px}:focus-visible{outline:3px solid #a45b3c;outline-offset:4px}:global(.dark) .lesson-two{--ink:#eef1e6;--muted:#bec9bb;--paper:#202d26;--line:#425146;background:#16241d}:global(.dark) .lesson-hero{background:#23372b}:global(.dark) h1 em{color:#b6cca1}:global(.dark) .tip{background