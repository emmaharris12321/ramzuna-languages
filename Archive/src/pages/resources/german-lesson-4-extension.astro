.letter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:24px}.letter-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:20px;min-width:0}.letter-card h3{font-family:Georgia,serif;font-size:2.3rem;margin-bottom:12px}.letter-card audio{width:100%;display:block}.letter-card a,.letter-card p{display:inline-block;font-size:.75rem;margin-top:12px}.pending{opacity:.8}.dialogue{background:var(--paper);padding:24px;border-radius:16px;margin:24px 0}.dialogue p{margin:8px 0}.table-wrap{overflow-x:auto;margin:24px 0}table{width:100%;border-collapse:collapse;background:var(--paper)}caption{text-align:left;margin-bottom:12px}th,td{text-align:left;padding:12px;border-bottom:1px solid var(--line);font-size:.85rem}@media(max-width:600px){.letter-grid{grid-template-columns:1fr}}
