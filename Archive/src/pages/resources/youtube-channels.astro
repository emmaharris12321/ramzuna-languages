---
import Base from '@/layouts/Base.astro';

const channels = [
  {
    title: "Luke's English Podcast",
    url: 'https://www.youtube.com/@LukesEnglishPodcast',
    lang: 'English',
    description: 'Long-running podcast and video lessons for English learners, covering vocabulary, grammar and culture.',
  },
  {
    title: 'Elephant English Podcasts',
    url: 'https://www.youtube.com/@elephantenglishpodcasts',
    lang: 'English',
    description: 'Bite-sized English listening practice with clear, natural conversation.',
  },
  {
    title: 'IELTS Prep Channel',
    url: 'https://www.youtube.com/channel/UCglDIsg_Z9mE2oT9hsrbzFA',
    lang: 'English · IELTS',
    description: 'Video lessons and strategies to prepare for the IELTS exam across all four skills.',
  },
  {
    title: 'German Learning Channel',
    url: 'https://www.youtube.com/channel/UCbxb2fqe9oNgglAoYqsYOtQ',
    lang: 'German',
    description: 'Video lessons for learners building their German vocabulary, grammar and listening skills.',
  },
  {
    title: 'English with Lucy',
    url: 'https://www.youtube.com/@EnglishwithLucy',
    lang: 'English',
    description: 'Popular British English lessons covering pronunciation, vocabulary and everyday English.',
  },
  {
    title: 'English with Ronnie – EnglishLessons4U',
    url: 'https://www.youtube.com/user/EnglishLessons4U',
    lang: 'English',
    description: 'Part of engVid, Ronnie teaches pronunciation, grammar, vocabulary and slang for learners at every level, including IELTS and TOEFL prep.',
  },
  {
    title: 'BBC Learning English – 6 Minute Grammar',
    url: 'https://www.youtube.com/playlist?list=PLcetZ6gSk96_zHuVg6Ecy2F7j4Aq4valQ',
    lang: 'English',
    description: 'Short videos explaining one English grammar point at a time, in just six minutes each.',
  },
  {
    title: 'BBC Learning English – Everyday Phrases',
    url: 'https://www.youtube.com/playlist?list=PLcetZ6gSk9692RVJgFx4JXwFG4mWK0XGj',
    lang: 'English',
    description: 'Practical English vocabulary and expressions you can start using in everyday situations.',
  },
  {
    title: 'Anglo-Link',
    url: 'https://www.youtube.com/user/MinooAngloLink',
    lang: 'English',
    description: 'English grammar, vocabulary and pronunciation lessons to help learners build confidence speaking and listening.',
  },
  {
    title: "Let's Talk – Free English Lessons",
    url: 'https://www.youtube.com/user/learnexmumbai',
    lang: 'English',
    description: 'Free English lessons covering grammar, vocabulary and speaking practice for learners of all levels.',
  },
  {
    title: 'RealLife English',
    url: 'https://www.youtube.com/@RealLifeEnglish1',
    lang: 'English',
    description: 'Weekly lessons focused on natural, real-world spoken English, beyond the traditional classroom.',
  },
  {
    title: 'Learn English With TV Series',
    url: 'https://www.youtube.com/@LearnEnglishWithTVSeries',
    lang: 'English',
    description: 'Builds listening comprehension by teaching English through favourite TV shows, movies and talk shows.',
  },
  {
    title: 'Easy French',
    url: 'https://www.youtube.com/@easyfrench',
    lang: 'French',
    description: 'Street-interview style videos that teach real, everyday spoken French with subtitles.',
  },
  {
    title: 'Super Easy French',
    url: 'https://www.youtube.com/playlist?list=PLA5UIoabheFMChKPAUUNNEOd7BobVJVoQ',
    lang: 'French',
    description: 'A beginner-friendly playlist from Easy French, introducing basic vocabulary and phrases.',
  },
  {
    title: 'French Mornings with Elisa',
    url: 'https://www.youtube.com/@FrenchmorningswithElisa',
    lang: 'French',
    description: 'Grammar, vocabulary and culture lessons taught by a native French teacher.',
  },
  {
    title: 'Maintenant ou Jamais',
    url: 'https://www.youtube.com/@Maintenant_ou_jamais',
    lang: 'French',
    description: 'French-language videos for learners looking to build listening comprehension.',
  },
  {
    title: 'Français Authentique',
    url: 'https://www.youtube.com/@francaisauthentique',
    lang: 'French',
    description: 'Johan Tekfak teaches natural, authentic French through relaxed conversational videos.',
  },
  {
    title: 'Français avec Pierre',
    url: 'https://www.youtube.com/@francaisavecpierre',
    lang: 'French',
    description: 'Clear grammar and vocabulary lessons for French learners at every level.',
  },
  {
    title: 'Parlez-vous French',
    url: 'https://www.youtube.com/@parlezvousfrench',
    lang: 'French',
    description: 'Structured French lessons covering grammar, vocabulary and pronunciation.',
  },
  {
    title: 'French Pronunciation with Nastya',
    url: 'https://www.youtube.com/@french.pronunciation',
    lang: 'French',
    description: 'Focused lessons on French pronunciation, sounds and accent.',
  },
  {
    title: 'Learn German with Anja',
    url: 'https://www.youtube.com/c/LearnGermanwithAnja',
    lang: 'German',
    description: 'Comedy-style video series teaching everyday German through skits and stories.',
  },
  {
    title: 'Learn German Original – A1 Course',
    url: 'https://www.youtube.com/watch?v=RuGmc662HDg&list=PLF9mJC4RrjIhS4MMm0x72-qWEn1LRvPuW',
    lang: 'German',
    description: 'A structured A1 beginner course, starting with greetings and everyday basics.',
  },
  {
    title: 'GermanPod101',
    url: 'https://www.youtube.com/channel/UCTobWZV_HWGSoaRrhHyrJ-A',
    lang: 'German',
    description: 'Audio and video lessons covering German vocabulary, grammar and conversation.',
  },
  {
    title: 'GermanTalks',
    url: 'https://www.youtube.com/@TalksGerman',
    lang: 'German',
    description: 'German through authentic dialogues, everyday conversations and useful expressions.',
  },
  {
    title: 'Daily Deutsch',
    url: 'https://www.youtube.com/@Daily_Deutsch',
    lang: 'German',
    description: 'Structured lessons for A1 through B2, covering grammar, vocabulary and pronunciation.',
  },
  {
    title: 'DialogDE',
    url: 'https://www.youtube.com/@DialogDE-j8j',
    lang: 'German',
    description: 'Learn German through everyday dialogues, listening practice and pronunciation shadowing.',
  },
  {
    title: 'Easy Italian',
    url: 'https://www.youtube.com/@EasyItalian',
    lang: 'Italian',
    description: 'Street-interview style videos teaching real, everyday spoken Italian with subtitles.',
  },
];
---

<Base title="YouTube Channels" description="Curated YouTube channels sharing educational content for English, French, German and Italian learners.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">YouTube Channels</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Curated channels sharing educational content, lessons and discussions.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/resources" class="transition-colors hover:text-white">Resources</a>
        <span>/</span>
        <span class="text-white">YouTube Channels</span>
      </nav>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto grid max-w-4xl gap-6 sm:grid-cols-2">
        {
          channels.map((ch) => (
            <article class="group flex flex-col rounded-2xl bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-soft-lg dark:bg-gray-800">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-accent-100 text-lg dark:bg-accent-900/50">📹</div>
              <span class="mb-2 inline-flex w-fit items-center rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
                {ch.lang}
              </span>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                <a href={ch.url} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary-600 dark:hover:text-primary-400">
                  {ch.title}
                </a>
              </h3>
              <p class="mt-2 flex-1 text-gray-600 dark:text-gray-400">{ch.description}</p>
              <a
                href={ch.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex w-fit items-center gap-1 text-sm font-medium text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300"
              >
                Watch on YouTube <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))
        }
      </div>

      <p class="mx-auto mt-12 max-w-2xl text-center text-gray-600 dark:text-gray-400">
        Looking for more? Browse our full <a href="/resources/language-resources" class="font-medium text-primary-600 hover:underline dark:text-primary-400">Language Resources</a> directory.
      </p>
    </div>
  </section>
</Base>
