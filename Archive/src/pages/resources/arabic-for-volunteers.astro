---
import Base from '@/layouts/Base.astro';

interface Resource {
  title: string;
  url: string;
  description: string;
}

const resources: Resource[] = [
  {
    title: 'LearnArabicwithMaha',
    url: 'https://www.youtube.com/user/LearnArabicwithMaha',
    description: 'Arabic language lessons woven together with Middle Eastern culture, cuisine and travel.',
  },
  {
    title: 'PalWeb TV',
    url: 'https://www.youtube.com/@PalWebTV',
    description: 'Step-by-step tutorials in Palestinian Arabic, from basic vocabulary to more complex everyday expressions.',
  },
  {
    title: 'Arabic Conversations for Beginners',
    url: 'https://www.youtube.com/watch?v=BZ2MqjQBYE0&list=PLtMbzvT4n03rWi2DHGB6qLZgh9OXTKuIn',
    description: 'A beginner-friendly playlist of short, everyday Arabic conversations.',
  },
  {
    title: 'Arabic With Ibtisam',
    url: 'https://www.youtube.com/@arabicwithibtisam8441',
    description: 'Short, focused videos teaching Palestinian spoken Arabic to English speakers.',
  },
  {
    title: 'Typical Palestinian Food',
    url: 'https://www.youtube.com/watch?v=K2zjtenKs98',
    description: 'A Palestinian Arabic vocabulary video built around everyday food and expressions.',
  },
];
---

<Base title="Arabic Resources for Volunteers" description="A few free resources for volunteer teachers who want to pick up some Arabic and connect with their students' language and culture.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Arabic Resources for Volunteers</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        A few free resources for volunteer teachers who want to pick up some Arabic and connect with their students' language and culture.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/resources" class="transition-colors hover:text-white">Resources</a>
        <span>/</span>
        <span class="text-white">Arabic Resources for Volunteers</span>
      </nav>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2">
        {
          resources.map((res) => (
            <article class="group flex flex-col rounded-2xl bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-soft-lg dark:bg-gray-800">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-accent-100 text-lg dark:bg-accent-900/50">🗣️</div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                <a href={res.url} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary-600 dark:hover:text-primary-400">
                  {res.title}
                </a>
              </h3>
              <p class="mt-2 flex-1 text-gray-600 dark:text-gray-400">{res.description}</p>
              <a
                href={res.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex w-fit items-center gap-1 text-sm font-medium text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300"
              >
                Visit resource <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))
        }
      </div>

      <p class="mx-auto mt-12 max-w-2xl text-center text-gray-600 dark:text-gray-400">
        Want to learn more about Palestine itself? Explore our <a href="/resources/learning-about-palestine" class="font-medium text-primary-600 hover:underline dark:text-primary-400">Learning About Palestine</a> resources.
      </p>
    </div>
  </section>
</Base>
