---
import Base from '@/layouts/Base.astro';
---

<Base title="Transparency" description="How Ramzunā Languages is run, funded, and held accountable.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Transparency</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">How we are run, how we are funded, and how every donation is used.</p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Transparency</span>
      </nav>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container mx-auto max-w-4xl px-4 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="rounded-2xl border border-gray-200 p-6 dark:border-gray-800">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Nonprofit Status</h3>
          <p class="mt-1 text-gray-600 dark:text-gray-400">Ramzunā Languages operates as a volunteer-run nonprofit initiative, with financial oversight from our coordination team.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 p-6 dark:border-gray-800">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Where Donations Go</h3>
          <p class="mt-1 text-gray-600 dark:text-gray-400">Every learning programme stays free for students. Donations cover coordination, learning materials, and platform costs.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 p-6 dark:border-gray-800">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Educator Vetting</h3>
          <p class="mt-1 text-gray-600 dark:text-gray-400">Every volunteer educator is interviewed and trained before being matched with a student. See our Safeguarding page for details.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 p-6 dark:border-gray-800">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Annual Impact Report</h3>
          <p class="mt-1 text-gray-600 dark:text-gray-400">We publish a yearly summary of students reached, lessons delivered, and how funds were used. Request a copy any time.</p>
        </div>
      </div>

      <div class="prose mt-12 max-w-none dark:prose-invert">
        <p class="text-gray-600 dark:text-gray-400">
          We take accountability seriously. If you have questions about our finances, our vetting process, or how the
          programme is run, we are happy to answer them directly — just
          <a href="/contact" class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">contact us</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
