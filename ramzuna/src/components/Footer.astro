---
import { getSite } from '@/data/site';

const site = await getSite();

const currentYear = new Date().getFullYear();

const footerLinks = {
  explore: [
    { text: 'About Us', url: '/about' },
    { text: 'Our Name', url: '/our-name' },
    { text: 'FAQ', url: '/faq' },
    { text: 'Press', url: '/press' },
    { text: 'Resources', url: '/resources' },
    { text: 'Safeguarding', url: '/safeguarding' },
    { text: 'Transparency', url: '/transparency' },
  ],
  programmes: [
    { text: 'Language Lessons', url: '/english-classes' },
    { text: 'Conversation Sessions', url: '/services' },
    { text: 'Palestinian Voices', url: '/palestinian-voices' },
    { text: 'Volunteer With Us', url: '/volunteer' },
    { text: 'Volunteer Flyers', url: '/resources/volunteer-flyers' },
  ],
};

const socialLinks = [
  {
    label: 'Instagram',
    url: '#',
    icon: '<path d="M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465.66.256 1.216.6 1.772 1.153a4.908 4.908 0 0 1 1.153 1.772c.248.637.415 1.363.465 2.428.05 1.066.06 1.405.06 4.122s-.01 3.056-.06 4.122c-.05 1.065-.217 1.79-.465 2.428a4.883 4.883 0 0 1-1.153 1.772 4.915 4.915 0 0 1-1.772 1.153c-.637.248-1.363.415-2.428.465-1.066.05-1.405.06-4.122.06s-3.056-.01-4.122-.06c-1.065-.05-1.79-.217-2.428-.465a4.89 4.89 0 0 1-1.772-1.153 4.904 4.904 0 0 1-1.153-1.772c-.248-.637-.415-1.363-.465-2.428C2.013 15.056 2 14.717 2 12s.01-3.056.06-4.122c.05-1.065.217-1.79.465-2.428a4.88 4.88 0 0 1 1.153-1.772A4.897 4.897 0 0 1 5.45 2.525c.638-.248 1.363-.415 2.428-.465C8.944 2.01 9.283 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.25a3.25 3.25 0 1 1 0-6.5 3.25 3.25 0 0 1 0 6.5ZM17.25 5.5a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5Z" />',
  },
  {
    label: 'X',
    url: '#',
    icon: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231ZM17.083 19.77h1.833L7.084 4.126H5.117Z" />',
  },
  {
    label: 'YouTube',
    url: '#',
    icon: '<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .502 5.814 3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z" />',
  },
];
---

<footer class="bg-accent-900 pt-16 text-accent-100 lg:pt-24">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Brand Column -->
      <div class="lg:col-span-4">
        <a href={site.url} class="inline-flex items-center gap-3">
          {
            site.logo && (
              <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-white shadow-sm">
                <img src={site.logo.src} alt={site.logo.alt} class="h-full w-full object-cover" />
              </span>
            )
          }
          <span class="font-display text-xl font-semibold text-white">{site.name}</span>
        </a>
        <p class="mt-4 max-w-xs text-accent-200">
          {site.description}
        </p>

        <!-- Contact info -->
        <div class="mt-6 space-y-2">
          <a href={`mailto:${site.email}`} class="flex items-center gap-2 text-accent-200 transition-colors hover:text-white">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {site.email}
          </a>
          <div class="flex items-center gap-2 text-accent-200">
            <svg class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}
          </div>
        </div>

        <!-- Social -->
        <div class="mt-6 flex gap-3">
          {
            socialLinks.map((social) => (
              <a
                href={social.url}
                aria-label={social.label}
                class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" set:html={social.icon} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Link Columns -->
      <div class="grid gap-8 sm:grid-cols-3 lg:col-span-8">
        <div>
          <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-accent-200">
            Explore
          </h3>
          <ul class="mt-4 space-y-3">
            {
              footerLinks.explore.map((link) => (
                <li>
                  <a href={link.url} class="text-accent-100 transition-colors hover:text-white">
                    {link.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-accent-200">
            Our Programmes
          </h3>
          <ul class="mt-4 space-y-3">
            {
              footerLinks.programmes.map((link) => (
                <li>
                  <a href={link.url} class="text-accent-100 transition-colors hover:text-white">
                    {link.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-accent-200">
            Contact &amp; Newsletter
          </h3>
          <p class="mt-4 text-accent-100">
            Stories, programme updates, and ways to get involved — straight to your inbox.
          </p>
          <form
            class="mt-4 flex gap-2"
            onsubmit={`event.preventDefault(); const email = this.elements.email.value; window.location.href = 'mailto:${site.email}?subject=' + encodeURIComponent('Newsletter signup') + '&body=' + encodeURIComponent('Please add ' + email + ' to the newsletter list.');`}
          >
            <input
              type="email"
              name="email"
              required
              placeholder="Your email"
              class="w-full min-w-0 rounded-lg border border-white/25 bg-white/10 px-3 py-2.5 text-sm text-white placeholder-accent-200 focus:border-white/50 focus:outline-none"
            />
            <button
              type="submit"
              class="flex-shrink-0 rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-700"
            >
              Subscribe
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-accent-800 py-8 sm:flex-row"
    >
      <p class="text-sm text-accent-300">
        &copy; {currentYear} {site.name}. All rights reserved. A volunteer-powered nonprofit initiative.
      </p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 sm:pr-16">
        <a href="/privacy" class="text-sm text-accent-300 transition-colors hover:text-white">Privacy Policy</a>
        <a href="/terms" class="text-sm text-accent-300 transition-colors hover:text-white">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
