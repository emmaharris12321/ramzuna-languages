---
import Base from '@/layouts/Base.astro';
---

<Base title="Press" description="Media resources and press enquiries for Ramzunā Languages.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Press & Media</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Resources for journalists, bloggers, and partners covering Ramzunā Languages.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Press</span>
      </nav>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container mx-auto max-w-4xl px-4 lg:px-8">
      <div class="grid gap-8 sm:grid-cols-3">
        <div class="rounded-2xl bg-cream-100 p-8 text-center shadow-sm dark:bg-gray-900">
          <div class="text-4xl font-bold text-primary-600 dark:text-primary-400">3,000+</div>
          <div class="mt-2 text-sm font-medium text-gray-600 dark:text-gray-400">Students Reached</div>
        </div>
        <div class="rounded-2xl bg-cream-100 p-8 text-center shadow-sm dark:bg-gray-900">
          <div class="text-4xl font-bold text-primary-600 dark:text-primary-400">600+</div>
          <div class="mt-2 text-sm font-medium text-gray-600 dark:text-gray-400">Volunteer Educators</div>
        </div>
        <div class="rounded-2xl bg-cream-100 p-8 text-center shadow-sm dark:bg-gray-900">
          <div class="text-4xl font-bold text-primary-600 dark:text-primary-400">15+</div>
          <div class="mt-2 text-sm font-medium text-gray-600 dark:text-gray-400">Countries Represented</div>
        </div>
      </div>

      <div class="prose mt-16 max-w-none dark:prose-invert">
        <h2 class="font-display text-2xl font-semibold text-gray-900 dark:text-white">About Ramzunā Languages</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400">
          Ramzunā Languages is a volunteer-powered nonprofit initiative connecting Palestinian students with volunteer
          educators for free English, French, and German lessons. Every lesson is free, every educator volunteers
          their time, and the programme is run by a small coordination team supported entirely by donations.
        </p>

        <h2 class="font-display mt-12 text-2xl font-semibold text-gray-900 dark:text-white">Media Enquiries</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400">
          For interviews, brand assets, or media enquiries, please reach out to our team directly and we will get back to
          you within a few business days.
        </p>
      </div>

      <div class="mt-8 rounded-2xl border border-gray-200 bg-cream-100 p-6 dark:border-gray-800 dark:bg-gray-900">
        <p class="font-semibold text-gray-900 dark:text-white">Media Contact</p>
        <p class="mt-1 text-gray-600 dark:text-gray-400">
          Email: <a href="mailto:contacteam@ramzunalanguages.org" class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">contacteam@ramzunalanguages.org</a>
        </p>
        <a
          href="/contact"
          class="mt-4 inline-flex items-center justify-center rounded-lg bg-primary-600 px-6 py-3 text-sm font-medium text-white shadow-lg shadow-primary-600/25 transition-all hover:bg-primary-700"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Base>
