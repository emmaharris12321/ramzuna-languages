{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "logo": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "srcLight": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "src",
        "alt"
      ]
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        }
      },
      "required": [
        "street",
        "city",
        "state",
        "zip"
      ]
    },
    "header": {
      "type": "object",
      "properties": {
        "darkMode": {
          "default": true,
          "type": "boolean"
        },
        "cta": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "url"
          ]
        }
      }
    },
    "nav": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "text",
                "url"
              ]
            }
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "description",
    "url",
    "logo",
    "nav"
  ]
}