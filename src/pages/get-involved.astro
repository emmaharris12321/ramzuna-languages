---
import Base from '@/layouts/Base.astro';
import ProgrammesAndInvolved from '@/components/sections/ProgrammesAndInvolved.astro';
import FAQ from '@/components/sections/FAQ.astro';
import { getPage } from '@/data/site';

const page = await getPage('get-involved');
---

<Base title={page.title} description={page.description}>
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">{page.title}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">{page.description}</p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Get Involved</span>
      </nav>
    </div>
  </section>

  <ProgrammesAndInvolved showTeach={false} />
  {page.faq && <FAQ {...page.faq} />}

  <!-- CTA Section -->
  {
    page.cta && (
      <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
        <div class="container mx-auto px-4 text-center lg:px-8">
          <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">{page.cta.title}</h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">{page.cta.description}</p>
          <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a href={page.cta.primaryCta.url} class="inline-flex items-center rounded-full bg-white px-8 py-3 font-medium text-primary-600 shadow-lg transition-colors hover:bg-gray-100">
              {page.cta.primaryCta.text}
            </a>
            {page.cta.secondaryCta && (
              <a href={page.cta.secondaryCta.url} class="inline-flex items-center rounded-full border-2 border-white/30 px-8 py-3 font-medium text-white transition-colors hover:bg-white/10">
                {page.cta.secondaryCta.text}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</Base>
