---
import Base from '@/layouts/Base.astro';
import { getHomepage } from '@/data/site';

const home = await getHomepage();
const studentVoices = (home.testimonials?.items ?? []).filter((t: { author: string }) =>
  ['Layla', 'Yousef', 'Noor'].includes(t.author)
);

// Outline icons (24x24, stroke) shared across the page
const icon = {
  free: 'M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  match: 'M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z',
  clock: 'M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z',
  globe: 'M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.5-2.4 3.75-5.4 3.75-9S14.5 5.4 12 3m0 18c-2.5-2.4-3.75-5.4-3.75-9S9.5 5.4 12 3M3.6 9h16.8M3.6 15h16.8',
  book: 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
  target: 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z',
  pencil: 'M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z',
  chat: 'M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z',
  download: 'M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3',
};

const facts = [
  { value: '100%', label: 'Free, always', note: 'No cost at any stage' },
  { value: '3', label: 'Languages', note: 'English, French, German' },
  { value: '3–4', label: 'Students per group', note: 'You learn with peers' },
  { value: '13–30', label: 'Typical age range', note: 'Every application considered' },
];

const perks = [
  { icon: 'free', title: 'Completely free', description: 'Every lesson is free, always. There is no cost to you at any stage, for as long as you keep learning with us.' },
  { icon: 'match', title: 'Matched to you', description: 'We match you with a volunteer educator based on your language, level, and schedule, so lessons fit your goals.' },
  { icon: 'clock', title: 'Flexible scheduling', description: 'Meet online in a small group by default, one-to-one for exam prep or special needs, or asynchronously, at times that work around your life.' },
  { icon: 'globe', title: 'A global network of educators', description: 'Learn with volunteer teachers from 15+ countries, trained to support students learning under difficult circumstances.' },
  { icon: 'book', title: 'Real materials, real support', description: 'A textbook and curated resources are provided for every student, with your progress tracked throughout the term.' },
  { icon: 'target', title: 'Built around your goals', description: 'Whether you are preparing for exams, further study, or remote work, your lessons are shaped around what you want to achieve.' },
];

const languages = [
  { code: 'EN', name: 'English', exams: 'IELTS · TOEFL', url: '/english-classes', tone: 'bg-primary-600' },
  { code: 'FR', name: 'French', exams: 'DELF · DALF', url: '/french-classes', tone: 'bg-accent-500' },
  { code: 'DE', name: 'German', exams: 'Goethe-Institut', url: '/german-classes', tone: 'bg-primary-800' },
];

const lessonTypes = [
  {
    title: 'Small Group Lessons',
    tag: 'Most students',
    description: 'Our default format. You learn alongside two or three other students at a similar level, with a volunteer educator, on a regular weekly schedule.',
    points: ['Weekly 60- or 90-minute sessions', 'Textbook and learning materials included', 'Built-in peer support and conversation practice'],
    facts: [['Who', 'You + 2–3 peers'], ['When', 'Weekly, live'], ['Internet', 'Live connection']],
  },
  {
    title: 'One-to-One Lessons',
    tag: 'Exam prep & special needs',
    description: 'Individual lessons are reserved for students preparing for an official exam (IELTS, TOEFL, DELF, DALF, Goethe-Institut) or with special educational needs that require individual attention.',
    points: ['Focused, personalised coaching', 'Practice tests for exam candidates', 'Available from Intermediate (B1) level upward for exam prep'],
    facts: [['Who', 'You + your educator'], ['When', 'Live lessons'], ['Internet', 'Live connection']],
  },
  {
    title: 'Asynchronous Lessons',
    tag: 'No live internet needed',
    description: 'Learn on your own schedule using low-bandwidth materials — built for students without reliable internet for live classes, or when live courses are fully booked.',
    points: [
      'Compressed, lightweight PDFs you can download in seconds',
      'Audio listening exercises with comprehension questions',
      'Personalised written and voice-note feedback in a dedicated group chat',
      'Speaking circles — practise speaking by sending and responding to voice messages whenever suits you',
    ],
    facts: [['Who', 'You + a teacher, plus a group chat'], ['When', 'Any time that suits you'], ['Internet', 'Low bandwidth is enough']],
  },
];

const asyncFeatures = [
  { icon: 'pencil', title: 'Get personalised feedback', text: 'Submit a writing task or an audio recording and receive direct notes on both from your teacher in a dedicated group chat — the same kind of correction and encouragement you would get in a live lesson.' },
  { icon: 'chat', title: 'Practise speaking asynchronously', text: 'Join speaking circles with other students and respond by voice message on your own schedule — real speaking practice, without needing everyone online at the same time.' },
  { icon: 'book', title: 'Grammar and vocabulary in context', text: 'Structured lesson materials — like seeing how the present perfect connects past actions to the present moment — teach real grammar through clear, worked examples, not dry rules.' },
  { icon: 'download', title: 'Low-bandwidth by design', text: 'Compressed PDFs, audio listening exercises, and comprehension questions are all built to download quickly and work offline once saved — so a weak connection is never a barrier to learning.' },
];

const eligibility = [
  'Palestinian students based in Gaza, the West Bank, or displaced elsewhere because of the war',
  'Primarily aged 13–30, though every application is considered individually',
  'Any starting level — from complete beginner to advanced — we assess and place you accurately before matching',
  'Motivated to build language skills for further study, official exams, or remote work opportunities',
  'Access to an internet connection and a device for online lessons',
];

const steps = [
  { number: '01', title: 'Apply Online', description: 'Tell us your language, level, and availability — it only takes a few minutes.' },
  { number: '02', title: 'Get Matched', description: 'We pair you with a vetted volunteer educator who fits your goals and schedule.' },
  { number: '03', title: 'Start Learning', description: 'Meet online for regular lessons, at a pace that works for you.' },
  { number: '04', title: 'Track Your Progress', description: 'Build real fluency over time, with check-ins to keep your learning on course.' },
];
---

<Base title="Free Lessons for Palestinian Students" description="Palestinian students can learn English, French, or German for free, matched with a volunteer teacher to their level and schedule.">
  <!-- Page Header -->
  <section class="page-hero py-16 lg:py-24">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Study with Us</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Free English, French, and German lessons with a volunteer educator matched to your goals.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Study with Us</span>
      </nav>
    </div>
  </section>

  <!-- Closed Notice -->
  <div class="bg-accent-50 py-4 dark:bg-accent-900/20">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <p class="text-sm font-medium text-accent-800 dark:text-accent-200">
        Student enrolment is currently closed for the autumn term. We are not accepting new student applications at this time. Please check our website and social media for future enrolment announcements. In the meantime, explore our <a href="/services" class="underline hover:no-underline">programmes</a> and <a href="/resources" class="underline hover:no-underline">free learning resources</a>.
      </p>
    </div>
  </div>

  <!-- At a glance -->
  <section class="relative z-10 -mb-10 pt-10 lg:pt-12" aria-label="The programme at a glance">
    <div class="container mx-auto px-4 lg:px-8">
      <ul class="mx-auto grid max-w-5xl grid-cols-2 overflow-hidden rounded-2xl bg-white shadow-soft-lg ring-1 ring-black/5 lg:grid-cols-4 dark:bg-gray-800 dark:ring-white/10">
        {
          facts.map((f, i) => (
            <li class:list={['p-6 text-center lg:p-8', i % 2 === 1 && 'border-l border-gray-100 dark:border-gray-700', i > 1 && 'border-t border-gray-100 lg:border-t-0 dark:border-gray-700', i > 0 && 'lg:border-l lg:border-gray-100 lg:dark:border-gray-700']}>
              <p class="font-display text-4xl font-semibold leading-none text-primary-600 lg:text-5xl dark:text-primary-300">{f.value}</p>
              <p class="mt-3 font-semibold text-gray-900 dark:text-white">{f.label}</p>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{f.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Why Study With Us -->
  <section class="pb-20 pt-24 lg:pb-20 lg:pt-24">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">Why Study With Us</div>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
            Learning that <em class="not-italic text-primary-600 dark:text-primary-400">works for you</em>
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
            Built around the realities of studying from Palestine — flexible, personal, and free.
          </p>
        </div>

        <ul class="divide-y divide-gray-200 dark:divide-gray-800">
          {
            perks.map((perk) => (
              <li class="flex gap-5 py-7 first:pt-0 last:pb-0">
                <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-600 dark:bg-primary-900/50 dark:text-primary-300">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={icon[perk.icon as keyof typeof icon]} /></svg>
                </span>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{perk.title}</h3>
                  <p class="mt-1.5 leading-relaxed text-gray-600 dark:text-gray-400">{perk.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Languages -->
  <section class="page-hero py-16 lg:py-20">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Choose Your Language</h2>
        <p class="mt-3 text-lg text-white/85">Lessons for every level, plus preparation for the exams that open doors.</p>
      </div>
      <div class="mx-auto mt-10 grid max-w-5xl gap-4 sm:grid-cols-3">
        {
          languages.map((l) => (
            <a href={l.url} class="group flex items-center gap-4 rounded-2xl border border-white/20 bg-white/10 p-5 backdrop-blur-sm transition-all hover:-translate-y-1 hover:bg-white/20 sm:flex-col sm:items-start sm:gap-5 sm:p-6">
              <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-xl bg-white font-display text-xl font-bold text-primary-700">{l.code}</span>
              <span class="min-w-0 flex-1">
                <span class="block font-display text-2xl font-semibold text-white">{l.name}</span>
                <span class="mt-1 block text-sm text-white/80">Exam prep: {l.exams}</span>
              </span>
              <span class="text-sm font-semibold text-white transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              <span class="sr-only">View {l.name} classes</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Three Ways to Learn -->
  <section class="bg-cream-100 py-20 lg:py-20 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">How Lessons Work</div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">Three Ways to Learn</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">We match you to the format that fits your circumstances — most students learn in a small group.</p>
      </div>

      <div class="mx-auto mt-14 max-w-5xl space-y-5">
        {
          lessonTypes.map((type, i) => (
            <article class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/5 dark:bg-gray-800 dark:ring-white/10">
              <div class="grid lg:grid-cols-[0.8fr_1.4fr_0.8fr]">
                <div class:list={['flex flex-col justify-center p-7 text-white lg:p-8', i === 1 ? 'bg-accent-500' : 'bg-primary-600']}>
                  <span class="mb-3 inline-flex w-fit rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">{type.tag}</span>
                  <h3 class="font-display text-2xl font-semibold">{type.title}</h3>
                </div>
                <div class="p-7 lg:p-8">
                  <p class="leading-relaxed text-gray-600 dark:text-gray-400">{type.description}</p>
                  <ul class="mt-4 space-y-2">
                    {type.points.map((point) => (
                      <li class="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
                        <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        {point}
                      </li>
                    ))}
                  </ul>
                </div>
                <dl class="grid grid-cols-3 gap-px border-t border-gray-100 bg-gray-100 text-sm lg:grid-cols-1 lg:border-l lg:border-t-0 dark:border-gray-700 dark:bg-gray-700">
                  {type.facts.map(([k, v]) => (
                    <div class="bg-cream-50 p-4 dark:bg-gray-800 lg:px-6 lg:py-4">
                      <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">{k}</dt>
                      <dd class="mt-1 font-medium text-gray-900 dark:text-white">{v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Asynchronous Lessons, in detail -->
  <section id="asynchronous-lessons" class="scroll-mt-24 py-20 lg:py-20">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-5xl overflow-hidden rounded-3xl bg-primary-600 p-8 text-white shadow-soft-xl lg:p-14 dark:bg-primary-800">
        <div class="mb-4 inline-flex items-center rounded-full border border-white/25 bg-white/10 px-3 py-1 text-sm font-medium">A Closer Look</div>
        <h2 class="font-display text-3xl font-semibold sm:text-4xl">Inside an Asynchronous Lesson</h2>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-white/85">
          Asynchronous lessons are not boring videos or pre-recorded lectures — they are an engaging, flexible programme in their own right, and we are expanding it because it helps students who cannot join live classes reliably, or who simply want extra practice when live courses are full. Here is what it actually looks like.
        </p>
        <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {
            asyncFeatures.map((f) => (
              <div class="flex gap-4">
                <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-white/15 text-white">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={icon[f.icon as keyof typeof icon]} /></svg>
                </span>
                <div>
                  <h3 class="font-semibold text-white">{f.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-white/80">{f.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Student voices -->
  {
    studentVoices.length > 0 && (
      <section class="bg-cream-100 py-20 lg:py-20 dark:bg-gray-900" aria-labelledby="student-voices">
        <div class="container mx-auto px-4 lg:px-8">
          <div class="mx-auto max-w-3xl text-center">
            <div class="mb-4 inline-flex items-center rounded-full bg-accent-100 px-3 py-1 text-sm font-medium text-accent-700 dark:bg-accent-900/50 dark:text-accent-300">Student Stories</div>
            <h2 id="student-voices" class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">In Our Students' Words</h2>
          </div>
          <div class="mx-auto mt-12 grid max-w-6xl gap-6 lg:grid-cols-3">
            {studentVoices.map((t: { quote: string; author: string; role: string }) => (
              <figure class="flex flex-col rounded-2xl bg-white p-8 shadow-sm dark:bg-gray-800">
                <span aria-hidden="true" class="font-display text-5xl leading-none text-accent-200 dark:text-accent-800">&ldquo;</span>
                <blockquote class="mt-2 flex-1 leading-relaxed text-gray-700 dark:text-gray-300">{t.quote}</blockquote>
                <figcaption class="mt-6 border-t border-gray-100 pt-4 dark:border-gray-700">
                  <p class="font-semibold text-gray-900 dark:text-white">{t.author}</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{t.role}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Who Can Join -->
  <section class="py-20 lg:py-20">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto grid max-w-5xl items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="text-center lg:text-left">
          <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">Who Can Join</div>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
            Is this <em class="not-italic text-primary-600 dark:text-primary-400">programme for you?</em>
          </h2>
          <p class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-gray-600 dark:text-gray-400 lg:mx-0">
            Ramzunā Languages was created specifically for Palestinian students. Here is who we welcome into the programme.
          </p>
        </div>
        <ul class="space-y-3">
          {
            eligibility.map((item) => (
              <li class="flex items-start gap-3 rounded-xl border-l-4 border-primary-600 bg-white p-4 shadow-sm dark:bg-gray-800">
                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700 dark:text-gray-300">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Getting Started: timeline -->
  <section class="bg-cream-100 py-20 lg:py-20 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">Getting Started</div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">From Sign-Up to Fluency</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Four steps to your first lesson.</p>
      </div>
      <ol class="relative mx-auto mt-16 grid max-w-5xl gap-10 lg:grid-cols-4 lg:gap-6">
        <span class="absolute left-[4.5rem] right-[4.5rem] top-6 hidden h-0.5 bg-primary-200 lg:block dark:bg-primary-800" aria-hidden="true"></span>
        {
          steps.map((step) => (
            <li class="relative flex gap-5 lg:flex-col lg:items-center lg:gap-0 lg:text-center">
              <span class="relative z-10 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary-600 text-lg font-bold text-white ring-8 ring-cream-100 dark:ring-gray-900">{step.number}</span>
              <div class="lg:mt-5">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{step.title}</h3>
                <p class="mt-1.5 text-gray-600 dark:text-gray-400">{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
