---
import Base from '@/layouts/Base.astro';
import { getPage } from '@/data/site';

const page = await getPage('contact');
---

<Base title={page.title} description={page.description}>
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">{page.title}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">{page.description}</p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Contact</span>
      </nav>
    </div>
  </section>

  <!-- Get in Touch -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-100 text-primary-600 dark:bg-primary-900/50 dark:text-primary-400">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h2 class="mt-6 font-display text-3xl font-semibold text-gray-900 sm:text-4xl dark:text-white">{page.info.title}</h2>
        <p class="mx-auto mt-4 max-w-lg text-lg text-gray-600 dark:text-gray-400">{page.info.description}</p>

        <a
          href={`mailto:${page.info.email}`}
          class="mt-10 inline-flex items-center gap-3 rounded-2xl bg-white px-8 py-5 shadow-soft transition-all hover:-translate-y-1 hover:shadow-soft-lg dark:bg-gray-800"
        >
          <svg class="h-6 w-6 flex-shrink-0 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="break-all text-lg font-semibold text-gray-900 sm:text-xl dark:text-white">{page.info.email}</span>
        </a>

        <div class="mx-auto mt-14 grid max-w-xl gap-6 text-left sm:grid-cols-2">
          {page.info.items.map((item: any) => (
            <div class="rounded-2xl bg-cream-100 p-6 shadow-sm dark:bg-gray-900">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-100 text-primary-600 dark:bg-primary-900/50 dark:text-primary-400">
                {item.icon === 'location' && <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>}
                {item.icon === 'clock' && <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
              </div>
              <h3 class="mt-4 text-base font-semibold text-gray-900 dark:text-white">{item.title}</h3>
              {item.lines ? (
                item.lines.map((line: string) => (
                  <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{line}</p>
                ))
              ) : (
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{item.value}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Global Reach Banner -->
  <section class="border-t border-gray-200 bg-primary-600 py-14 dark:border-gray-800 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <svg class="mx-auto h-10 w-10 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9 9 0 100-18 9 9 0 000 18zM3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18M12 3a15 15 0 000 18" />
      </svg>
      <p class="mt-4 text-lg font-medium text-white">
        We are a fully remote programme — students across Palestine, volunteer educators in more than 15 countries.
      </p>
    </div>
  </section>
</Base>
