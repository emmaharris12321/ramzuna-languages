---
import Base from '@/layouts/Base.astro';

type Principle = {
  number: string;
  title: string;
  tags: string[];
  description: string;
  full?: boolean;
};

const principles: Principle[] = [
  {
    number: '01',
    title: 'Learner-Centred',
    tags: ['Your goals lead'],
    description:
      "Every course begins with a conversation about what the learner actually needs language for — a university application, a job interview, a scholarship exam, or simply the confidence to speak. Lessons are built around those goals, not a fixed syllabus.",
  },
  {
    number: '02',
    title: 'Decolonial',
    tags: ['Global languages', 'Every voice valid'],
    description:
      "We teach English, French, and German as global languages that belong to everyone who speaks them — not as symbols of a single culture to imitate. Arabic and Palestinian identity are never something to set aside in the classroom; every accent and every voice is treated as valid.",
  },
  {
    number: '03',
    title: 'Personalised',
    tags: ['One-to-one design'],
    description:
      "Class sizes stay small, and pairings between student and educator are made deliberately, matching schedules, interests, and learning style. Progress is tracked individually, so no learner is held to someone else's pace.",
  },
  {
    number: '04',
    title: 'Communicative',
    tags: ['Speak from day one'],
    description:
      "Grammar and vocabulary are always in service of real conversation. Learners are speaking, listening, and responding from their very first lesson, because confidence comes from use, not from memorising rules in isolation.",
  },
  {
    number: '05',
    title: 'Trauma-Informed',
    tags: ['Safety first', 'Flexible by design'],
    description:
      "We recognise that our students are learning under circumstances shaped by displacement, blockade, and loss. Lessons can pause, reschedule, or shift focus without penalty. Educators are trained to hold space for that reality with patience, not urgency — safety and trust come before syllabus completion.",
    full: true,
  },
];
---

<Base title="Our Approach" description="The five principles that guide every lesson at Ramzunā Languages.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Our Approach</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Five principles guide every lesson, and by the end of each term, they come together in a portfolio of the learner&rsquo;s own work.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/about" class="transition-colors hover:text-white">About</a>
        <span>/</span>
        <span class="text-white">Our Approach</span>
      </nav>
    </div>
  </section>

  <!-- Principles grid -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Our Approach
        </div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Five Principles, One Method
        </h2>
        <p class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          These commitments shape how every volunteer educator plans, teaches, and adapts their lessons.
        </p>
      </div>

      <div class="mx-auto mt-14 grid max-w-4xl gap-6 sm:grid-cols-2">
        {principles.map((p, i) => (
          <div
            class={`rounded-2xl border-2 bg-white p-8 shadow-sm transition-transform hover:-translate-y-1 dark:bg-gray-800 ${
              i % 2 === 0 ? 'border-primary-200 dark:border-primary-900/60' : 'border-accent-200 dark:border-accent-900/60'
            } ${p.full ? 'sm:col-span-2' : ''}`}
          >
            <div class="flex items-start gap-5">
              <span
                class={`font-display flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl text-lg font-semibold ${
                  i % 2 === 0
                    ? 'bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300'
                    : 'bg-accent-100 text-accent-700 dark:bg-accent-900/50 dark:text-accent-300'
                }`}
              >
                {p.number}
              </span>
              <div class="flex-1">
                <h3 class="font-display text-xl font-semibold text-gray-900 dark:text-white">{p.title}</h3>
                <div class="mt-2 flex flex-wrap gap-2">
                  {p.tags.map((tag) => (
                    <span
                      class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ${
                        i % 2 === 0
                          ? 'bg-primary-50 text-primary-700 dark:bg-primary-900/30 dark:text-primary-300'
                          : 'bg-accent-50 text-accent-700 dark:bg-accent-900/30 dark:text-accent-300'
                      }`}
                    >
                      {tag}
                    </span>
                  ))}
                </div>
                <p class="mt-4 text-base leading-relaxed text-gray-600 dark:text-gray-400">{p.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- End-of-Term Portfolio callout -->
      <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl bg-gradient-to-r from-primary-600 to-primary-700 p-8 text-center shadow-soft-lg dark:from-primary-800 dark:to-primary-900 sm:p-12">
        <span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-white/15 text-white">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
          </svg>
        </span>
        <h3 class="font-display text-2xl font-semibold text-white sm:text-3xl">End-of-Term Portfolio</h3>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-primary-100">
          Every term ends the same way: not with a test score, but with a portfolio of the learner&rsquo;s own work &mdash; writing, recordings, and projects that show how far they&rsquo;ve come, in their own words.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex items-center justify-center rounded-lg bg-white px-8 py-3 font-medium text-primary-600 shadow-lg transition-colors hover:bg-gray-100"
        >
          Ask About Our Programmes
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-cream-100 py-16 lg:py-24 dark:bg-gray-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-gray-900 sm:text-4xl dark:text-white">More About Ramzunā Languages</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600 dark:text-gray-400">
        Learn more about our mission, our values, and the story behind our name.
      </p>
      <a href="/about" class="mt-8 inline-flex items-center justify-center rounded-lg bg-primary-600 px-8 py-3 font-medium text-white shadow-lg transition-colors hover:bg-primary-700">
        About Us
      </a>
    </div>
  </section>
</Base>
