---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/sections/Hero.astro';
import ProgrammesAndInvolved from '@/components/sections/ProgrammesAndInvolved.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Terms from '@/components/sections/Terms.astro';
import TestimonialsCarousel from '@/components/sections/TestimonialsCarousel.astro';
import BlogTeaser from '@/components/sections/BlogTeaser.astro';
import CTA from '@/components/sections/CTA.astro';
import { getHomepage } from '@/data/site';

const page = await getHomepage();
---

<Base title="Home">
  <Hero {...page.hero} />
  <!-- Wave Divider -->
  <div class="relative -mt-1 text-gray-50 dark:text-gray-900">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
      <path d="M0 40C240 80 480 0 720 40C960 80 1200 0 1440 40V80H0V40Z" fill="currentColor" />
    </svg>
  </div>
  <ProgrammesAndInvolved />

  {
    page.studentConversations && (
      <section class="py-20 lg:py-28">
        <div class="container mx-auto px-4 lg:px-8">
          <div class="mx-auto max-w-3xl text-center">
            <div class="mb-4 inline-flex items-center rounded-full bg-accent-100 px-3 py-1 text-sm font-medium text-accent-700 dark:bg-accent-900/50 dark:text-accent-300">
              {page.studentConversations.badge}
            </div>
            <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
              {page.studentConversations.title}
            </h2>
            <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600 dark:text-gray-400">
              {page.studentConversations.description}
            </p>
          </div>

          {
            page.studentConversations.image && (
              <div class="mx-auto mt-14 max-w-4xl">
                <div class="overflow-hidden rounded-2xl shadow-soft-lg">
                  <img
                    src={page.studentConversations.image}
                    alt="Ramzunā students on a live student-led conversation call, discussing the week's topic"
                    class="w-full object-cover"
                    loading="lazy"
                  />
                </div>
                {page.studentConversations.imageCaption && (
                  <p class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400">{page.studentConversations.imageCaption}</p>
                )}
              </div>
            )
          }
        </div>
      </section>
    )
  }

  {page.howItWorks && <HowItWorks {...page.howItWorks} />}
  {page.terms && <Terms badge={page.terms.badge} title={page.terms.title} description={page.terms.description} terms={page.terms.items} />}
  <TestimonialsCarousel />
  <BlogTeaser />
  {page.cta && <CTA {...page.cta} />}

  <!-- Closing Quote -->
  <section class="quote-section-photo py-12 lg:py-16">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="quote-glyph quote-glyph-photo" aria-hidden="true">&ldquo;</span>
        <p class="font-display text-xl italic leading-relaxed text-white sm:text-2xl" style="text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);">
          Language is the road map of a culture. It tells you where its people come from and where they are going.
        </p>
        <p class="mt-5 text-sm font-semibold text-white" style="text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);">Rita Mae Brown</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .quote-glyph {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3rem;
    line-height: 0.5;
    margin-bottom: 0.75rem;
  }

  /* Homepage closing quote: matches the olive-branch photo treatment used on
     the Palestinian Voices closing quote, so both quotes read as one system. */
  .quote-section-photo {
    position: relative;
    background-image: linear-gradient(rgba(20, 11, 9, 0.32), rgba(20, 11, 9, 0.4)), url('/assets/img/olive-branch-quote-bg.jpg');
    background-size: cover;
    background-position: center;
  }

  .quote-glyph-photo {
    color: rgba(255, 255, 255, 0.75);
  }
</style>
