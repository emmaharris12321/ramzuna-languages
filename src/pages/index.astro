---
import Base from '@/layouts/Base.astro';
import '@/css/home-redesign.css';
import ProgrammesAndInvolved from '@/components/sections/ProgrammesAndInvolved.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Terms from '@/components/sections/Terms.astro';
import TestimonialsCarousel from '@/components/sections/TestimonialsCarousel.astro';
import BlogTeaser from '@/components/sections/BlogTeaser.astro';
import CTA from '@/components/sections/CTA.astro';
import { getHomepage } from '@/data/site';

const page = await getHomepage();
---

<Base title="Free English, French & German Lessons for Palestinian Students" description="Ramzunā Languages provides free, personalised English, French and German lessons to Palestinian students. Explore our programmes, learning resources and ways to support our work.">
  <div class="rz-home-redesign">
    <section class="rd-hero" aria-labelledby="rd-title">
      <div class="rd-shell rd-hero-grid">
        <div class="rd-intro">
          <p class="rd-kicker"><span aria-hidden="true"></span>{page.hero.badge}</p>
          <h1 id="rd-title">{page.hero.title === 'Language Access Should Cross Every Border' ? <>Language Access Should <em>Cross Every Border</em></> : page.hero.title}</h1>
          <p class="rd-lead">{page.hero.description}</p>
          <div class="rd-actions">
            <a class="rd-button rd-primary" href={page.hero.primaryCta.url}>{page.hero.primaryCta.text}<span aria-hidden="true">↗</span></a>
            <a class="rd-button rd-outline" href={page.hero.secondaryCta.url}>{page.hero.secondaryCta.text}<span aria-hidden="true">→</span></a>
          </div>
          <p class="rd-note"><span aria-hidden="true"></span>{page.hero.note}</p>
        </div>
        <figure class="rd-hero-figure">
          <div class="rd-photo">
            <img src={page.hero.image} alt={page.hero.imageAlt} width="1000" height="731" loading="eager" fetchpriority="high" />
          </div>
          <figcaption><span>Education without borders</span><span>English · French · German</span></figcaption>
        </figure>
      </div>
    </section>
    {page.hero.stats?.length > 0 && (
      <section class="rd-impact" aria-labelledby="rd-impact-title">
        <div class="rd-shell rd-impact-grid">
          <h2 id="rd-impact-title">Our impact<br /> <em>in numbers</em></h2>
          <dl>
            {page.hero.stats.map((stat) => (
              <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>
            ))}
          </dl>
        </div>
      </section>
    )}
    <div class="rd-programmes">
      <ProgrammesAndInvolved showInvolved={false} homepage />
    </div>
    <section class="rd-voices" aria-labelledby="rd-voices-title">
      <div class="rd-shell rd-voices-grid">
        <div class="rd-voices-image"><img src="/assets/img/dove-olive-tree.jpg" alt="" width="776" height="1012" loading="lazy" /></div>
        <div class="rd-voices-copy">
          <p class="rd-kicker"><span aria-hidden="true"></span>Culture &amp; community</p>
          <h2 id="rd-voices-title">Palestinian <em>Voices</em></h2>
          <p>Publishing Palestinian literature, poetry and art from our students and wider community.</p>
          <a class="rd-button rd-light" href="/palestinian-voices">Explore Palestinian Voices <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <div class="rd-journey">
      {page.howItWorks && <HowItWorks {...page.howItWorks} />}
      {page.terms && <Terms badge={page.terms.badge} title={page.terms.title} description={page.terms.description} terms={page.terms.items} />}
    </div>
    <TestimonialsCarousel />
    <div class="rd-involved"><ProgrammesAndInvolved showTeach={false} homepage enrolmentNote={page.hero.note} /></div>
  <section aria-labelledby="commitment-title" class="bg-white py-14 dark:bg-gray-950 lg:py-20">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h2 id="commitment-title" class="text-center font-display text-3xl font-semibold text-primary-700 dark:text-white sm:text-4xl">Our Commitment</h2>
        <p class="mt-4 text-center text-gray-600 dark:text-gray-300">Free education, student wellbeing and accountability are at the heart of our work.</p>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <article class="rounded-xl border border-gray-200 p-6 dark:border-gray-700">
            <h3 class="font-semibold text-lg">Volunteer-powered education</h3>
            <p class="mt-2 text-gray-600 dark:text-gray-300">A non-profit organisation providing free language learning for Palestinian students. UK company number: 17498643.</p>
            <a href="/about" class="mt-3 inline-flex min-h-11 items-center font-semibold text-primary-700 underline dark:text-gray-200">About us</a>
          </article>
          <article class="rounded-xl border border-gray-200 p-6 dark:border-gray-700">
            <h3 class="font-semibold text-lg">Safeguarding</h3>
            <p class="mt-2 text-gray-600 dark:text-gray-300">Learn about our safeguarding policy and how to report a concern.</p>
            <a href="/safeguarding" class="mt-3 inline-flex min-h-11 items-center font-semibold text-primary-700 underline dark:text-gray-200">Safeguarding policy</a>
          </article>
          <article class="rounded-xl border border-gray-200 p-6 dark:border-gray-700">
            <h3 class="font-semibold text-lg">Transparency</h3>
            <p class="mt-2 text-gray-600 dark:text-gray-300">Find out more about our organisation and its commitment to transparency.</p>
            <a href="/transparency" class="mt-3 inline-flex min-h-11 items-center font-semibold text-primary-700 underline dark:text-gray-200">Transparency</a>
          </article>
        </div>
      </div>
    </div>
  </section>
  <BlogTeaser />
  {page.cta && <CTA {...page.cta} description={`${page.hero.note} ${page.cta.description}`} />}

  <!-- Closing Quote -->
  <section class="quote-section-photo py-12 lg:py-16">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="quote-glyph quote-glyph-photo" aria-hidden="true">&ldquo;</span>
        <p class="font-display text-xl italic leading-relaxed text-white sm:text-2xl" style="text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);">
          Language is the road map of a culture. It tells you where its people come from and where they are going.
        </p>
        <p class="mt-5 text-sm font-semibold text-white" style="text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);">Rita Mae Brown</p>
      </div>
    </div>
  </section>
  </div>
</Base>

<style>
  .quote-glyph {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3rem;
    line-height: 0.5;
    margin-bottom: 0.75rem;
  }

  /* Homepage closing quote: matches the olive-branch photo treatment used on
     the Palestinian Voices closing quote, so both quotes read as one system. */
  .quote-section-photo {
    position: relative;
    background-image: linear-gradient(rgba(20, 11, 9, 0.32), rgba(20, 11, 9, 0.4)), url('/assets/img/olive-branch-quote-bg.jpg');
    background-size: cover;
    background-position: center;
  }

  .quote-glyph-photo {
    color: rgba(255, 255, 255, 0.75);
  }
</style>
