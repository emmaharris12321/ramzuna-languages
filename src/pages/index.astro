---
import Base from '@/layouts/Base.astro';
import TestimonialsCarousel from '@/components/sections/TestimonialsCarousel.astro';
import { getHomepage } from '@/data/site';
import { getCollection } from 'astro:content';
import '@/styles/homepage-editorial.css';

const page = await getHomepage();
const { hero, howItWorks, terms, cta } = page;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
const actions = [
  { title: 'Study with us', description: 'Find out how our free lessons work and explore learning resources you can use now.', url: '/study-with-us', link: 'Explore studying' },
  { title: 'Teach with us', description: 'Share your knowledge of English, French or German with Palestinian students.', url: '/teach-with-us', link: 'Explore volunteering' },
  { title: 'Share your voice', description: 'Share your art, articles, poems and essays through Palestinian Voices.', url: '/palestinian-voices', link: 'Explore Palestinian Voices' },
  { title: 'Support our work', description: 'Help us continue our work and reach more students.', url: '/donate', link: 'Make a donation' },
];
const commitments = [
  { title: 'Volunteer-powered education', description: 'A non-profit organisation providing free language learning for Palestinian students. UK company number: 17498643.', url: '/about', link: 'About our organisation' },
  { title: 'Safeguarding', description: 'Learn about our safeguarding policy and how to report a concern.', url: '/safeguarding', link: 'Safeguarding policy' },
  { title: 'Transparency', description: 'Find out more about our organisation and its commitment to transparency.', url: '/transparency', link: 'Transparency' },
];
---

<Base title="Free English, French & German Lessons for Palestinian Students" description="Ramzunā Languages provides free, personalised English, French and German lessons to Palestinian students. Explore our programmes, learning resources and ways to support our work.">
  <div class="rl-home">
    <section class="rl-hero" aria-labelledby="rl-title">
      <div class="rl-hero-inner rl-wrap">
        <div class="rl-hero-copy">
          <p class="rl-kicker">Language education · Palestine</p>
          <h1 id="rl-title">Language access<br class="rl-desktop-break" /> should cross<br class="rl-desktop-break" /> <em>every border.</em></h1>
          <p class="rl-lead">{hero.description}</p>
          <div class="rl-buttons">
            <a class="rl-button rl-primary" href={hero.primaryCta.url}>{hero.primaryCta.text} <span aria-hidden="true">↗</span></a>
            <a class="rl-button rl-outline" href={hero.secondaryCta.url}>{hero.secondaryCta.text}</a>
          </div>
        </div>
        <figure class="rl-hero-figure">
          <img src="/assets/img/olive-branch-quote-bg.jpg" alt="Olive branches in warm sunlight" width="2937" height="1343" fetchpriority="high" />
          <figcaption><span>Ramzunā Languages</span><span>{hero.badge}</span></figcaption>
        </figure>
      </div>
    </section>
    <aside class="rl-notice" aria-label="Enrolment update">
      <div class="rl-wrap rl-notice-inner"><strong>Enrolment update</strong><p>{hero.note}</p><a href="/study-with-us" class="rl-link">Study with us <span aria-hidden="true">→</span></a></div>
    </aside>

    {hero.stats?.length > 0 && (
      <section class="rl-impact" aria-label="Our impact in numbers">
        <div class="rl-wrap">
          <p class="rl-kicker">Our impact in numbers</p>
          <dl class="rl-stat-grid">
            {hero.stats.map(stat => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
          </dl>
        </div>
      </section>
    )}

    <section class="rl-section" id="programmes" aria-labelledby="rl-programmes-title">
      <div class="rl-wrap">
        <div class="rl-section-head">
          <div><p class="rl-kicker">Our programmes</p><h2 id="rl-programmes-title">How we teach</h2></div>
          <p>Free language learning, flexible access and space for Palestinian voices.</p>
        </div>
        <div class="rl-programme-feature">
          <figure><img src={hero.image} alt={hero.imageAlt} width="1000" height="731" loading="lazy" /></figure>
          <div class="rl-programme-copy">
            <span class="rl-index">01 / Language education</span>
            <h3>Language lessons &amp; conversations</h3>
            <p>Empowering Palestinian students through general, conversation, academic and business language lessons.</p>
            <div class="rl-language-links">
              {['English', 'French', 'German'].map(language => <a class="rl-link" href={`/${language.toLowerCase()}-classes`}>{language} classes <span aria-hidden="true">→</span></a>)}
            </div>
          </div>
        </div>
        <div class="rl-programme-pair">
          <article><span class="rl-index">02 / Flexible access</span><h3>Asynchronous learning</h3><p>Self-paced learning for students whose internet connection does not enable them to join live lessons.</p><div class="rl-inline-links"><a href="/services" class="rl-link">Explore learning <span aria-hidden="true">→</span></a><a href="/resources" class="rl-link">Free resources <span aria-hidden="true">→</span></a></div></article>
          <article><span class="rl-index">03 / Culture &amp; expression</span><h3>Palestinian poetry &amp; storytelling</h3><p>Publishing Palestinian literature, poetry and art from our students and wider community.</p><a href="/palestinian-voices" class="rl-link">Palestinian Voices <span aria-hidden="true">→</span></a></article>
        </div>
      </div>
    </section>

    <div class="rl-community"><TestimonialsCarousel /></div>

    <section class="rl-section rl-paper" aria-labelledby="rl-study-title" id="how-it-works">
      <div class="rl-wrap">
        {howItWorks && <>
          <div class="rl-section-head"><div><p class="rl-kicker">How it works</p><h2 id="rl-study-title">Your learning journey</h2></div><p>{howItWorks.description}</p></div>
          <ol class="rl-steps">
            {howItWorks.steps.map(step => <li><span class="rl-step-number">{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}
          </ol>
        </>}
        {terms && <div class="rl-calendar" id="terms">
          <div><p class="rl-kicker">Academic calendar</p><h3>Three teaching terms</h3><p>{terms.description}</p></div>
          <dl>{terms.items.map(term => <div><dt>{term.name}</dt><dd>{term.dates}</dd></div>)}</dl>
        </div>}
      </div>
    </section>

    <section class="rl-section" aria-labelledby="rl-involved-title">
      <div class="rl-wrap">
        <div class="rl-section-head"><div><p class="rl-kicker">Get involved</p><h2 id="rl-involved-title">Be part of our community.</h2></div><p>Learn, teach, share your work or help us make free language education possible.</p></div>
        <div class="rl-actions">
          {actions.map((action, i) => <article><span class="rl-index">{`0${i + 1}`}</span><h3>{action.title}</h3><p>{action.description}</p><a href={action.url} class="rl-link">{action.link} <span aria-hidden="true">→</span></a></article>)}
        </div>
      </div>
    </section>

    <section class="rl-section rl-commitment" aria-labelledby="rl-trust-title">
      <div class="rl-wrap">
        <div class="rl-section-head"><div><p class="rl-kicker">Our commitment</p><h2 id="rl-trust-title">Education with care<br /> and accountability.</h2></div><p>Free education, student wellbeing and accountability are at the heart of our work.</p></div>
        <div class="rl-trust-grid">
          {commitments.map(item => <article><h3>{item.title}</h3><p>{item.description}</p><a href={item.url} class="rl-link">{item.link} <span aria-hidden="true">→</span></a></article>)}
        </div>
      </div>
    </section>

    {posts.length > 0 && <section class="rl-section" aria-labelledby="rl-news-title">
      <div class="rl-wrap">
        <div class="rl-section-head"><div><p class="rl-kicker">From the blog</p><h2 id="rl-news-title">Latest from our community</h2></div><a href="/blog" class="rl-link">Read all stories <span aria-hidden="true">→</span></a></div>
        <div class="rl-news">
          {posts.map(post => <article><a href={`/blog/${post.id}/`}><img src={post.data.image} alt="" loading="lazy" /><div><span class="rl-index">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="rl-link">Read story <span aria-hidden="true">→</span></span></div></a></article>)}
        </div>
      </div>
    </section>}

    {cta && <section class="rl-final" aria-labelledby="rl-final-title"><div class="rl-wrap"><div><p class="rl-kicker">{hero.badge}</p><h2 id="rl-final-title">{cta.title}</h2><p>{cta.description}</p></div><div class="rl-buttons">{cta.primaryCta && <a class="rl-button rl-light" href={cta.primaryCta.url}>{cta.primaryCta.text} <span aria-hidden="true">↗</span></a>}{cta.secondaryCta && <a class="rl-button rl-outline-light" href={cta.secondaryCta.url}>{cta.secondaryCta.text}</a>}</div></div></section>}

    <figure class="rl-closing rl-wrap"><blockquote>“Language is the road map of a culture. It tells you where its people come from and where they are going.”</blockquote><figcaption>Rita Mae Brown</figcaption></figure>
  </div>
</Base>
