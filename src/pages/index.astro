---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/sections/Hero.astro';
import ProgrammesAndInvolved from '@/components/sections/ProgrammesAndInvolved.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Terms from '@/components/sections/Terms.astro';
import TestimonialsCarousel from '@/components/sections/TestimonialsCarousel.astro';
import BlogTeaser from '@/components/sections/BlogTeaser.astro';
import CTA from '@/components/sections/CTA.astro';
import { getHomepage } from '@/data/site';

const page = await getHomepage();
---

<Base title="Free English, French & German Lessons for Palestinian Students" description="Ramzunā Languages is dedicated to providing free and personalised English,French and German lessons to Palestinian students. Sign up to learn, or apply to teach Palestinian students today.">
  <Hero {...page.hero} />
  <!-- Clean editorial transition instead of a decorative wave -->
  <div class="mx-auto h-px max-w-6xl bg-primary-200/70 dark:bg-gray-800" aria-hidden="true"></div>
  <ProgrammesAndInvolved />

  <!-- Editorial image feature: existing Ramzunā imagery, not generic stock photos. -->
  <section class="ramzuna-image-feature py-16 lg:py-24" aria-labelledby="ramzuna-feature-title">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-primary-700 dark:text-primary-300">Language · Community · Identity</p>
          <h2 id="ramzuna-feature-title" class="font-display text-3xl leading-tight text-gray-900 dark:text-white sm:text-4xl">Learning is also a way of connecting.</h2>
        </div>
        <p class="max-w-sm text-base leading-relaxed text-gray-600 dark:text-gray-300">Explore the people, cultural context and educational opportunities at the heart of Ramzunā.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-12">
        <a href="/study-with-us" class="group relative block overflow-hidden rounded-2xl md:col-span-7 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-600">
          <img src="/assets/img/student-conversation-photo.jpg" alt="Language learning and conversation" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.035] md:h-[420px]" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-7 text-white md:p-9"><span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em]">Education</span><h3 class="font-display text-2xl md:text-3xl">Study with us <span aria-hidden="true">↗</span></h3></div>
        </a>
        <a href="/palestinian-voices" class="group relative block overflow-hidden rounded-2xl md:col-span-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-600">
          <img src="/assets/img/ramzuna-heritage-banner.png" alt="Ramzunā cultural heritage artwork" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.035] md:h-[420px]" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-7 text-white md:p-9"><span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em]">Culture & identity</span><h3 class="font-display text-2xl md:text-3xl">Palestinian voices <span aria-hidden="true">↗</span></h3></div>
        </a>
      </div>
      <div class="mt-7 flex items-center gap-4" aria-hidden="true"><span class="h-px w-12 bg-primary-600"></span><span class="text-sm tracking-[0.3em] text-primary-700">✦</span><span class="h-px flex-1 bg-primary-200"></span></div>
    </div>
  </section>

  {page.howItWorks && <HowItWorks {...page.howItWorks} />}
  {page.terms && <Terms badge={page.terms.badge} title={page.terms.title} description={page.terms.description} terms={page.terms.items} />}
  <TestimonialsCarousel />
  <BlogTeaser />
  {page.cta && <CTA {...page.cta} />}

  <!-- Closing Quote -->
  <section class="quote-section-photo py-12 lg:py-16">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="quote-glyph quote-glyph-photo" aria-hidden="true">&ldquo;</span>
        <p class="font-display text-xl italic leading-relaxed text-white sm:text-2xl" style="text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);">
          Language is the road map of a culture. It tells you where its people come from and where they are going.
        </p>
        <p class="mt-5 text-sm font-semibold text-white" style="text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);">Rita Mae Brown</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .quote-glyph {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3rem;
    line-height: 0.5;
    margin-bottom: 0.75rem;
  }

  /* Homepage closing quote: matches the olive-branch photo treatment used on
     the Palestinian Voices closing quote, so both quotes read as one system. */
  .quote-section-photo {
    position: relative;
    background-image: linear-gradient(rgba(20, 11, 9, 0.32), rgba(20, 11, 9, 0.4)), url('/assets/img/olive-branch-quote-bg.jpg');
    background-size: cover;
    background-position: center;
  }

  .quote-glyph-photo {
    color: rgba(255, 255, 255, 0.75);
  }
</style>
