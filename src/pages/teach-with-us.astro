---
import Base from '@/layouts/Base.astro';
import { getHomepage } from '@/data/site';

const home = await getHomepage();
const educatorVoices = (home.testimonials?.items ?? []).filter((t: { author: string }) =>
  ['Sophie M.', 'David R.'].includes(t.author)
);

const icon = {
  clock: 'M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z',
  pencil: 'M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z',
  calendar: 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5',
  globe: 'M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.5-2.4 3.75-5.4 3.75-9S14.5 5.4 12 3m0 18c-2.5-2.4-3.75-5.4-3.75-9S9.5 5.4 12 3M3.6 9h16.8M3.6 15h16.8',
  heart: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
  group: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
};

const facts = [
  { value: '90 min', label: 'Weekly lesson', note: 'Every week' },
  { value: '45 min', label: 'Preparation', note: 'Before each lesson' },
  { value: '3 months', label: 'Minimum commitment', note: 'At least, to start' },
  { value: '15', label: 'Countries', note: 'Our 2026 teaching team' },
];

const perks = [
  { icon: 'calendar', title: 'Flexible hours', description: 'Teach when it suits you. Pick up sessions around your studies, work, or schedule — no fixed hours required. We will match you with students who share similar availability.' },
  { icon: 'heart', title: 'Meaningful impact', description: 'Directly support Palestinian students in Gaza, the West Bank and Egypt as they build the language skills they need to reach their goals.' },
  { icon: 'group', title: 'A warm community', description: 'Join a global network of volunteer teachers and language partners united around the same cause.' },
];

const languages = [
  { code: 'EN', name: 'English', url: '/english-classes' },
  { code: 'FR', name: 'French', url: '/french-classes' },
  { code: 'DE', name: 'German', url: '/german-classes' },
];

const steps = [
  { number: '01', phase: 'Apply', title: 'Apply online', description: 'Fill in a short application telling us about your teaching experience and the language you can offer.' },
  { number: '02', phase: 'Prepare', title: 'Trauma-informed training', description: 'Complete our compulsory trauma-informed/EIE training before you start teaching.' },
  { number: '03', phase: 'Prepare', title: 'Sign the volunteer agreement', description: 'Sign our volunteer agreement and code of conduct (a criminal record check is also required to teach minors).' },
  { number: '04', phase: 'Prepare', title: 'Attend the group meeting', description: 'Join a compulsory collective group meeting with the wider teaching team before you are matched.' },
  { number: '05', phase: 'Teach', title: 'Get matched with a group', description: 'We match you with a small group of students based on your language, level, and availability.' },
  { number: '06', phase: 'Teach', title: 'Start teaching', description: 'Begin sharing your knowledge in classes you love, with ongoing coordinator support.' },
];

const requirementGroups = [
  {
    title: 'Your commitment',
    items: [
      'Commitment to a weekly 90-minute lesson (plus 45 minutes of preparation) for at least 3 months',
      'Commitment to completing a weekly attendance form after each lesson',
    ],
  },
  {
    title: 'Your experience',
    items: ['Teaching qualifications or tutoring experience', 'Comfortable tailoring methods to individual learner needs'],
  },
  {
    title: 'Your approach & setup',
    items: ['Patient, encouraging and sensitive to trauma-informed teaching', 'A reliable internet connection for online sessions'],
  },
];

const library = ['Error correction', 'Grammar and skills lessons', 'Listening, reading and speaking', 'Keeping students motivated'];
---

<Base title="Volunteer to Teach Palestinian Students" description="Become an English, French, or German teacher for Palestinian students. Volunteer with Ramzunā Languages and help build real language skills, from anywhere in the world.">
  <!-- Page Header -->
  <section class="page-hero py-16 lg:py-24">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Teach with Us</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Share your knowledge and help a Palestinian student build the language skills they need.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Teach with Us</span>
      </nav>
    </div>
  </section>

  <!-- Closed Notice -->
  <div class="bg-accent-50 py-4 dark:bg-accent-900/20">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <p class="text-sm font-medium text-accent-800 dark:text-accent-200">
        Volunteer teacher applications are currently closed for the autumn term. <a href="https://forms.gle/r9dahwJBcRy9Dcym9" target="_blank" rel="noopener noreferrer" class="font-semibold underline hover:no-underline">Join the waiting list</a> to be notified when they reopen, or read on to see how it works, and explore our <a href="/services" class="underline hover:no-underline">programmes</a> and <a href="/get-involved" class="underline hover:no-underline">ways to support us</a> in the meantime.
      </p>
    </div>
  </div>

  <!-- At a glance -->
  <section class="relative z-10 -mb-10 pt-10 lg:pt-12" aria-label="The commitment at a glance">
    <div class="container mx-auto px-4 lg:px-8">
      <ul class="mx-auto grid max-w-5xl grid-cols-2 overflow-hidden rounded-2xl bg-white shadow-soft-lg ring-1 ring-black/5 lg:grid-cols-4 dark:bg-gray-800 dark:ring-white/10">
        {
          facts.map((f, i) => (
            <li class:list={['p-6 text-center lg:p-8', i % 2 === 1 && 'border-l border-gray-100 dark:border-gray-700', i > 1 && 'border-t border-gray-100 lg:border-t-0 dark:border-gray-700', i > 0 && 'lg:border-l lg:border-gray-100 lg:dark:border-gray-700']}>
              <p class="font-display text-3xl font-semibold leading-none text-primary-600 lg:text-4xl dark:text-primary-300">{f.value}</p>
              <p class="mt-3 font-semibold text-gray-900 dark:text-white">{f.label}</p>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{f.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Why Teach With Us -->
  <section class="pb-20 pt-24 lg:pb-20 lg:pt-24">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div>
          <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">Why Teach With Us</div>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
            Teaching that <em class="not-italic text-primary-600 dark:text-primary-400">works for you</em>
          </h2>
          <ul class="mt-8 grid gap-x-10 gap-y-6 md:grid-cols-2">
            {
              perks.map((perk) => (
                <li class="flex gap-4 border-t border-gray-200 pt-6 dark:border-gray-800">
                  <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-600 dark:bg-primary-900/50 dark:text-primary-300">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={icon[perk.icon as keyof typeof icon]} /></svg>
                  </span>
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{perk.title}</h3>
                    <p class="mt-1.5 leading-relaxed text-gray-600 dark:text-gray-400">{perk.description}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Languages -->
  <section class="page-hero py-14 lg:py-16">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Which Language Can You Offer?</h2>
        <p class="mt-3 text-lg text-white/85">We welcome fluent or native speakers of English, French, or German.</p>
      </div>
      <div class="mx-auto mt-8 flex max-w-3xl flex-wrap items-center justify-center gap-3">
        {
          languages.map((l) => (
            <a href={l.url} class="group inline-flex items-center gap-3 rounded-full border border-white/25 bg-white/10 py-2 pl-2 pr-5 text-white transition-all hover:-translate-y-0.5 hover:bg-white/20">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white text-sm font-bold text-primary-700">{l.code}</span>
              <span class="font-semibold">{l.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Getting Started: timeline -->
  <section class="bg-cream-100 py-20 lg:py-20 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">Getting Started</div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">Before You Start Teaching</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Six steps to complete before your first class.</p>
      </div>

      <ol class="relative mx-auto mt-14 max-w-3xl">
        <span class="absolute bottom-6 left-6 top-6 w-0.5 bg-primary-200 dark:bg-primary-800" aria-hidden="true"></span>
        {
          steps.map((step, i) => (
            <li class="relative pb-8 pl-20 last:pb-0">
              <span class:list={['absolute left-0 top-0 z-10 flex h-12 w-12 items-center justify-center rounded-full text-lg font-bold text-white ring-8 ring-cream-100 dark:ring-gray-900', i >= 4 ? 'bg-accent-500' : 'bg-primary-600']}>{step.number}</span>
              <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5 sm:p-6 dark:bg-gray-800 dark:ring-white/10">
                <p class:list={['text-xs font-bold uppercase tracking-wider', i >= 4 ? 'text-accent-500 dark:text-accent-300' : 'text-primary-600 dark:text-primary-300']}>{step.phase}</p>
                <h3 class="mt-1 text-lg font-semibold text-gray-900 dark:text-white">{step.title}</h3>
                <p class="mt-1.5 text-gray-600 dark:text-gray-400">{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Teaching Resources -->
  <section class="py-20 lg:py-20">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="mx-auto w-full max-w-md overflow-hidden rounded-2xl shadow-soft-lg ring-1 ring-black/5 lg:order-2 dark:ring-white/10">
          <img src="/assets/img/teacher-resources-preview.jpg" alt="A preview of the shared lesson-planning resource library available to Ramzunā volunteer educators, including guides on error correction, grammar lessons, keeping students motivated, and listening, reading, and speaking skills" class="w-full object-cover" loading="lazy" />
        </div>
        <div class="lg:order-1">
          <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">Ongoing Support</div>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">Lesson-Planning Resources for Our Educators</h2>
          <p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
            You are never planning lessons alone. Every volunteer educator gets access to a shared library of ready-made guides — covering error correction, grammar and skills lessons, and tips for keeping students engaged.
          </p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {
              library.map((item) => (
                <li class="flex items-center gap-3 rounded-xl bg-cream-100 px-4 py-3 text-gray-700 dark:bg-gray-900 dark:text-gray-300">
                  <svg class="h-5 w-5 flex-shrink-0 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  <span class="font-medium">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Educator voices -->
  {
    educatorVoices.length > 0 && (
      <section class="bg-cream-100 py-20 lg:py-20 dark:bg-gray-900" aria-labelledby="educator-voices">
        <div class="container mx-auto px-4 lg:px-8">
          <div class="mx-auto max-w-3xl text-center">
            <div class="mb-4 inline-flex items-center rounded-full bg-accent-100 px-3 py-1 text-sm font-medium text-accent-700 dark:bg-accent-900/50 dark:text-accent-300">Educator Stories</div>
            <h2 id="educator-voices" class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">From Our Volunteer Educators</h2>
          </div>
          <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
            {educatorVoices.map((t: { quote: string; author: string; role: string }, i: number) => (
              <figure class:list={['flex flex-col rounded-2xl p-8 shadow-sm', i % 2 === 0 ? 'bg-primary-600 text-white' : 'bg-white dark:bg-gray-800']}>
                <span aria-hidden="true" class:list={['font-display text-5xl leading-none', i % 2 === 0 ? 'text-white/50' : 'text-accent-200 dark:text-accent-800']}>&ldquo;</span>
                <blockquote class:list={['mt-2 flex-1 text-lg leading-relaxed', i % 2 === 0 ? 'text-white' : 'text-gray-700 dark:text-gray-300']}>{t.quote}</blockquote>
                <figcaption class:list={['mt-6 border-t pt-4', i % 2 === 0 ? 'border-white/20' : 'border-gray-100 dark:border-gray-700']}>
                  <p class:list={['font-semibold', i % 2 === 0 ? 'text-white' : 'text-gray-900 dark:text-white']}>{t.author}</p>
                  <p class:list={['text-sm', i % 2 === 0 ? 'text-white/75' : 'text-gray-500 dark:text-gray-400']}>{t.role}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- What We Look For -->
  <section class="py-20 lg:py-20">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div class="text-center lg:text-left">
          <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">What We Look For</div>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">The Makings of a Great Teacher</h2>
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Here are the requirements and responsibilities.</p>
        </div>
        <div class="space-y-8">
          {
            requirementGroups.map((group) => (
              <div>
                <h3 class="mb-3 text-sm font-bold uppercase tracking-wider text-accent-500 dark:text-accent-300">{group.title}</h3>
                <ul class="space-y-2">
                  {group.items.map((item) => (
                    <li class="flex items-start gap-3 rounded-xl border-l-4 border-primary-600 bg-white p-4 shadow-sm dark:bg-gray-800">
                      <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                      <span class="text-gray-700 dark:text-gray-300">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="page-hero py-16 lg:py-24">
    <div class="mx-auto max-w-2xl px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Applications Are Currently Closed for the Autumn Term</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">Thank you for your interest in teaching with us. We are not reviewing new applications right now, but <strong class="text-white">you can still register on our waiting list</strong> to be notified the moment they reopen.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/donate" class="inline-flex items-center justify-center rounded-lg bg-white px-8 py-3 font-medium text-primary-600 shadow-lg transition-colors hover:bg-gray-100">
          Make a Donation
        </a>
        <a href="https://forms.gle/r9dahwJBcRy9Dcym9" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-lg border-2 border-white/30 px-8 py-3 font-medium text-white transition-colors hover:bg-white/10">
          Join the Waiting List
        </a>
      </div>
    </div>
  </section>
</Base>
