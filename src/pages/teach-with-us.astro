---
import Base from '@/layouts/Base.astro';

const perks = [
  {
    title: 'Flexible hours',
    description: 'Teach when it suits you. Pick up sessions around your studies, work, or schedule — no fixed hours required. We will match you with students who share similar availability.',
  },
  {
    title: 'Meaningful impact',
    description: 'Directly support Palestinian students in Gaza, the West Bank and Egypt as they build the language skills they need to reach their goals.',
  },
  {
    title: 'A warm community',
    description: 'Join a global network of volunteer teachers and language partners united around the same cause.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Apply online',
    description: 'Fill in a short application telling us about your teaching experience and the language you can offer.',
  },
  {
    number: '02',
    title: 'Trauma-informed training',
    description: 'Complete our compulsory trauma-informed/EIE training before you start teaching.',
  },
  {
    number: '03',
    title: 'Sign the volunteer agreement',
    description: 'Sign our volunteer agreement and code of conduct (a criminal record check is also required to teach minors).',
  },
  {
    number: '04',
    title: 'Attend the group meeting',
    description: 'Join a compulsory collective group meeting with the wider teaching team before you are matched.',
  },
  {
    number: '05',
    title: 'Get matched with a group',
    description: 'We match you with a small group of students based on your language, level, and availability.',
  },
  {
    number: '06',
    title: 'Start teaching',
    description: 'Begin sharing your knowledge in classes you love, with ongoing coordinator support.',
  },
];

const requirements = [
  'Commitment to a weekly 90-minute lesson (plus 45 minutes of preparation) for at least 3 months',
  'Teaching qualifications or tutoring experience',
  'A reliable internet connection for online sessions',
  'Patient, encouraging and sensitive to trauma-informed teaching',
  'Comfortable tailoring methods to individual learner needs',
  'Commitment to completing a weekly attendance form after each lesson',
];
---

<Base title="Teach with Us" description="Become a volunteer teacher with Ramzunā Languages and help Palestinian students build real language skills.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Teach with Us</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Share your knowledge and help a Palestinian student build the language skills they need.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Teach with Us</span>
      </nav>
    </div>
  </section>

  <!-- Closed Notice -->
  <div class="bg-accent-50 py-4 dark:bg-accent-900/20">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <p class="text-sm font-medium text-accent-800 dark:text-accent-200">
        Volunteer teacher applications are currently closed for the autumn term. <a href="https://ee-eu.kobotoolbox.org/x/6pce2ex4" target="_blank" rel="noopener noreferrer" class="font-semibold underline hover:no-underline">Join the waiting list</a> to be notified when they reopen, or read on to see how it works, and explore our <a href="/services" class="underline hover:no-underline">programmes</a> and <a href="/get-involved" class="underline hover:no-underline">ways to support us</a> in the meantime.
      </p>
    </div>
  </div>

  <!-- Why Teach With Us -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">Why Teach With Us</div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Teaching that <em class="not-italic text-primary-600 dark:text-primary-400">works for you</em>
        </h2>
      </div>
      <div class="mt-16 grid gap-8 sm:grid-cols-3">
        {
          perks.map((perk) => (
            <div class="rounded-2xl bg-cream-100 p-8 shadow-sm dark:bg-gray-900">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{perk.title}</h3>
              <p class="mt-3 text-gray-600 dark:text-gray-400">{perk.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Getting Started -->
  <section class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">Getting Started</div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">Before You Start Teaching</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Six steps to complete before your first class.</p>
      </div>
      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          steps.map((step) => (
            <div class="text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 text-lg font-bold text-white">{step.number}</div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{step.title}</h3>
              <p class="mt-2 text-gray-600 dark:text-gray-400">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What We Look For -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">What We Look For</div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">The Makings of a Great Teacher</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Here are the requirements and responsibilities.</p>
      </div>
      <div class="mx-auto mt-12 grid max-w-3xl gap-4 sm:grid-cols-2">
        {
          requirements.map((item) => (
            <div class="flex items-start gap-3 rounded-xl border border-gray-200 p-4 dark:border-gray-800">
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600 dark:text-gray-400">{item}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Applications Are Currently Closed for the Autumn Term</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">Thank you for your interest in teaching with us. We are not reviewing new applications right now — explore our programmes or support our work with a donation instead.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/services" class="inline-flex items-center justify-center rounded-lg bg-white px-8 py-3 font-medium text-primary-600 shadow-lg transition-colors hover:bg-gray-100">
          Our Programmes
        </a>
        <a href="/donate" class="inline-flex items-center justify-center rounded-lg border-2 border-white/30 px-8 py-3 font-medium text-white transition-colors hover:bg-white/10">
          Make a Donation
        </a>
      </div>
    </div>
  </section>
</Base>
