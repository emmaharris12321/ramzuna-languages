---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';

export async function getStaticPaths() {
  const poems = await getCollection('voices', ({ data }) => !data.draft);
  return poems.map((poem) => ({
    params: { slug: poem.id },
    props: { poem, allPoems: poems },
  }));
}

const { poem, allPoems } = Astro.props;
const { Content } = await render(poem);

const moreByAuthor = allPoems.filter((p) => p.id !== poem.id && p.data.author === poem.data.author);
const others = allPoems.filter((p) => p.id !== poem.id && p.data.author !== poem.data.author);
const related = [...moreByAuthor, ...others].slice(0, 3);

const cardTheme = poem.data.cardTheme ?? 'green';
const cardGradientClasses =
  cardTheme === 'burgundy'
    ? 'bg-gradient-to-r from-accent-600 to-accent-700 dark:from-accent-800 dark:to-accent-900'
    : 'bg-gradient-to-r from-primary-600 to-primary-700 dark:from-primary-800 dark:to-primary-900';
const cardOverlayClass = cardTheme === 'burgundy' ? 'bg-accent-900/20' : 'bg-primary-900/20';
const cardSubtitleClass = cardTheme === 'burgundy' ? 'text-accent-100' : 'text-primary-100';
const languagesLabel = poem.data.languagesLabel ?? 'Arabic and English';
---

<style>
  /* Dot-texture on the fallback hero for a bit of warmth instead of a flat block */
  .poem-hero {
    position: relative;
    background-image: radial-gradient(rgba(255, 255, 255, 0.16) 1.5px, transparent 1.5px);
    background-size: 20px 20px;
  }

  /* Highlighted pull-quote block */
  .poem-quote-card {
    position: relative;
    border-radius: 1.5rem;
    background: #f7e9ea;
    padding: 2.25rem 1.75rem;
    text-align: center;
  }

  :global(.dark) .poem-quote-card {
    background: rgba(122, 34, 43, 0.18);
  }

  .poem-quote-glyph {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3.5rem;
    line-height: 0.5;
    color: rgba(122, 34, 43, 0.35);
    margin-bottom: 0.5rem;
  }

  :global(.dark) .poem-quote-glyph {
    color: rgba(224, 148, 156, 0.5);
  }

  /* The poem itself, presented exactly like the Mawtinī poem on the
     "Our Name" page: one flat brand-green card, no texture, no
     decoration — just the verse. */
  .poem-card {
    position: relative;
    text-align: left;
    --poem-accent-color: #38664f;
  }

  .poem-card[data-theme='burgundy'] {
    --poem-accent-color: #7a222b;
  }

  .poem-frame {
    position: relative;
    z-index: 1;
  }

  /* Language toggle, identical to the one on the Mawtinī poem: Arabic
     first, with the option to switch to English or see both. */
  .poem-content :global(.poem-langs) {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .poem-content :global(.poem-lang-btn) {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 9999px;
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .poem-content :global(.poem-lang-btn):hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .poem-content :global(.poem-lang-btn.is-active) {
    background: #fff;
    color: var(--poem-accent-color, #38664f);
    border-color: #fff;
  }

  .poem-content :global(.poem-pair) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .poem-content :global([data-mode='both'] .poem-pair) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .poem-content :global([data-mode='en'] .poem-ar),
  .poem-content :global([data-mode='en'] .poem-fr) {
    display: none;
  }

  .poem-content :global([data-mode='ar'] .poem-en),
  .poem-content :global([data-mode='ar'] .poem-fr) {
    display: none;
  }

  .poem-content :global([data-mode='fr'] .poem-ar),
  .poem-content :global([data-mode='fr'] .poem-en) {
    display: none;
  }

  @media (min-width: 640px) {
    .poem-content :global([data-mode='all'] .poem-pair) {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .poem-content :global([data-mode='all'] .poem-pair) {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  /* The poem itself — same font, same size, in both languages, exactly
     like the Mawtinī poem's .poem-text: only italic vs. normal and the
     line-height differ between English and Arabic. */
  .poem-groups {
    display: flex;
    flex-direction: column;
  }

  .poem-content :global(.poem-block) {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: #fff;
    margin: 0;
  }

  .poem-content :global(.poem-block p) {
    margin: 0;
  }

  .poem-content :global(.poem-block p + p) {
    margin-top: 0.75rem;
  }

  .poem-content :global(.poem-block + .poem-block) {
    margin-top: 2rem;
  }

  .poem-content :global(.poem-groups-ar) {
    text-align: right;
  }

  .poem-content :global(.poem-groups-ar .poem-block) {
    font-style: normal;
    line-height: 2;
  }

  /* Section headings inside a chapter (e.g. a multi-part memoir like
     Marah's "A Day of Breathing Life") — same white/serif system as the
     rest of the card, just larger and upright rather than italic, so a
     chapter's internal sections read clearly without breaking the
     poem-card's visual language. */
  .poem-content :global(h2),
  .poem-content :global(h3) {
    margin: 2rem 0 0.5rem;
    font-family: 'Playfair Display', Georgia, serif;
    font-style: normal;
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.4;
    color: #fff;
  }

  .poem-content :global(h2:first-child),
  .poem-content :global(h3:first-child) {
    margin-top: 0;
  }

  /* Author's own words, in Arabic — a short note beneath the poem. Same
     font, same size as the poem itself. */
  .poem-content :global(.poem-bio-ar),
  .poem-content :global(.poem-bio-fr) {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    font-family: 'Playfair Display', Georgia, serif;
    font-style: normal;
    font-size: 0.9375rem;
    line-height: 2;
    color: #fff;
    opacity: 0.88;
  }

  /* Cover-image hero, for poems that have their own designed graphic */
  .poem-cover {
    position: relative;
    display: block;
    width: 100%;
    max-height: 80vh;
    object-fit: cover;
    object-position: center 30%;
  }

  .poem-cover-bar {
    background: #2a2622;
  }
</style>

<Base title={`${poem.data.title} — ${poem.data.author}`} description={`${poem.data.tag} by ${poem.data.author}, published by Ramzunā Languages as part of Palestinian Voices.`}>
  <!-- Header -->
  {poem.data.coverImage ? (
    <section class="poem-cover-bar relative">
      <img
        src={poem.data.coverImage}
        alt={`Cover art for "${poem.data.title}" by ${poem.data.author}, published by Ramzunā Languages`}
        class="poem-cover"
      />
      <nav class="flex flex-wrap items-center justify-center gap-2 bg-black/40 py-3 text-sm text-white/80" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/palestinian-voices" class="transition-colors hover:text-white">Palestinian Voices</a>
        <span>/</span>
        <span class="text-white">{poem.data.title}</span>
      </nav>
    </section>
  ) : (
    <section class="poem-hero bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
      <div class="container mx-auto px-4 text-center lg:px-8">
        <span class="inline-flex items-center rounded-full bg-white/15 px-3 py-1 text-xs font-medium uppercase tracking-wider text-primary-100">
          {poem.data.tag} &middot; {poem.data.author}{poem.data.readTime && <> &middot; {poem.data.readTime}</>}
        </span>
        <h1 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">{poem.data.title}</h1>
        {poem.data.arabicTitle && (
          <p dir="rtl" lang="ar" class="mx-auto mt-3 font-display text-xl text-primary-100">{poem.data.arabicTitle}</p>
        )}
        {poem.data.frenchTitle && (
          <p lang="fr" class="mx-auto mt-1 font-display text-lg italic text-primary-100/90">{poem.data.frenchTitle}</p>
        )}
        <nav class="mt-6 flex flex-wrap items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-white">Home</a>
          <span>/</span>
          <a href="/palestinian-voices" class="transition-colors hover:text-white">Palestinian Voices</a>
          <span>/</span>
          <span class="text-white">{poem.data.title}</span>
        </nav>
      </div>
    </section>
  )}

  <article>
    <div class="bg-cream-100 py-14 lg:py-24 dark:bg-gray-900/40">
      <div class="container mx-auto px-4 lg:px-8">
        <div class="mx-auto max-w-xl">
          <!-- Author + pull quote -->
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-primary-600 font-display text-xl font-semibold text-white shadow-sm">
              {poem.data.author.charAt(0)}
            </div>
            <div>
              <p class="font-semibold text-gray-900 dark:text-white">{poem.data.author}</p>
              {poem.data.bio && <p class="mt-0.5 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{poem.data.bio}</p>}
            </div>
          </div>

          {poem.data.excerpt && (
            <div class="poem-quote-card mt-8">
              <span class="poem-quote-glyph" aria-hidden="true">&ldquo;</span>
              <p class="font-display text-xl italic leading-snug text-accent-800 sm:text-2xl dark:text-accent-200">
                {poem.data.excerpt}
              </p>
            </div>
          )}

          <!-- The poem, in the same card as the Mawtinī poem on the Our
               Name page: a header row with icon + title, then the poem
               itself on a slightly deeper shade of the same green,
               Arabic and English switchable. -->
          <div class={`poem-card mt-10 overflow-hidden rounded-2xl shadow-soft-lg ${cardGradientClasses}`} data-theme={cardTheme}>
            <div class="flex items-center gap-4 px-6 py-6">
              <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-white/15 text-white">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
              </span>
              <span class="flex-1">
                <span class="block text-lg font-semibold text-white">{poem.data.title}</span>
                <span class={`mt-0.5 block text-sm ${cardSubtitleClass}`}>In {languagesLabel}, by {poem.data.author}</span>
              </span>
            </div>
            <div class={`${cardOverlayClass} px-6 py-10 sm:px-10`}>
              <div class="poem-frame poem-content">
                <Content />
              </div>
            </div>
          </div>

          <!-- Back link -->
          <div class="mt-10 text-center">
            <a href="/palestinian-voices" class="inline-flex items-center gap-2 text-sm font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              Back to Palestinian Voices
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <script is:inline>
    (() => {
      document.querySelectorAll('[data-poem]').forEach((poem) => {
        const buttons = poem.querySelectorAll('[data-set-lang]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const mode = btn.getAttribute('data-set-lang');
            poem.setAttribute('data-mode', mode || 'both');
            buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
          });
        });
      });
    })();
  </script>

  <!-- More Voices -->
  {related.length > 0 && (
    <div class="bg-cream-100 py-16 lg:py-20 dark:bg-gray-900/50">
      <div class="container mx-auto px-4 lg:px-8">
        <div class="mx-auto max-w-5xl">
          <h2 class="font-display text-2xl font-semibold text-gray-900 dark:text-white">More from Palestinian Voices</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((rp) => (
              <a href={`/voices/${rp.id}`} class="group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 transition-all hover:shadow-lg dark:bg-gray-900 dark:ring-gray-800">
                <span class="text-xs font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400">{rp.data.tag}</span>
                <h3 class="mt-2 text-base font-bold text-gray-900 transition-colors group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">{rp.data.title}</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">by {rp.data.author}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Have something to share?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        If you are a Palestinian writer with a poem, story, or letter you would like included here, we would love to hear from you.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://ee-eu.kobotoolbox.org/x/IJHWeAbH" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-medium text-primary-600 shadow-lg transition-all hover:bg-gray-100">
          Submit Your Writing
        </a>
        <a href="/palestinian-voices" class="inline-flex items-center justify-center rounded-lg border border-white/30 px-6 py-3 text-sm font-medium text-white transition-all hover:bg-white/10">
          Back to Palestinian Voices
        </a>
      </div>
    </div>
  </section>
</Base>
