---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

const posts = await getCollection('voices', ({ data }) => !data.draft);

// One card per piece. A multi-chapter story (tag "Chapter N") is a single card
// that opens at chapter 1.
interface Piece {
  slug: string;
  title: string;
  arabicTitle?: string;
  author: string;
  excerpt: string;
  readTime?: string;
  chapters?: number;
}

const byAuthor = new Map<string, Piece[]>();
const sorted = [...posts].sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
for (const post of sorted) {
  const d = post.data;
  const list = byAuthor.get(d.author) ?? [];
  const isChapter = /^chapter\s*\d+/i.test(d.tag);
  const existing = isChapter ? list.find((p) => p.title === d.title && p.chapters) : undefined;
  if (existing) {
    existing.chapters = (existing.chapters ?? 1) + 1;
  } else {
    list.push({
      slug: post.id,
      title: d.title,
      arabicTitle: d.arabicTitle,
      author: d.author,
      excerpt: (d.excerpt ?? '').replace(/\s+/g, ' ').trim(),
      readTime: d.readTime,
      chapters: isChapter ? 1 : undefined,
    });
  }
  byAuthor.set(d.author, list);
}

const writers = [...byAuthor.keys()].sort((a, b) => a.localeCompare(b));

// Mix the writers so neighbouring cards differ (round-robin), instead of six
// poems by one person in a row.
const queues = writers.map((w) => [...byAuthor.get(w)!]);
const pieces: Piece[] = [];
while (queues.some((q) => q.length)) {
  for (const q of queues) {
    const next = q.shift();
    if (next) pieces.push(next);
  }
}

// Each writer keeps one cover colour, so their work is recognisable.
const tones = [
  { cover: 'bg-primary-600', text: 'text-white', glyph: 'text-white/40' },
  { cover: 'bg-accent-500', text: 'text-white', glyph: 'text-white/40' },
  { cover: 'bg-cream-200 dark:bg-gray-700', text: 'text-gray-900 dark:text-white', glyph: 'text-accent-300 dark:text-accent-400' },
];
const toneOf = (author: string) => tones[writers.indexOf(author) % tones.length];
---

<Base title="Palestinian Voices" description="Poems and stories written by Palestinian students, in Arabic and English.">
  <!-- Page Header -->
  <section class="page-hero py-16 lg:py-24">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <p dir="rtl" lang="ar" class="font-display text-2xl text-primary-100 sm:text-3xl">أصوات فلسطينية</p>
      <h1 class="mt-1 font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Palestinian Voices</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Poems and stories by Palestinian students, in Arabic and English.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/resources" class="transition-colors hover:text-white">Resources</a>
        <span>/</span>
        <span class="text-white">Palestinian Voices</span>
      </nav>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <!-- Search + writer filters (same behaviour as the blog) -->
      <div class="mx-auto max-w-2xl">
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
          </svg>
          <input
            type="search"
            data-blog-search
            placeholder="Search poems and stories..."
            class="w-full rounded-lg border border-gray-300 bg-white py-3 pl-12 pr-4 text-gray-900 placeholder-gray-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500"
          />
        </div>
        <div class="mt-6 flex flex-wrap justify-center gap-3" data-blog-filters>
          <button type="button" data-filter="all" class="rounded-full bg-primary-600 px-4 py-2 text-sm font-medium text-white transition-colors">All</button>
          {writers.map((w) => (
            <button type="button" data-filter={w} class="rounded-full bg-gray-200 px-4 py-2 text-sm font-medium text-gray-700 transition-colors dark:bg-gray-700 dark:text-gray-300">{w}</button>
          ))}
        </div>
      </div>

      <!-- Gallery -->
      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {pieces.map((piece, index) => {
          const tone = toneOf(piece.author);
          return (
            <article
              data-category={piece.author}
              class="group overflow-hidden rounded-2xl bg-white shadow-soft transition-all hover:shadow-soft-lg dark:bg-gray-800"
              data-animate="fade-in-up"
              data-delay={100 + (index % 3) * 50}
            >
              <a href={`/voices/${piece.slug}`} class="block">
                <div class:list={['relative flex aspect-[3/2] items-center justify-center overflow-hidden px-8 pb-8 pt-12 text-center', tone.cover]}>
                  <span aria-hidden="true" class:list={['absolute left-5 top-1 font-display text-6xl leading-none', tone.glyph]}>&ldquo;</span>
                  <p class:list={['relative line-clamp-5 font-display text-xl italic leading-relaxed transition-transform duration-300 group-hover:scale-105 sm:text-[1.4rem]', tone.text]}>{piece.excerpt}</p>
                </div>
                <div class="p-6">
                  <span class="inline-flex items-center rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
                    {piece.chapters ? `Story · ${piece.chapters} chapters` : 'Poem'}
                  </span>
                  <h3 class="mt-3 text-lg font-semibold text-gray-900 transition-colors group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">{piece.title}</h3>
                  {piece.arabicTitle && <p lang="ar" dir="rtl" class="mt-1 text-left text-sm text-gray-600 dark:text-gray-400">{piece.arabicTitle}</p>}
                  <div class="mt-4 flex items-center gap-3 border-t border-gray-100 pt-4 dark:border-gray-700">
                    <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-primary-600 font-display text-sm font-semibold text-white">{piece.author.charAt(0)}</span>
                    <div class="text-xs text-gray-500 dark:text-gray-400">
                      <div class="font-medium text-gray-700 dark:text-gray-300">{piece.author}</div>
                      <div>{piece.chapters ? `${piece.chapters} chapters` : piece.readTime}</div>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Submit -->
  <section class="page-hero py-16 lg:py-24">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Have something to share?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        If you are a Palestinian writer with a poem, story, or letter you would like included here, we would love to hear from you. We publish both the Arabic and English/French/German versions.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://ee-eu.kobotoolbox.org/x/IJHWeAbH" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-medium text-primary-600 shadow-lg transition-all hover:bg-gray-100">
          Submit Your Writing
        </a>
        <a href="/resources" class="inline-flex items-center justify-center rounded-lg border border-white/30 px-6 py-3 text-sm font-medium text-white transition-all hover:bg-white/10">
          Back to Resources
        </a>
      </div>
    </div>
  </section>
</Base>
