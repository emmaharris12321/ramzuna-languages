---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

const posts = await getCollection('voices', ({ data }) => !data.draft);

// One card per piece. A multi-chapter story (tag "Chapter N") is a single card
// that opens at chapter 1.
interface Piece {
  slug: string;
  title: string;
  arabicTitle?: string;
  author: string;
  excerpt: string;
  readTime?: string;
  tag: string;
  chapters?: number;
}

const byAuthor = new Map<string, Piece[]>();
const sorted = [...posts].sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
for (const post of sorted) {
  const d = post.data;
  const list = byAuthor.get(d.author) ?? [];
  const isChapter = /^chapter\s*\d+/i.test(d.tag);
  const existing = isChapter ? list.find((p) => p.title === d.title && p.chapters) : undefined;
  if (existing) {
    existing.chapters = (existing.chapters ?? 1) + 1;
  } else {
    list.push({
      slug: post.id,
      title: d.title,
      arabicTitle: d.arabicTitle,
      author: d.author,
      excerpt: (d.excerpt ?? '').replace(/\s+/g, ' ').trim(),
      readTime: d.readTime,
      tag: d.tag,
      chapters: isChapter ? 1 : undefined,
    });
  }
  byAuthor.set(d.author, list);
}

const writers = [...byAuthor.keys()].sort((a, b) => a.localeCompare(b));

---

<Base title="Palestinian Voices" description="Poems and stories written by Palestinian students, in Arabic and English.">
  <!-- Page Header -->
  <section class="page-hero py-16 lg:py-24">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <p dir="rtl" lang="ar" class="font-display text-2xl text-primary-100 sm:text-3xl">أصوات فلسطينية</p>
      <h1 class="mt-1 font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Palestinian Voices</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Poems and stories by Palestinian students, in Arabic and English.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/resources" class="transition-colors hover:text-white">Resources</a>
        <span>/</span>
        <span class="text-white">Palestinian Voices</span>
      </nav>
    </div>
  </section>

  <section class="collection-shell" data-voices-library>
    <div class="collection-intro">
      <div><p class="collection-eyebrow">Writing from Palestine</p><h2>Explore the collection</h2><p>Poetry, letters and stories, organised by writer. Multi-chapter works are collected in one place.</p></div>
      <p class="collection-meta">{writers.length} writers · {[...byAuthor.values()].reduce((n, items) => n + items.length, 0)} works</p>
    </div>
    <div class="collection-toolbar collection-panel">
      <div class="collection-field"><label for="voices-search">Search the collection</label><input id="voices-search" type="search" placeholder="Title, writer or words from a piece" data-voices-search /></div>
      <div class="collection-field"><label for="voices-writer">Writer</label><select id="voices-writer" data-writer><option value="">All writers</option>{writers.map(writer => <option value={writer}>{writer}</option>)}</select></div>
      <div class="collection-field"><label for="voices-kind">Collection</label><select id="voices-kind" data-kind><option value="">All works</option><option value="short">Poems & short pieces</option><option value="story">Chaptered stories</option></select></div>
    </div>
    <p class="collection-meta" data-voices-count role="status" aria-live="polite"></p>
    {writers.map(writer => (
      <section class="writer-section" data-writer-section>
        <div class="writer-heading"><h2>{writer}</h2><p>{byAuthor.get(writer)!.length} {byAuthor.get(writer)!.length === 1 ? 'work' : 'works'}</p></div>
        <div class="writing-list collection-panel">
          {byAuthor.get(writer)!.sort((a,b) => a.title.localeCompare(b.title)).map(piece => (
            <article class="writing-entry" data-writing data-author={writer} data-kind={piece.chapters ? 'story' : 'short'} data-search={`${piece.title} ${piece.arabicTitle ?? ''} ${writer} ${piece.excerpt}`.toLowerCase()}>
              <a href={`/voices/${piece.slug}`}>
                <p class="collection-meta">{piece.chapters ? `Story · ${piece.chapters} chapters` : piece.tag}{piece.readTime && !piece.chapters ? ` · ${piece.readTime}` : ''}</p>
                <h3>{piece.title}</h3>
                {piece.arabicTitle && <p class="writing-arabic" lang="ar" dir="rtl">{piece.arabicTitle}</p>}
                <p class="writing-excerpt">{piece.excerpt}</p>
                <span class="writing-link">{piece.chapters ? 'Read the story' : 'Read this piece'} <span aria-hidden="true">→</span></span>
              </a>
            </article>
          ))}
        </div>
      </section>
    ))}
    <p class="collection-empty" data-voices-empty hidden>No works match these filters. Try another writer or search term.</p>
  </section>

  <!-- Submit -->
  <section class="page-hero py-16 lg:py-24">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Have something to share?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        If you are a Palestinian writer with a poem, story, or letter you would like included here, we would love to hear from you. We publish both the Arabic and English/French/German versions.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://ee-eu.kobotoolbox.org/x/IJHWeAbH" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-medium text-primary-600 shadow-lg transition-all hover:bg-gray-100">
          Submit Your Writing
        </a>
        <a href="/resources" class="inline-flex items-center justify-center rounded-lg border border-white/30 px-6 py-3 text-sm font-medium text-white transition-all hover:bg-white/10">
          Back to Resources
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
function initVoices() {
 const root = document.querySelector<HTMLElement>('[data-voices-library]');
 if (!root || root.dataset.ready) return;
 root.dataset.ready = 'true';
 const search = root.querySelector<HTMLInputElement>('[data-voices-search]')!;
 const writer = root.querySelector<HTMLSelectElement>('[data-writer]')!;
 const kind = root.querySelector<HTMLSelectElement>('[data-kind]')!;
 function update() {
  const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
  let count = 0;
  root!.querySelectorAll<HTMLElement>('[data-writing]').forEach(item => {
   const visible = (!writer.value || item.dataset.author === writer.value) && (!kind.value || item.dataset.kind === kind.value) && terms.every(term => item.dataset.search!.includes(term));
   item.hidden = !visible; if(visible) count++;
  });
  root!.querySelectorAll<HTMLElement>('[data-writer-section]').forEach(section => { section.hidden = !section.querySelector('[data-writing]:not([hidden])'); });
  root!.querySelector('[data-voices-count]')!.textContent = `${count} ${count === 1 ? 'work' : 'works'}`;
  root!.querySelector<HTMLElement>('[data-voices-empty]')!.hidden = count !== 0;
 }
 search.addEventListener('input', update); writer.addEventListener('change', update); kind.addEventListener('change', update); update();
}
initVoices(); document.addEventListener('astro:page-load', initVoices);
</script>
