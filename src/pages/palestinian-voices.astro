---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

const voicePosts = await getCollection('voices', ({ data }) => !data.draft);

// Writers appear in this order. Their bios live here; every poem or chapter is
// read automatically from src/content/voices/*.md (matched on the `author` field),
// so adding a new .md file for an existing writer needs no change in this file.
// A brand-new writer only needs one new line below.
interface Writer {
  name: string;
  bio: string;
}

const writers: Writer[] = [
  { name: 'Amira', bio: 'Amira is a Palestinian translation student and writer. She writes to document the genocide Palestinians have endured, and she translates her words so the story of Palestinians reaches the world, ensuring it is never forgotten.' },
  { name: 'Arwa', bio: 'Arwa is a junior student at the Islamic University of Gaza, majoring in English translation and Literature. She turns to poetry and prose to translate silence into language and pain into meaning, believing that words are powerful tools of resistance, awareness, and transformation.' },
  { name: 'Mais', bio: 'Mais is only fourteen, yet her dreams far exceed her years. Mais believes learning is a never-ending journey. She dreams of becoming someone of value and influence who leaves a positive mark on her community and is remembered for her kindness and achievements.' },
  { name: 'Marah', bio: 'Twenty-two-year-old Marah started writing during the war, focusing on her experiences of trying not just to survive but also to live with her family. Writing is not a choice to her — it is a way to survive.' },
  { name: 'Noor', bio: 'Noor is a student in English Literature and Translation who is passionate about writing. She aims to use her craft to share the voice of Gaza with the world.' },
  { name: 'Shams', bio: 'Shams has a bachelor’s degree in English Language and Teaching Methods from Al-Aqsa University in Gaza. She is passionate about creative writing and translation, believing in the power of words to express resilience and hope.' },
  { name: 'Shahed', bio: 'Shahed is a Palestinian poet who writes from the heart of lived experience. Even when life shuts the door, she finds ways to reach out through her letters, believing that true connection cannot be measured by maps or blocked by walls.' },
  { name: 'Aya', bio: 'Aya Rezeq Aldeeb is a voice from Gaza, writing to be heard.' },
  { name: 'Menna', bio: 'Born in 2004, Menna is a translator, audio content presenter, podcaster, aspiring writer, and poet. Through her work, she brings life to her voice and to those the world has forgotten. Menna believes the genocide in Gaza has produced a new generation of writers. She writes many short texts you may find published on her Instagram page, and she also enjoys voice-over presentations and her latest work Roam the Streets and Collect Street Sayings, narrates colloquial Arabic street sayings alongside their English translations.' },
];

const authors = writers
  .map((w) => {
    const pieces = voicePosts
      .filter((v) => v.data.author === w.name)
      .sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
    return { ...w, id: w.name.toLowerCase(), pieces };
  })
  .filter((a) => a.pieces.length > 0);

const totalPoems = authors.reduce((sum, a) => sum + a.pieces.length, 0);

function searchText(author: string, v: (typeof voicePosts)[number]) {
  return [v.data.title, v.data.arabicTitle, v.data.tag, v.data.excerpt, author].filter(Boolean).join(' ').toLowerCase();
}
---

<Base title="Palestinian Voices" description="Poetry and prose from Palestinian students and writers, published by Ramzunā Languages.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Palestinian Voices</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">Poetry &amp; prose from Gaza, the West Bank, and displaced Palestinian writers.</p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/resources" class="transition-colors hover:text-white">Resources</a>
        <span>/</span>
        <span class="text-white">Palestinian Voices</span>
      </nav>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-accent-100 px-3 py-1 text-sm font-medium text-accent-700 dark:bg-accent-900/50 dark:text-accent-300">
          Poetry &amp; Prose
        </div>
        <p dir="rtl" lang="ar" class="font-display text-xl text-primary-600 dark:text-primary-400">أصوات فلسطينية</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          A living collection of writing
        </h2>
        <p class="mx-auto mt-4 max-w-md leading-relaxed text-lg text-gray-600 dark:text-gray-400">
          Sharing what survival, memory, and hope sound like in the words of Palestinian students and writers. Every piece written here is an act of sumud — proof that Palestinian culture, thought, and feeling endure.
        </p>
        <p class="mt-6 text-sm font-medium uppercase tracking-wider text-gray-400 dark:text-gray-500">
          {authors.length} writers &middot; {totalPoems} poems &amp; chapters
        </p>
      </div>
    </div>
  </section>

  <!-- Heritage Gallery -->
  <section class="py-4 lg:py-8">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-accent-100 px-3 py-1 text-sm font-medium text-accent-700 dark:bg-accent-900/50 dark:text-accent-300">
          Heritage &amp; Culture
        </div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Stories Told Through Art
        </h2>
        <p class="mx-auto mt-4 max-w-md leading-relaxed text-lg text-gray-600 dark:text-gray-400">
          Palestinian identity, memory and belonging, shared through the visual culture of our community.
        </p>
      </div>
      <div class="mx-auto mt-14 grid max-w-3xl gap-8 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-2xl bg-white shadow-sm dark:bg-gray-800">
          <div class="flex aspect-square w-full items-center justify-center bg-cream-100 p-3 dark:bg-gray-900">
            <img
              src="/assets/img/memory-heritage-poster.jpg"
              alt="A Ramzunā poster titled Memory: Traditions and Folk Stories, featuring an ornate letter M decorated with Palestinian embroidery patterns, a brass coffee pot and an open storybook"
              class="max-h-full max-w-full object-contain"
              loading="lazy"
            />
          </div>
          <figcaption class="p-4 text-center text-sm text-gray-500 dark:text-gray-400">Memory: Traditions &amp; Folk Stories</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl bg-white shadow-sm dark:bg-gray-800">
          <div class="flex aspect-square w-full items-center justify-center bg-cream-100 p-3 dark:bg-gray-900">
            <img
              src="/assets/img/identity-belonging-poster.jpg"
              alt="A Ramzunā poster in Arabic titled Identity and Belonging, showing the Dome of the Rock and a keffiyeh alongside an olive branch"
              class="max-h-full max-w-full object-contain"
              loading="lazy"
            />
          </div>
          <figcaption class="p-4 text-center text-sm text-gray-500 dark:text-gray-400">Identity &amp; Belonging &middot; الهوية والانتماء</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Read the collection: organised by writer, searchable like the blog -->
  <section id="writers" class="bg-cream-100 py-16 lg:py-24 dark:bg-gray-900" data-voices-directory>
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">Read the Collection</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
          Every piece is grouped under its writer. Choose a writer, search by title or theme, then select a card to read the full text in Arabic, English or both.
        </p>
      </div>

      <div class="mx-auto mt-10 max-w-2xl">
        <label for="voices-search" class="sr-only">Search poems and writers</label>
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
          </svg>
          <input
            id="voices-search"
            type="search"
            data-voices-search
            placeholder="Search by title, writer or theme..."
            class="w-full rounded-lg border border-gray-300 bg-white py-3 pl-12 pr-4 text-gray-900 placeholder-gray-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500"
          />
        </div>

        <p class="mt-6 text-center text-sm font-medium text-gray-600 dark:text-gray-400">Show writings by:</p>
        <div class="mt-3 flex flex-wrap justify-center gap-3" data-voices-filters role="group" aria-label="Filter by writer">
          <button type="button" data-author-filter="all" aria-pressed="true" class="voices-chip">
            All writers <span class="voices-chip-count">{totalPoems}</span>
          </button>
          {
            authors.map((a) => (
              <button type="button" data-author-filter={a.id} aria-pressed="false" class="voices-chip">
                {a.name} <span class="voices-chip-count">{a.pieces.length}</span>
              </button>
            ))
          }
        </div>
        <p data-voices-status role="status" class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400">
          {authors.length} writers &middot; {totalPoems} poems &amp; chapters
        </p>
      </div>

      <div class="mx-auto mt-12 max-w-6xl space-y-16">
        {
          authors.map((author, i) => {
            const tone = i % 2 === 0 ? 'accent' : 'primary';
            return (
              <section id={author.id} data-author-section={author.id} class="scroll-mt-28" aria-labelledby={`writer-${author.id}`}>
                <div class="flex flex-col gap-4 border-b border-gray-200 pb-6 sm:flex-row sm:items-start dark:border-gray-700">
                  <div
                    class:list={[
                      'flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full font-display text-xl font-semibold',
                      tone === 'primary'
                        ? 'bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300'
                        : 'bg-accent-100 text-accent-700 dark:bg-accent-900/50 dark:text-accent-300',
                    ]}
                    aria-hidden="true"
                  >
                    {author.name.charAt(0)}
                  </div>
                  <div class="min-w-0 flex-1">
                    <h3 id={`writer-${author.id}`} class="text-xl font-semibold text-gray-900 dark:text-white">
                      {author.name}
                      <span class="ml-2 text-sm font-normal text-gray-500 dark:text-gray-400">
                        {author.pieces.length} {author.pieces.length === 1 ? 'piece' : 'pieces'}
                      </span>
                    </h3>
                    <p class="mt-2 max-w-3xl leading-relaxed text-gray-600 dark:text-gray-400">{author.bio}</p>
                  </div>
                </div>

                <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                  {author.pieces.map((v) => (
                    <article
                      data-voice-card
                      data-search-text={searchText(author.name, v)}
                      class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-soft transition-all hover:shadow-soft-lg dark:bg-gray-800"
                    >
                      <a href={`/voices/${v.id}`} class="flex h-full flex-col p-6 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-500">
                        <span
                          class:list={[
                            'inline-flex w-fit items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
                            tone === 'primary'
                              ? 'bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300'
                              : 'bg-accent-100 text-accent-700 dark:bg-accent-900/50 dark:text-accent-300',
                          ]}
                        >
                          {v.data.tag}
                        </span>
                        <h4 class="mt-3 text-lg font-semibold text-gray-900 transition-colors group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">
                          {v.data.title}
                        </h4>
                        {v.data.arabicTitle && (
                          <p dir="rtl" lang="ar" class="mt-1 font-display text-gray-500 dark:text-gray-400">{v.data.arabicTitle}</p>
                        )}
                        {v.data.excerpt && (
                          <p class="mt-3 flex-1 italic text-gray-600 dark:text-gray-400">&ldquo;{v.data.excerpt}&rdquo;</p>
                        )}
                        <div class="mt-5 flex items-center justify-between gap-3 border-t border-gray-100 pt-4 text-sm dark:border-gray-700">
                          <span class="text-gray-500 dark:text-gray-400">
                            {author.name}{v.data.readTime && <> &middot; {v.data.readTime}</>}
                          </span>
                          <span class="flex items-center gap-1 font-semibold text-primary-700 dark:text-primary-300">
                            Read <span aria-hidden="true">→</span>
                          </span>
                        </div>
                      </a>
                    </article>
                  ))}
                </div>
              </section>
            );
          })
        }
      </div>

      <div data-voices-empty hidden class="mx-auto mt-12 max-w-xl rounded-lg border border-dashed border-gray-300 p-8 text-center text-gray-600 dark:border-gray-700 dark:text-gray-400">
        Nothing matches your search. Clear the search box or choose &ldquo;All writers&rdquo;.
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Have something to share?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        If you are a Palestinian writer with a poem, story, or letter you would like included here, we would love to hear from you. We publish both the Arabic and English/French/German versions.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://ee-eu.kobotoolbox.org/x/IJHWeAbH" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-medium text-primary-600 shadow-lg transition-all hover:bg-gray-100">
          Submit Your Writing
        </a>
        <a href="/resources" class="inline-flex items-center justify-center rounded-lg border border-white/30 px-6 py-3 text-sm font-medium text-white transition-all hover:bg-white/10">
          Back to Resources
        </a>
      </div>
    </div>
  </section>

  <!-- Closing Quote -->
  <section class="quote-section-photo py-12 lg:py-16">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="quote-glyph quote-glyph-photo" aria-hidden="true">&ldquo;</span>
        <p class="font-display text-xl italic leading-relaxed text-white sm:text-2xl" style="text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);">
          Against barbarity, poetry can resist only by confirming its attachment to human fragility like a blade of grass growing on a wall while armies march by.
        </p>
        <p class="mt-5 text-sm font-semibold text-white" style="text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);">Mahmoud Darwish</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-white/80" style="text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);">Palestinian poet &amp; author</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .quote-glyph {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 4rem;
    line-height: 0.5;
    color: rgba(122, 34, 43, 0.35);
    margin-bottom: 0.75rem;
  }

  :global(.dark) .quote-glyph {
    color: rgba(224, 148, 156, 0.5);
  }

  /* Palestinian Voices closing quote: the olive-branch photo fills the whole
     section edge to edge (no beige border), with just a light warm scrim so
     the photo stays bright while the white text keeps its contrast. The
     section itself is kept short (reduced vertical padding) so the banner
     doesn't dominate the end of the page. */
  .quote-section-photo {
    position: relative;
    background-image: linear-gradient(rgba(20, 11, 9, 0.32), rgba(20, 11, 9, 0.4)), url('/assets/img/olive-branch-quote-bg.jpg');
    background-size: cover;
    background-position: center;
  }

  .quote-glyph-photo {
    color: rgba(255, 255, 255, 0.75);
    font-size: 3rem;
  }
</style>

<style>
  [data-voices-directory] [hidden] { display: none !important; }

  .voices-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    background: #e5e7eb;
    color: #374151;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .voices-chip:hover { background: #d1d5db; }
  .voices-chip[aria-pressed='true'] { background: #38664f; color: #fff; }
  .voices-chip-count { font-size: 0.75rem; opacity: 0.75; }
  :global(.dark) .voices-chip { background: #374151; color: #d1d5db; }
  :global(.dark) .voices-chip:hover { background: #4b5563; }
  :global(.dark) .voices-chip[aria-pressed='true'] { background: #38664f; color: #fff; }
</style>

<script>
  function initVoices(root: HTMLElement) {
    if (root.dataset.initialised) return;
    root.dataset.initialised = 'true';

    const search = root.querySelector<HTMLInputElement>('[data-voices-search]')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-author-filter]')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-author-section]')];
    const status = root.querySelector<HTMLElement>('[data-voices-status]')!;
    const empty = root.querySelector<HTMLElement>('[data-voices-empty]')!;
    let active = 'all';

    function update() {
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let total = 0;
      let writers = 0;
      for (const section of sections) {
        const authorMatches = active === 'all' || section.dataset.authorSection === active;
        let count = 0;
        for (const card of section.querySelectorAll<HTMLElement>('[data-voice-card]')) {
          const ok = authorMatches && terms.every((t) => card.dataset.searchText?.includes(t));
          card.hidden = !ok;
          if (ok) count++;
        }
        section.hidden = count === 0;
        if (count > 0) writers++;
        total += count;
      }
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.authorFilter === active)));
      status.textContent = `${writers} writer${writers === 1 ? '' : 's'} · ${total} poem${total === 1 ? '' : 's'} & chapters shown`;
      empty.hidden = total !== 0;
    }

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        active = chip.dataset.authorFilter!;
        update();
      })
    );
    search.addEventListener('input', update);

    // Allow links such as /palestinian-voices#noor to open straight on one writer.
    function applyHash(scroll: boolean) {
      const fromHash = decodeURIComponent(location.hash.slice(1));
      if (fromHash && chips.some((c) => c.dataset.authorFilter === fromHash)) {
        active = fromHash;
        search.value = '';
        update();
        if (scroll) root.scrollIntoView();
      }
    }
    window.addEventListener('hashchange', () => applyHash(true));
    update();
    applyHash(true);
  }

  const init = () => document.querySelectorAll<HTMLElement>('[data-voices-directory]').forEach(initVoices);
  init();
  document.addEventListener('astro:page-load', init);
</script>
