---
import Base from '@/layouts/Base.astro';

interface Track {
  icon: string;
  title: string;
  desc: string;
}

interface Level {
  code: string;
  label: string;
  title: string;
  blurb: string;
  skills: string[];
  topics: string[];
  tracks: Track[];
}

const levels: Level[] = [
  {
    code: 'A1',
    label: 'Beginner',
    title: 'First Steps in French',
    blurb: 'Greetings, everyday phrases and the confidence to get by in familiar situations.',
    skills: [
      'Introduce yourself and others, and ask basic personal questions',
      'Understand and use familiar everyday expressions and simple phrases',
      'Handle short, simple exchanges if the other person speaks slowly and clearly',
      'Read and write simple notes, forms and short messages',
    ],
    topics: ['Alphabet & Pronunciation', 'Le Présent', 'Everyday Phrases', 'Numbers & Time'],
    tracks: [
      { icon: '📖', title: 'General', desc: 'Balanced, all-round progress.' },
      { icon: '🎓', title: 'Exam Prep', desc: 'Foundations for DELF A1.' },
      { icon: '💼', title: 'Business', desc: 'Simple emails & introductions.' },
    ],
  },
  {
    code: 'A2',
    label: 'Elementary',
    title: 'Everyday French',
    blurb: 'Talk about your routine, family and surroundings with growing ease.',
    skills: [
      'Describe your background, immediate environment and daily routine',
      'Communicate in simple, routine tasks requiring a direct exchange of information',
      'Understand frequently used expressions related to shopping, family and work',
      'Write short, simple notes, messages and personal letters',
    ],
    topics: ['Le Passé Composé', 'Daily Routines', 'Shopping & Travel', 'Family & Home'],
    tracks: [
      { icon: '📖', title: 'General', desc: 'Balanced, all-round progress.' },
      { icon: '🎓', title: 'Exam Prep', desc: 'Groundwork for DELF A2.' },
      { icon: '💼', title: 'Business', desc: 'Everyday workplace French.' },
    ],
  },
  {
    code: 'B1',
    label: 'Intermediate',
    title: 'Confident Conversation',
    blurb: 'Discuss work, travel and opinions, and handle most everyday situations.',
    skills: [
      'Express and justify opinions clearly in conversation and short writing',
      'Narrate past events and describe future plans with confidence',
      'Handle unplanned situations while travelling, studying or working abroad',
      'Understand the main points of clear, standard speech on familiar topics',
    ],
    topics: ['Le Subjonctif', 'Past Tenses', 'Opinions & Debate', 'Work & Study'],
    tracks: [
      { icon: '📖', title: 'General', desc: 'Balanced, all-round progress.' },
      { icon: '🎓', title: 'Exam Prep', desc: 'Targeting DELF B1.' },
      { icon: '💼', title: 'Business', desc: 'Meetings, emails & clients.' },
    ],
  },
  {
    code: 'B2',
    label: 'Upper Intermediate',
    title: 'Fluent & Independent',
    blurb: 'Argue a point of view clearly and communicate naturally with native speakers.',
    skills: [
      'Understand the main ideas of complex texts on concrete and abstract topics',
      'Interact with a degree of fluency that makes regular interaction possible',
      'Produce clear, detailed text and explain a viewpoint, weighing pros and cons',
      'Follow extended speech and complex argumentation on unfamiliar topics',
    ],
    topics: ['Advanced Grammar', 'Debate & Argument', 'Media & Current Affairs', 'Formal Writing'],
    tracks: [
      { icon: '📖', title: 'General', desc: 'Balanced, all-round progress.' },
      { icon: '🎓', title: 'Exam Prep', desc: 'Targeting DELF B2.' },
      { icon: '💼', title: 'Business', desc: 'Negotiations & presentations.' },
    ],
  },
  {
    code: 'C1',
    label: 'Advanced',
    title: 'Near-Native Mastery',
    blurb: 'Precise, spontaneous expression in academic, professional and social settings.',
    skills: [
      'Understand a wide range of demanding, longer texts and implicit meaning',
      'Express ideas fluently and spontaneously without obvious searching for words',
      'Use language flexibly for social, academic and professional purposes',
      'Produce clear, well-structured, detailed text on complex subjects',
    ],
    topics: ['Academic & Business French', 'Nuance & Idiom', 'Rhetoric & Persuasion', 'Formal Register'],
    tracks: [
      { icon: '📖', title: 'General', desc: 'Balanced, all-round progress.' },
      { icon: '🎓', title: 'Exam Prep', desc: 'DALF C1 preparation.' },
      { icon: '💼', title: 'Business', desc: 'Executive-level communication.' },
    ],
  },
];

const formats = [
  { title: 'Group Lessons', desc: 'Live, small groups' },
  { title: 'One-to-One', desc: 'Exam prep & special needs' },
  { title: 'Asynchronous', desc: 'Self-paced with feedback' },
];
---

<Base title="French Classes" description="Find your level in French, from first words to near-native fluency, with Ramzunā Languages.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">French Classes</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        From your first words to fluent, confident conversation: five stages, one clear path.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/services" class="transition-colors hover:text-white">Services</a>
        <span>/</span>
        <span class="text-white">French Classes</span>
      </nav>
    </div>
  </section>

  <!-- Levels -->
  <section class="py-20 lg:py-28" id="levels-page">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Find Your Level
        </div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Five stages, one clear path
        </h2>
        <p class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Every learner starts with a free placement chat so you join exactly where you belong.
        </p>
      </div>

      <!-- Progress track -->
      <div class="relative mx-auto mt-14 hidden max-w-xl items-start justify-between sm:flex">
        <div aria-hidden="true" class="absolute left-3 right-3 top-[11px] -z-10 h-0.5 bg-gradient-to-r from-primary-500 via-amber-500 to-accent-500 opacity-40"></div>
        {
          levels.map((level) => (
            <div class="flex flex-1 flex-col items-center gap-2">
              <div class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-accent-600 bg-cream-50 text-[10px] font-bold text-accent-600 dark:bg-gray-900">
                {level.code}
              </div>
              <span class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">{level.label}</span>
            </div>
          ))
        }
      </div>

      <!-- Accordion -->
      <div class="mx-auto mt-14 max-w-2xl space-y-4">
        {
          levels.map((level) => (
            <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-800">
              <button type="button" data-faq-toggle class="flex w-full items-center gap-5 p-6 text-left">
                <div class="flex-shrink-0 text-center">
                  <span class="font-display text-2xl font-semibold text-primary-600 dark:text-primary-400">{level.code}</span>
                  <span class="block text-[10px] font-medium uppercase tracking-wider text-gray-400 dark:text-gray-500">{level.label}</span>
                </div>
                <div class="flex-1">
                  <h3 class="font-display text-lg font-semibold text-accent-600 dark:text-accent-400">{level.title}</h3>
                  <p class="mt-0.5 text-gray-600 dark:text-gray-400">{level.blurb}</p>
                </div>
                <span
                  data-faq-icon
                  class="ml-2 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-700 transition-transform duration-200 dark:bg-primary-900/50 dark:text-primary-300"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12M6 12h12" />
                  </svg>
                </span>
              </button>
              <div class="overflow-hidden transition-all duration-300" style="max-height: 0px; opacity: 0;">
                <div class="border-t border-gray-100 px-6 pb-8 pt-6 dark:border-gray-700">
                  <h4 class="text-sm font-semibold uppercase tracking-wider text-primary-600 dark:text-primary-400">What you&rsquo;ll learn</h4>
                  <ul class="mt-3 space-y-2.5">
                    {level.skills.map((skill) => (
                      <li class="flex items-start gap-2.5 text-gray-600 dark:text-gray-400">
                        <svg class="mt-1 h-4 w-4 flex-shrink-0 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        {skill}
                      </li>
                    ))}
                  </ul>

                  <h4 class="mt-6 text-sm font-semibold uppercase tracking-wider text-primary-600 dark:text-primary-400">Topics covered</h4>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {level.topics.map((topic) => (
                      <span class="rounded-full bg-accent-100 px-3 py-1.5 text-xs font-semibold text-accent-700 dark:bg-accent-900/50 dark:text-accent-300">{topic}</span>
                    ))}
                  </div>

                  <h4 class="mt-6 text-sm font-semibold uppercase tracking-wider text-primary-600 dark:text-primary-400">Choose your focus</h4>
                  <div class="mt-3 grid gap-3 sm:grid-cols-3">
                    {level.tracks.map((track) => (
                      <div class="rounded-xl border border-gray-200 bg-cream-100 p-3 dark:border-gray-700 dark:bg-gray-900/50">
                        <div class="text-lg">{track.icon}</div>
                        <p class="mt-1 font-semibold text-gray-900 dark:text-white">{track.title}</p>
                        <p class="text-sm text-gray-500 dark:text-gray-400">{track.desc}</p>
                      </div>
                    ))}
                  </div>

                  <h4 class="mt-6 text-sm font-semibold uppercase tracking-wider text-primary-600 dark:text-primary-400">Choose your format</h4>
                  <div class="mt-3 space-y-2">
                    {formats.map((format) => (
                      <div class="flex items-center justify-between rounded-lg border border-gray-200 bg-cream-100 px-4 py-2.5 dark:border-gray-700 dark:bg-gray-900/50">
                        <span class="font-semibold text-gray-900 dark:text-white">{format.title}</span>
                        <span class="text-sm text-gray-500 dark:text-gray-400">{format.desc}</span>
                      </div>
                    ))}
                  </div>

                  <a
                    href="/contact"
                    class="mt-6 inline-flex items-center justify-center gap-2 rounded-lg bg-accent-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-accent-700"
                  >
                    Enrol at {level.code} <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Not sure which level fits you?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">Get in touch and we will match you with a free placement chat before your first lesson.</p>
      <a href="/contact" class="mt-8 inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-medium text-primary-600 shadow-lg transition-all hover:bg-gray-100">
        Contact Us
      </a>
    </div>
  </section>
</Base>
