
---
import Base from '@/layouts/Base.astro';

// IMPORTANT:
// Update the existing WhyDonate campaign to reflect
// this new purpose before publishing this page.
// Alternatively, replace this URL with a new campaign.
const donationUrl =
  'https://whydonate.com/fundraising/ramzuna-our-symbol-of-hope-in-every-lesson';
---

<Base
  title="Donate"
  description="Support Ramzunā Languages by helping fund a programme coordinator and curriculum creator for free language education."
>
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">
        Help Us Keep Education Moving Forward
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Support the people behind free language education
        for Palestinian students.
      </p>

      <nav
        class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200"
        aria-label="Breadcrumb"
      >
        <a href="/" class="transition-colors hover:text-white">
          Home
        </a>
        <span>/</span>
        <span class="text-white">Donate</span>
      </nav>
    </div>
  </section>

  <!-- Our Work So Far -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Building on What We've Achieved
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Hundreds of Hours of Learning. More to Build.
        </h2>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Ramzunā Languages has already delivered hundreds of hours
          of free language instruction to Palestinian students.
          Through language learning, conversation and poetry,
          we seek to create opportunities for education,
          expression and human connection.
        </p>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          To sustain and strengthen this work, we need more
          than dedicated volunteers. We need the people and
          resources to coordinate our programmes and develop
          structured, high-quality learning materials.
        </p>
      </div>
    </div>
  </section>

  <!-- Funding Priorities -->
  <section class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Our Current Priorities
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          What Your Donation Supports
        </h2>

        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
          We are raising funds for two essential roles that
          will help us deliver more consistent and sustainable
          educational programmes.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-2">

        <!-- Programme Coordinator -->
        <article class="rounded-2xl bg-white p-8 shadow-soft dark:bg-gray-800">
          <span class="inline-flex rounded-full bg-accent-100 px-3 py-1 text-sm font-semibold text-accent-700 dark:bg-accent-900/30 dark:text-accent-300">
            Programme Delivery
          </span>

          <h3 class="mt-5 font-display text-2xl font-semibold text-gray-900 dark:text-white">
            Programme Coordinator
          </h3>

          <p class="mt-4 leading-relaxed text-gray-600 dark:text-gray-400">
            Good educational programmes require careful
            coordination. A dedicated coordinator would help
            us manage our teaching activities, support
            volunteers and ensure that learners receive
            consistent educational opportunities.
          </p>

          <ul class="mt-6 space-y-3 text-gray-600 dark:text-gray-400">
            <li>• Coordinate teachers and conversation partners</li>
            <li>• Organise teaching schedules and communication</li>
            <li>• Support volunteers and programme delivery</li>
            <li>• Monitor activities and identify improvements</li>
          </ul>
        </article>

        <!-- Curriculum Creator -->
        <article class="rounded-2xl bg-white p-8 shadow-soft dark:bg-gray-800">
          <span class="inline-flex rounded-full bg-accent-100 px-3 py-1 text-sm font-semibold text-accent-700 dark:bg-accent-900/30 dark:text-accent-300">
            Educational Development
          </span>

          <h3 class="mt-5 font-display text-2xl font-semibold text-gray-900 dark:text-white">
            Curriculum Creator
          </h3>

          <p class="mt-4 leading-relaxed text-gray-600 dark:text-gray-400">
            Developing an effective curriculum requires
            specialist knowledge, preparation and time.
            Supporting this role will help us create
            structured resources suited to our learners
            and improve continuity between lessons.
          </p>

          <ul class="mt-6 space-y-3 text-gray-600 dark:text-gray-400">
            <li>• Develop structured language-learning materials</li>
            <li>• Define learning objectives and lesson sequences</li>
            <li>• Create resources for teachers and learners</li>
            <li>• Improve materials using feedback from lessons</li>
          </ul>
        </article>
      </div>

      <div class="mx-auto mt-12 max-w-3xl text-center">
        <p class="text-lg text-gray-600 dark:text-gray-400">
          By supporting these roles, you help build the
          foundation for more reliable and effective
          educational opportunities.
        </p>

        <a
          href={donationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center justify-center rounded-lg bg-accent-500 px-8 py-4 text-base font-medium text-white shadow-lg transition-all hover:bg-accent-600"
        >
          Support Our Work
        </a>
      </div>
    </div>
  </section>

  <!-- Transparency -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Transparency
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          How Your Donation Is Used
        </h2>

        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
          Contributions to this campaign support programme
          coordination and curriculum development.
        </p>
      </div>

      <div class="mt-14 grid gap-8 sm:grid-cols-3">
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 font-bold text-white">
            01
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            You Contribute
          </h3>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            Donate through our fundraising platform to
            support our educational programmes.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 font-bold text-white">
            02
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            We Fund Essential Work
          </h3>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            Funds help cover the work of a programme
            coordinator and curriculum creator.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 font-bold text-white">
            03
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            We Share Progress
          </h3>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            We will share updates on the work supported
            and how contributions have been used.
          </p>
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-3xl rounded-xl bg-primary-50 p-6 text-gray-700 dark:bg-primary-900/20 dark:text-gray-300">
        <p>
          <strong class="text-primary-700 dark:text-primary-300">
            Our commitment:
          </strong>
          Donations to this appeal will support these two
          funding priorities, subject to applicable payment
          processing fees. Allocation between the roles
          will depend on programme needs and available
          funding. If sufficient funds are not raised,
          we may reduce or defer the planned work and
          will communicate significant changes.
        </p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">
        Help Us Build a Sustainable Future for Learning
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Your contribution helps provide the coordination
        and educational resources needed to continue
        our work.
      </p>

      <a
        href={donationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center rounded-lg bg-white px-8 py-4 font-medium text-primary-700 shadow-lg transition-colors hover:bg-gray-100"
      >
        Make a Donation
      </a>

      <p class="mx-auto mt-8 text-sm text-primary-100">
        Unable to donate? You can also support us through
        volunteering, professional expertise or partnerships.
      </p>

      <a
        href="/partners"
        class="mt-4 inline-flex rounded-lg border border-white/40 px-6 py-3 font-medium text-white transition-colors hover:bg-white/10"
      >
        Explore Partnerships
      </a>
    </div>
  </section>
</Base>
