
---
import Base from '@/layouts/Base.astro';

const donationUrl =
  'https://whydonate.com/fundraising/support-the-people-behind-free-education-in-palestine';

const coordinationActivities = [
  {
    title: 'Maintain Free Access',
    description:
      'Keep language courses, conversation partnerships and educational activities available to Palestinian students without tuition fees.',
  },
  {
    title: 'Coordinate Classes and Logistics',
    description:
      'Support local Palestinian coordinators in organising student participation, arranging lesson schedules and addressing practical challenges.',
  },
  {
    title: 'Support Volunteer Educators',
    description:
      'Provide teachers and conversation partners with the coordination, communication and operational guidance needed to deliver their lessons.',
  },
  {
    title: 'Monitor Quality and Collect Feedback',
    description:
      'Follow up with students and educators, gather feedback and identify improvements to the learning experience.',
  },
  {
    title: 'Ensure Programme Continuity',
    description:
      'Maintain the coordination and administrative work needed to keep classes running reliably and support students throughout their learning.',
  },
];

const curriculumLevels = [
  { level: 'A1', sublevels: 'A1.1 + A1.2' },
  { level: 'A2', sublevels: 'A2.1 + A2.2' },
  { level: 'B1', sublevels: 'B1.1 + B1.2' },
  { level: 'B2', sublevels: 'B2.1 + B2.2' },
];

const curriculumProjects = [
  {
    label: 'Fund One Sublevel',
    lessons: '12 Lessons',
    title: 'Develop One Structured Learning Unit',
    description:
      'Help us develop one sublevel, such as A1.1, A2.2 or B1.1. Each sublevel is planned to provide a complete sequence of 12 lessons with clearly defined learning objectives.',
    features: [
      'Learning objectives and lesson plans',
      'Practical exercises and teaching resources',
      'Activities to develop language skills',
      'Assessment and progress-checking activities',
    ],
  },
  {
    label: 'Fund One Complete Level',
    lessons: '24 Lessons',
    title: 'Develop a Complete CEFR Level',
    description:
      'Help us develop an entire CEFR level, such as A1 or B1, comprising two connected sublevels. This establishes a coherent learning pathway through which students can progress systematically.',
    features: [
      'Two connected 12-lesson sublevels',
      'A coordinated progression of learning objectives',
      'Structured teaching materials across both sublevels',
      'Exercises and assessments supporting progression',
    ],
  },
];
---

<Base
  title="Donate — Support Free Language Education"
  description="Support local Palestinian coordinators and the development of structured English, French and German curricula to keep language education free."
>
  <!-- Hero -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="mx-auto max-w-4xl font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">
        Support the Work Behind Free Language Education
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-primary-100">
        Help Ramzunā Languages sustain free English, French and
        German lessons for Palestinian students by supporting
        local programme coordination and the development of
        structured language curricula.
      </p>

      <a
        href={donationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center rounded-lg bg-accent-500 px-8 py-4 font-medium text-white shadow-lg transition-colors hover:bg-accent-600"
      >
        Make a Donation
      </a>

      <nav
        class="mt-8 flex items-center justify-center gap-2 text-sm text-primary-200"
        aria-label="Breadcrumb"
      >
        <a href="/" class="transition-colors hover:text-white">
          Home
        </a>
        <span>/</span>
        <span class="text-white">Donate</span>
      </nav>
    </div>
  </section>

   

  <!-- Priority 1: Free Lessons -->
  <section class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Funding Priority 01
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Keep Lessons Free
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Our primary goal is to ensure that language education
          remains completely free and accessible for Palestinian
          students. Funding this priority covers the essential
          coordination, administration and logistics needed to
          keep our classes running reliably without placing a
          financial burden on learners.
        </p>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Local Palestinian coordinators are central to this
          work. They manage the day-to-day organisation that
          makes volunteer-led teaching possible, connecting
          students and educators while helping lessons
          continue despite practical difficulties.
        </p>
      </div>

      <div class="mx-auto mt-12 max-w-5xl">
        <h3 class="mb-7 font-display text-xl font-semibold text-gray-900 dark:text-white">
          What Your Support Enables
        </h3>

        <div class="grid gap-5 md:grid-cols-2">
          {coordinationActivities.map((activity, index) => (
            <article class="rounded-xl bg-white p-7 shadow-soft dark:bg-gray-800">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 text-sm font-bold text-primary-700 dark:bg-primary-900 dark:text-primary-300">
                {String(index + 1).padStart(2, '0')}
              </div>

              <h4 class="font-display text-lg font-semibold text-gray-900 dark:text-white">
                {activity.title}
              </h4>

              <p class="mt-3 leading-relaxed text-gray-600 dark:text-gray-400">
                {activity.description}
              </p>
            </article>
          ))}
        </div>
      </div>

      <div class="mx-auto mt-10 max-w-3xl rounded-xl border border-primary-200 bg-white p-7 dark:border-primary-800 dark:bg-gray-800">
        <p class="leading-relaxed text-gray-700 dark:text-gray-300">
          <strong class="text-gray-900 dark:text-white">
            Why this funding is essential:
          </strong>
          Volunteer educators generously contribute their
          teaching time, but the programme depends on sustained
          local coordination. Supporting this work helps ensure
          that students can attend organised lessons and continue
          learning without paying tuition fees.
        </p>
      </div>
    </div>
  </section>

  <!-- Priority 2: Curriculum Development -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Funding Priority 02
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Curriculum Development
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          We are working towards developing complete,
          structured curricula for English, French and
          German, covering levels A1 to B2 of the
          Common European Framework of Reference
          for Languages (CEFR).
        </p>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Each language curriculum will consist of eight
          sublevels, from A1.1 to B2.2, with 12 lessons
          per sublevel. Our aim is to create accessible,
          carefully designed teaching materials that can
          be used by successive groups of students.
        </p>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Developing these resources will provide volunteer
          educators with shared teaching materials and clear
          learning objectives, while allowing students to
          follow a more consistent and progressive
          educational pathway.
        </p>
      </div>

      <!-- Curriculum Structure -->
      <div class="mx-auto mt-12 max-w-5xl rounded-2xl bg-cream-100 p-8 dark:bg-gray-900 sm:p-10">
        <h3 class="text-center font-display text-xl font-semibold text-gray-900 dark:text-white">
          Our Planned Curriculum Structure
        </h3>

        <p class="mt-3 text-center text-sm text-gray-600 dark:text-gray-400">
          For each language: English, French and German
        </p>

        <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
          {curriculumLevels.map((item) => (
            <div class="rounded-xl bg-white p-5 text-center dark:bg-gray-800">
              <h4 class="font-display text-2xl font-semibold text-primary-700 dark:text-primary-300">
                {item.level}
              </h4>

              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                {item.sublevels}
              </p>

              <p class="mt-3 font-semibold text-gray-900 dark:text-white">
                24 Lessons
              </p>
            </div>
          ))}
        </div>

        <div class="mt-8 grid grid-cols-3 gap-4 border-t border-gray-200 pt-8 text-center dark:border-gray-700">
          <div>
            <p class="font-display text-2xl font-semibold text-gray-900 sm:text-3xl dark:text-white">
              4
            </p>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
              CEFR Levels
            </p>
          </div>

          <div>
            <p class="font-display text-2xl font-semibold text-gray-900 sm:text-3xl dark:text-white">
              8
            </p>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
              Sublevels
            </p>
          </div>

          <div>
            <p class="font-display text-2xl font-semibold text-gray-900 sm:text-3xl dark:text-white">
              96
            </p>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
              Lessons per Language
            </p>
          </div>
        </div>

        <p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
          Planned development across all three languages:
          288 structured lessons.
        </p>
      </div>

      <!-- Curriculum Projects -->
      <div class="mx-auto mt-16 max-w-5xl">
        <div class="mx-auto max-w-3xl text-center">
          <h3 class="font-display text-2xl font-semibold text-gray-900 sm:text-3xl dark:text-white">
            Curriculum Projects You Can Help Fund
          </h3>

          <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
            Developing a complete curriculum is a substantial
            undertaking. We have divided this work into
            defined projects that can be supported
            progressively through contributions.
          </p>
        </div>

        <div class="mt-10 grid gap-8 md:grid-cols-2">
          {curriculumProjects.map((project) => (
            <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-8 shadow-soft dark:border-gray-700 dark:bg-gray-800 sm:p-10">
              <span class="inline-flex self-start rounded-full bg-primary-100 px-3 py-1 text-sm font-semibold text-primary-700 dark:bg-primary-900 dark:text-primary-300">
                {project.label}
              </span>

              <p class="mt-6 font-display text-3xl font-semibold text-primary-700 dark:text-primary-300">
                {project.lessons}
              </p>

              <h4 class="mt-4 font-display text-xl font-semibold text-gray-900 dark:text-white">
                {project.title}
              </h4>

              <p class="mt-5 leading-relaxed text-gray-600 dark:text-gray-400">
                {project.description}
              </p>

              <h5 class="mt-7 font-semibold text-gray-900 dark:text-white">
                Planned project components:
              </h5>

              <ul class="mt-4 list-disc space-y-3 pl-5 leading-relaxed text-gray-600 marker:text-primary-600 dark:text-gray-400">
                {project.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>

              <div class="mt-auto pt-8">
                <a
                  href={donationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Donate to support curriculum development: ${project.label}`}
                  class="inline-flex w-full items-center justify-center rounded-lg bg-primary-600 px-6 py-3 font-medium text-white transition-colors hover:bg-primary-700"
                >
                  Contribute to Curriculum Development
                </a>
              </div>
            </article>
          ))}
        </div>

        <p class="mx-auto mt-7 max-w-3xl text-center text-sm leading-relaxed text-gray-500 dark:text-gray-400">
          These are defined curriculum development projects.
          Contributions are combined and allocated according
          to the programme's most urgent funding needs.
        </p>
      </div>
    </div>
  </section>

  <!-- Donation Allocation -->
  <section class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          How Donations Are Used
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Supporting the Most Urgent Needs
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Donations are allocated across our fundraising
          priorities according to where support is most
          urgently needed.
        </p>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          This may involve directing funds towards the
          coordination and administration required to
          maintain existing free lessons, or towards
          specific curriculum development projects,
          including individual 12-lesson sublevels
          and complete 24-lesson CEFR levels.
        </p>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Contributions are combined to support these
          activities and projects as needs arise.
          This approach allows us to address immediate
          operational requirements while continuing to
          invest in structured teaching resources.
        </p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">
        Every Contribution Makes a Difference
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-primary-100">
        Contributions of any size support the projects and activities
        that need funding most urgently.
      </p>


      <a
        href={donationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-9 inline-flex items-center justify-center rounded-lg bg-white px-8 py-4 font-medium text-primary-700 shadow-lg transition-colors hover:bg-gray-100"
      >
        Make a Donation
      </a>

      <p class="mx-auto mt-10 text-sm text-primary-100">
        Unable to donate? You can also support our work
        through volunteering, professional expertise
        or institutional partnerships.
      </p>

      <a
        href="/partners"
        class="mt-4 inline-flex rounded-lg border border-white/40 px-6 py-3 font-medium text-white transition-colors hover:bg-white/10"
      >
        Explore Partnerships
      </a>
    </div>
  </section>
</Base>

