

---
import Base from '@/layouts/Base.astro';

// Update this link to the revised WhyDonate campaign
// before publishing the website.
const donationUrl =
  'https://whydonate.com/fundraising/ramzuna-our-symbol-of-hope-in-every-lesson';

// Illustrative budgets — confirm actual costs before
// presenting them as firm fundraising targets.
const sublevelBudget = 1500;
const completeLevelBudget = 3000;

const formatGBP = (amount: number) =>
  new Intl.NumberFormat('en-GB', {
    style: 'currency',
    currency: 'GBP',
    maximumFractionDigits: 0,
  }).format(amount);

const curriculumLevels = [
  { level: 'A1', sublevels: ['A1.1', 'A1.2'] },
  { level: 'A2', sublevels: ['A2.1', 'A2.2'] },
  { level: 'B1', sublevels: ['B1.1', 'B1.2'] },
  { level: 'B2', sublevels: ['B2.1', 'B2.2'] },
];
---

<Base
  title="Donate"
  description="Support free language education for Palestinian students by funding curriculum development and programme coordination at Ramzunā Languages."
>
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">
        Help Us Build a Sustainable Future for Education
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Support the development of structured language-learning
        resources and the people who make free education possible
        for Palestinian students.
      </p>

      <nav
        class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200"
        aria-label="Breadcrumb"
      >
        <a href="/" class="transition-colors hover:text-white">
          Home
        </a>
        <span>/</span>
        <span class="text-white">Donate</span>
      </nav>
    </div>
  </section>

  <!-- Introduction -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Building on What We've Achieved
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Hundreds of Hours of Teaching. More to Build.
        </h2>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Ramzunā Languages has already delivered hundreds of hours
          of free language instruction to Palestinian students.
          Through language learning, conversation and poetry, we
          create opportunities for education, expression and
          meaningful human connection.
        </p>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Our next challenge is to make these opportunities more
          consistent and sustainable. We are raising funds to
          develop structured curricula and strengthen the
          coordination of our educational programmes.
        </p>
      </div>
    </div>
  </section>

  <!-- Curriculum Development -->
  <section class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Funding Priority 01
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Help Us Develop Our Language Curriculum
        </h2>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          We are developing structured curricula for English,
          French and German, from beginner to upper-intermediate
          level. Each language is organised into eight sublevels,
          from A1.1 to B2.2.
        </p>

        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
          Each sublevel will contain 12 lessons, with clear
          learning objectives, teaching resources, practical
          exercises and opportunities to assess progress.
        </p>
      </div>

      <!-- Sponsorship Options -->
      <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-2">

        <!-- One Sublevel -->
        <article class="flex flex-col rounded-2xl bg-white p-8 shadow-soft dark:bg-gray-800">
          <span class="inline-flex self-start rounded-full bg-accent-100 px-3 py-1 text-sm font-semibold text-accent-700 dark:bg-accent-900/30 dark:text-accent-300">
            12 Lessons
          </span>

          <h3 class="mt-5 font-display text-2xl font-semibold text-gray-900 dark:text-white">
            Fund One Sublevel
          </h3>

          <p class="mt-3 text-gray-600 dark:text-gray-400">
            Help fund the development of one complete
            curriculum unit, such as A1.1 or B1.2,
            in one language.
          </p>

          <div class="mt-6">
            <p class="text-4xl font-bold text-primary-600 dark:text-primary-400">
              {formatGBP(sublevelBudget)}
            </p>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              Illustrative development budget
            </p>
          </div>

          <ul class="mt-6 space-y-3 text-gray-600 dark:text-gray-400">
            <li>• 12 structured lessons</li>
            <li>• Learning objectives and lesson sequences</li>
            <li>• Exercises and teaching resources</li>
            <li>• Assessment activities</li>
            <li>• Review and refinement of materials</li>
          </ul>

          <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">
            A defined learning unit that can be used and
            improved over successive teaching cycles.
          </p>
        </article>

        <!-- Complete Level -->
        <article class="flex flex-col rounded-2xl border-2 border-primary-600 bg-white p-8 shadow-soft dark:bg-gray-800">
          <span class="inline-flex self-start rounded-full bg-primary-100 px-3 py-1 text-sm font-semibold text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
            24 Lessons
          </span>

          <h3 class="mt-5 font-display text-2xl font-semibold text-gray-900 dark:text-white">
            Fund a Complete Level
          </h3>

          <p class="mt-3 text-gray-600 dark:text-gray-400">
            Help fund two connected sublevels, such as
            A1.1 and A1.2, forming a complete A1
            curriculum in one language.
          </p>

          <div class="mt-6">
            <p class="text-4xl font-bold text-primary-600 dark:text-primary-400">
              {formatGBP(completeLevelBudget)}
            </p>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              Illustrative development budget
            </p>
          </div>

          <ul class="mt-6 space-y-3 text-gray-600 dark:text-gray-400">
            <li>• 24 structured lessons</li>
            <li>• Two connected curriculum sublevels</li>
            <li>• Progressive learning objectives</li>
            <li>• Teaching and assessment resources</li>
            <li>• A coherent learning pathway</li>
          </ul>

          <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">
            A complete level that helps learners progress
            systematically through a stage of their
            language education.
          </p>
        </article>
      </div>

      <!-- Curriculum Roadmap -->
      <div class="mx-auto mt-16 max-w-4xl">
        <h3 class="text-center font-display text-2xl font-semibold text-gray-900 dark:text-white">
          Our Curriculum Roadmap
        </h3>

        <p class="mx-auto mt-3 max-w-2xl text-center text-gray-600 dark:text-gray-400">
          Each language curriculum will progress through four
          complete levels, divided into eight sublevels.
          We aim to develop these progressively as resources
          become available.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {curriculumLevels.map(({ level, sublevels }) => (
            <div class="rounded-xl bg-white p-5 text-center shadow-sm dark:bg-gray-800">
              <h4 class="text-2xl font-bold text-primary-600 dark:text-primary-400">
                {level}
              </h4>
              <p class="mt-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                {sublevels.join(' + ')}
              </p>
              <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                24 lessons
              </p>
            </div>
          ))}
        </div>

        <p class="mt-5 text-center text-sm text-gray-500 dark:text-gray-400">
          96 planned lessons per language across A1–B2.
          Each complete level contains two 12-lesson sublevels.
        </p>
      </div>

      <div class="mx-auto mt-10 max-w-3xl text-center">
        <p class="text-lg text-gray-600 dark:text-gray-400">
          You do not need to fund an entire sublevel.
          Contributions of any size can help us commission
          curriculum development, one learning unit at a time.
        </p>

        <a
          href={donationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center justify-center rounded-lg bg-accent-500 px-8 py-4 font-medium text-white shadow-lg transition-all hover:bg-accent-600"
        >
          Support Curriculum Development
        </a>

        <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
          These budgets are preliminary estimates based on
          planned development time. Final costs will depend
          on the agreed scope and specialist rates.
        </p>
      </div>
    </div>
  </section>

  <!-- Programme Coordination -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="text-center">
          <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
            Funding Priority 02
          </span>

          <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
            Help Us Coordinate Our Educational Programmes
          </h2>

          <p class="mt-5 text-lg text-gray-600 dark:text-gray-400">
            A successful educational programme needs more
            than good teaching materials. It also requires
            reliable coordination, communication and
            ongoing support for everyone involved.
          </p>
        </div>

        <div class="mt-10 rounded-2xl bg-cream-100 p-8 shadow-soft dark:bg-gray-900">
          <h3 class="font-display text-2xl font-semibold text-gray-900 dark:text-white">
            Support a Programme Coordinator
          </h3>

          <p class="mt-4 leading-relaxed text-gray-600 dark:text-gray-400">
            We are seeking funding for a dedicated coordinator
            to help organise and support our teaching activities,
            conversation partnerships and volunteer team.
          </p>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="rounded-lg bg-white p-5 dark:bg-gray-800">
              <h4 class="font-semibold text-gray-900 dark:text-white">
                Teaching Coordination
              </h4>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Organising lessons, schedules and communication
                between teachers and students.
              </p>
            </div>

            <div class="rounded-lg bg-white p-5 dark:bg-gray-800">
              <h4 class="font-semibold text-gray-900 dark:text-white">
                Conversation Partnerships
              </h4>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Supporting the organisation and continuity
                of language conversation opportunities.
              </p>
            </div>

            <div class="rounded-lg bg-white p-5 dark:bg-gray-800">
              <h4 class="font-semibold text-gray-900 dark:text-white">
                Volunteer Support
              </h4>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Helping volunteers understand their roles,
                stay connected and contribute effectively.
              </p>
            </div>

            <div class="rounded-lg bg-white p-5 dark:bg-gray-800">
              <h4 class="font-semibold text-gray-900 dark:text-white">
                Programme Monitoring
              </h4>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Tracking activities, collecting feedback
                and identifying ways to improve delivery.
              </p>
            </div>
          </div>

          <p class="mt-6 text-gray-600 dark:text-gray-400">
            Supporting this role will help reduce the
            administrative burden on our teaching team and
            create a more dependable learning experience
            for students.
          </p>
        </div>

        <div class="mt-8 text-center">
          <a
            href={donationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg bg-accent-500 px-8 py-4 font-medium text-white shadow-lg transition-all hover:bg-accent-600"
          >
            Support Our Programmes
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparency -->
  <section class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Transparency
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          How Your Donation Is Used
        </h2>

        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
          Contributions to this appeal support curriculum
          development and programme coordination.
          Both are essential to sustaining our educational work.
        </p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 font-bold text-white">
            01
          </div>
          <h3 class="font-semibold text-gray-900 dark:text-white">
            You Donate
          </h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            Contribute securely through our fundraising platform.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 font-bold text-white">
            02
          </div>
          <h3 class="font-semibold text-gray-900 dark:text-white">
            We Fund the Work
          </h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            We allocate available funds towards curriculum
            development and programme coordination.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 font-bold text-white">
            03
          </div>
          <h3 class="font-semibold text-gray-900 dark:text-white">
            We Share Progress
          </h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            We report on funded activities, completed
            work and the use of contributions.
          </p>
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-3xl rounded-xl bg-primary-50 p-6 text-gray-700 dark:bg-primary-900/20 dark:text-gray-300">
        <p>
          <strong class="text-primary-700 dark:text-primary-300">
            Our commitment:
          </strong>
          Donations to this campaign will be pooled to
          support curriculum development and programme
          coordination, after applicable payment-processing
          fees. The amounts displayed for curriculum
          development are illustrative budgets, not
          guaranteed costs or separate restricted appeals.
          If funding is insufficient, we may reduce or defer
          planned activities and will communicate material
          changes through campaign updates.
        </p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">
        Help Us Make Free Education More Sustainable
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        From developing one lesson to building an entire
        curriculum, your support helps strengthen the
        educational opportunities we provide.
      </p>

      <a
        href={donationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center rounded-lg bg-white px-8 py-4 font-medium text-primary-700 shadow-lg transition-colors hover:bg-gray-100"
      >
        Make a Donation
      </a>

      <p class="mx-auto mt-8 text-sm text-primary-100">
        Unable to donate? You can also support our work
        through volunteering, professional expertise
        or partnerships.
      </p>

      <a
        href="/partners"
        class="mt-4 inline-flex rounded-lg border border-white/40 px-6 py-3 font-medium text-white transition-colors hover:bg-white/10"
      >
        Explore Partnerships
      </a>
    </div>
  </section>
</Base>
