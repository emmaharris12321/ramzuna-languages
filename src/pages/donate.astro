---
import Base from '@/layouts/Base.astro';

// This is the existing WhyDonate campaign link. Its external campaign
// description must be updated separately to match this page's focus.
const donationUrl =
  'https://whydonate.com/fundraising/support-the-people-behind-free-education-in-palestine';
---

<Base
  title="Donate — Keep Lessons Free"
  description="Help Ramzunā Languages keep English, French and German lessons free and accessible for Palestinian students."
>
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">
        Keep Lessons Free for Palestinian Students
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Help us continue providing free English, French and German
        lessons, so that cost never stands in the way of learning.
      </p>

      <nav
        class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200"
        aria-label="Breadcrumb"
      >
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Donate</span>
      </nav>
    </div>
  </section>

  <!-- Introduction -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Learning Without Barriers
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Every Student Deserves the Chance to Learn
        </h2>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Ramzunā Languages has already delivered hundreds of hours of
          free language instruction to Palestinian students. Our lessons
          create opportunities to build skills, confidence and meaningful
          connections through language learning.
        </p>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          We want these learning opportunities to remain available without
          charging students. Donations help us sustain free classes and
          the resources needed to deliver them.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Single Fundraising Focus -->
  <section class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Our Fundraising Focus
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Keep Lessons Free
        </h2>

        <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Your contribution helps us continue offering free language
          lessons to Palestinian students. Together, we can protect
          access to education and keep learning opportunities open
          to everyone, regardless of their ability to pay.
        </p>

        <div class="mt-10 rounded-2xl bg-white p-8 shadow-soft dark:bg-gray-800 sm:p-10">
          <h3 class="font-display text-2xl font-semibold text-gray-900 dark:text-white">
            Support Free Language Lessons
          </h3>
          <p class="mx-auto mt-4 max-w-xl text-gray-600 dark:text-gray-400">
            Every contribution, whatever its size, helps sustain
            opportunities for students to learn English, French
            and German without tuition fees.
          </p>

          <a
            href={donationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-7 inline-flex items-center justify-center rounded-lg bg-accent-500 px-8 py-4 font-medium text-white shadow-lg transition-all hover:bg-accent-600"
          >
            Help Keep Lessons Free
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparency -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Transparency
        </span>

        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          How Your Donation Helps
        </h2>

        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
          Our fundraising appeal focuses on sustaining free language
          lessons for Palestinian students.
        </p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 font-bold text-white">01</div>
          <h3 class="font-semibold text-gray-900 dark:text-white">You Donate</h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            Contribute securely through our fundraising platform.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 font-bold text-white">02</div>
          <h3 class="font-semibold text-gray-900 dark:text-white">We Support Free Lessons</h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            Your support helps us keep language classes accessible without tuition fees.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 font-bold text-white">03</div>
          <h3 class="font-semibold text-gray-900 dark:text-white">We Share Progress</h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            We share updates on our teaching activities and the use of contributions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">
        Help Keep Education Free
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Your gift helps make free language lessons available to
        Palestinian students for longer.
      </p>

      <a
        href={donationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center rounded-lg bg-white px-8 py-4 font-medium text-primary-700 shadow-lg transition-colors hover:bg-gray-100"
      >
        Make a Donation
      </a>

      <p class="mx-auto mt-8 text-sm text-primary-100">
        Unable to donate? You can also support our work through
        volunteering, professional expertise or partnerships.
      </p>

      <a
        href="/partners"
        class="mt-4 inline-flex rounded-lg border border-white/40 px-6 py-3 font-medium text-white transition-colors hover:bg-white/10"
      >
        Explore Partnerships
      </a>
    </div>
  </section>
</Base>
