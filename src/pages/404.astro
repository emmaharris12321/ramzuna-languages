---
import Base from '@/layouts/Base.astro';
---

<Base title="Page Not Found">
  <section class="flex min-h-[60vh] items-center justify-center py-20 lg:py-28">
    <div class="mx-auto max-w-lg px-4 text-center lg:px-8">
      <div class="text-8xl font-bold text-primary-500/20 lg:text-9xl">404</div>
      <h1 class="font-display mt-4 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
        Page Not Found
      </h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
        Sorry, the page you are looking for does not exist or has been moved.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-primary-600 px-6 py-3 text-sm font-medium text-white shadow-lg shadow-primary-600/25 transition-all hover:bg-primary-700 hover:shadow-xl hover:shadow-primary-600/30"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Go Home
      </a>
    </div>
  </section>
</Base>
