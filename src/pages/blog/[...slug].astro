---
import { getCollection, render } from 'astro:content';
import BlogPost from '@/layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const sameCategory = allPosts.filter((p) => p.id !== post.id && p.data.category === post.data.category);
const others = allPosts.filter((p) => p.id !== post.id && p.data.category !== post.data.category);
const relatedPosts = [...sameCategory, ...others].slice(0, 3);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  category={post.data.category}
  image={post.data.image}
  readTime={post.data.readTime}
  author={post.data.author}
  relatedPosts={relatedPosts}
>
  <Content />
</BlogPost>
