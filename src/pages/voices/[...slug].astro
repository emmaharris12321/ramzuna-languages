---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';

export async function getStaticPaths() {
  const poems = await getCollection('voices', ({ data }) => !data.draft);
  return poems.map((poem) => ({
    params: { slug: poem.id },
    props: { poem, allPoems: poems },
  }));
}

const { poem, allPoems } = Astro.props;
const { Content } = await render(poem);

const moreByAuthor = allPoems.filter((p) => p.id !== poem.id && p.data.author === poem.data.author);
const others = allPoems.filter((p) => p.id !== poem.id && p.data.author !== poem.data.author);
const related = [...moreByAuthor, ...others].slice(0, 3);
---

<style>
  /* Dot-texture on the fallback hero for a bit of warmth instead of a flat block */
  .poem-hero {
    position: relative;
    background-image: radial-gradient(rgba(255, 255, 255, 0.16) 1.5px, transparent 1.5px);
    background-size: 20px 20px;
  }

  /* Highlighted pull-quote block */
  .poem-quote-card {
    position: relative;
    border-radius: 1.5rem;
    background: #f7e9ea;
    padding: 2.25rem 1.75rem;
    text-align: center;
  }

  :global(.dark) .poem-quote-card {
    background: rgba(122, 34, 43, 0.18);
  }

  .poem-quote-glyph {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3.5rem;
    line-height: 0.5;
    color: rgba(122, 34, 43, 0.35);
    margin-bottom: 0.5rem;
  }

  :global(.dark) .poem-quote-glyph {
    color: rgba(224, 148, 156, 0.5);
  }

  /* The reading room: warm textured paper, like the pages people actually
     post — never a flat white page */
  .poem-surface {
    position: relative;
    background:
      radial-gradient(ellipse 70% 50% at 12% 8%, rgba(122, 34, 43, 0.07), transparent 55%),
      radial-gradient(ellipse 60% 45% at 90% 95%, rgba(56, 102, 79, 0.08), transparent 55%),
      linear-gradient(180deg, #f2e6ce 0%, #efe0c6 45%, #ecdcc0 100%);
    overflow: hidden;
  }

  :global(.dark) .poem-surface {
    background:
      radial-gradient(ellipse 70% 50% at 12% 8%, rgba(224, 148, 156, 0.06), transparent 55%),
      radial-gradient(ellipse 60% 45% at 90% 95%, rgba(56, 102, 79, 0.1), transparent 55%),
      linear-gradient(180deg, #1c1712 0%, #171310 100%);
  }

  /* Fine paper grain so the warm tone doesn't read as a flat gradient */
  .poem-surface::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image: radial-gradient(rgba(90, 66, 40, 0.09) 1px, transparent 1px);
    background-size: 3px 3px;
    pointer-events: none;
  }

  :global(.dark) .poem-surface::before {
    opacity: 0.35;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
  }

  /* Decorative corner flourishes, echoing the hand-designed poem cards */
  .poem-flourish {
    position: absolute;
    width: 92px;
    height: 92px;
    color: #7a222b;
    opacity: 0.28;
    pointer-events: none;
    z-index: 0;
  }

  :global(.dark) .poem-flourish {
    color: #e0949c;
    opacity: 0.22;
  }

  .poem-flourish--tl { top: 0.5rem; left: 0.5rem; }
  .poem-flourish--br { bottom: 0.5rem; right: 0.5rem; transform: rotate(180deg); }

  @media (min-width: 640px) {
    .poem-flourish { width: 128px; height: 128px; }
  }

  .poem-frame {
    position: relative;
    z-index: 1;
  }

  /* The poem itself: four unhurried passages, not sixteen little boxes and
     not one unbroken wall of text */
  .poem-groups {
    display: flex;
    flex-direction: column;
  }

  .poem-content :global(.poem-block) {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.1875rem;
    line-height: 1.95;
    color: #43362a;
    text-align: center;
    max-width: 34rem;
    margin: 0 auto;
  }

  :global(.dark) .poem-content :global(.poem-block) {
    color: #e7ddcf;
  }

  .poem-content :global(.poem-block p) {
    margin: 0;
  }

  .poem-content :global(.poem-block p + p) {
    margin-top: 1.1rem;
  }

  /* A small hand-drawn-feeling divider between passages, instead of a card edge */
  .poem-content :global(.poem-block + .poem-block) {
    margin-top: 2.75rem;
    padding-top: 2.75rem;
    position: relative;
  }

  .poem-content :global(.poem-block + .poem-block)::before {
    content: '❧';
    position: absolute;
    top: -0.15rem;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.1rem;
    color: #7a222b;
    opacity: 0.55;
  }

  :global(.dark) .poem-content :global(.poem-block + .poem-block)::before {
    color: #e0949c;
  }

  /* Arabic original — collapsed by default so the page doesn't dump
     two full poems on the reader at once */
  .poem-content :global(.poem-original) {
    margin-top: 3rem;
    text-align: center;
  }

  .poem-content :global(.poem-original summary) {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    background: rgba(122, 34, 43, 0.09);
    padding: 0.6rem 1.25rem;
    color: #7a222b;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
  }

  :global(.dark) .poem-content :global(.poem-original summary) {
    background: rgba(224, 148, 156, 0.12);
    color: #e0949c;
  }

  .poem-content :global(.poem-original summary)::-webkit-details-marker {
    display: none;
  }

  .poem-content :global(.poem-original summary)::after {
    content: '\25BE';
  }

  .poem-content :global(.poem-original[open] summary)::after {
    content: '\25B4';
  }

  .poem-content :global(.poem-original .poem-groups) {
    margin-top: 2rem;
    text-align: right;
  }

  .poem-content :global(.poem-groups-ar .poem-block) {
    font-size: 1.375rem;
    line-height: 2.1;
  }

  /* Cover-image hero, for poems that have their own designed graphic */
  .poem-cover {
    position: relative;
    display: block;
    width: 100%;
    max-height: 80vh;
    object-fit: cover;
    object-position: center 30%;
  }

  .poem-cover-bar {
    background: #2a2622;
  }
</style>

<Base title={`${poem.data.title} — ${poem.data.author}`} description={`${poem.data.tag} by ${poem.data.author}, published by Ramzunā Languages as part of Palestinian Voices.`}>
  <!-- Header -->
  {poem.data.coverImage ? (
    <section class="poem-cover-bar relative">
      <img
        src={poem.data.coverImage}
        alt={`Cover art for "${poem.data.title}" by ${poem.data.author}, published by Ramzunā Languages`}
        class="poem-cover"
      />
      <nav class="flex flex-wrap items-center justify-center gap-2 bg-black/40 py-3 text-sm text-white/80" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/palestinian-voices" class="transition-colors hover:text-white">Palestinian Voices</a>
        <span>/</span>
        <span class="text-white">{poem.data.title}</span>
      </nav>
    </section>
  ) : (
    <section class="poem-hero bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
      <div class="container mx-auto px-4 text-center lg:px-8">
        <span class="inline-flex items-center rounded-full bg-white/15 px-3 py-1 text-xs font-medium uppercase tracking-wider text-primary-100">
          {poem.data.tag} &middot; {poem.data.author}{poem.data.readTime && <> &middot; {poem.data.readTime}</>}
        </span>
        <h1 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">{poem.data.title}</h1>
        {poem.data.arabicTitle && (
          <p dir="rtl" lang="ar" class="mx-auto mt-3 font-display text-xl text-primary-100">{poem.data.arabicTitle}</p>
        )}
        <nav class="mt-6 flex flex-wrap items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-white">Home</a>
          <span>/</span>
          <a href="/palestinian-voices" class="transition-colors hover:text-white">Palestinian Voices</a>
          <span>/</span>
          <span class="text-white">{poem.data.title}</span>
        </nav>
      </div>
    </section>
  )}

  <article>
    <!-- Author + pull quote -->
    <div class="bg-cream-100 py-14 lg:py-20 dark:bg-gray-900/40">
      <div class="container mx-auto px-4 lg:px-8">
        <div class="mx-auto max-w-xl">
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-primary-600 font-display text-xl font-semibold text-white shadow-sm">
              {poem.data.author.charAt(0)}
            </div>
            <div>
              <p class="font-semibold text-gray-900 dark:text-white">{poem.data.author}</p>
              {poem.data.bio && <p class="mt-0.5 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{poem.data.bio}</p>}
            </div>
          </div>

          {poem.data.excerpt && (
            <div class="poem-quote-card mt-8">
              <span class="poem-quote-glyph" aria-hidden="true">&ldquo;</span>
              <p class="font-display text-xl italic leading-snug text-accent-800 sm:text-2xl dark:text-accent-200">
                {poem.data.excerpt}
              </p>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Poem Content -->
    <div class="poem-surface py-16 lg:py-24">
      <svg class="poem-flourish poem-flourish--tl" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6 C 30 8, 34 32, 58 34" />
        <path d="M6 6 C 8 30, 32 34, 34 58" />
        <path d="M20 14 C 26 20, 24 28, 30 32" />
        <circle cx="58" cy="34" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="34" cy="58" r="3.2" fill="currentColor" stroke="none" />
        <path d="M46 12 c 4 4, 4 10, -2 12 c -6 -2, -6 -8, 2 -12 Z" />
      </svg>
      <svg class="poem-flourish poem-flourish--br" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6 C 30 8, 34 32, 58 34" />
        <path d="M6 6 C 8 30, 32 34, 34 58" />
        <path d="M20 14 C 26 20, 24 28, 30 32" />
        <circle cx="58" cy="34" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="34" cy="58" r="3.2" fill="currentColor" stroke="none" />
        <path d="M46 12 c 4 4, 4 10, -2 12 c -6 -2, -6 -8, 2 -12 Z" />
      </svg>
      <div class="poem-frame container mx-auto px-4 lg:px-8">
        <div class="poem-content mx-auto max-w-xl">
          <Content />
        </div>
      </div>
    </div>

    <!-- Back link -->
    <div class="poem-surface pb-16">
      <div class="container mx-auto px-4 text-center lg:px-8">
        <a href="/palestinian-voices" class="inline-flex items-center gap-2 text-sm font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Palestinian Voices
        </a>
      </div>
    </div>
  </article>

  <!-- More Voices -->
  {related.length > 0 && (
    <div class="bg-cream-100 py-16 lg:py-20 dark:bg-gray-900/50">
      <div class="container mx-auto px-4 lg:px-8">
        <div class="mx-auto max-w-5xl">
          <h2 class="font-display text-2xl font-semibold text-gray-900 dark:text-white">More from Palestinian Voices</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((rp) => (
              <a href={`/voices/${rp.id}`} class="group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 transition-all hover:shadow-lg dark:bg-gray-900 dark:ring-gray-800">
                <span class="text-xs font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400">{rp.data.tag}</span>
                <h3 class="mt-2 text-base font-bold text-gray-900 transition-colors group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">{rp.data.title}</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">by {rp.data.author}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Have something to share?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        If you are a Palestinian writer with a poem, story, or letter you would like included here, we would love to hear from you.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="mailto:contacteam@ramzunalanguages.org" class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-medium text-primary-600 shadow-lg transition-all hover:bg-gray-100">
          Submit Your Writing
        </a>
        <a href="/palestinian-voices" class="inline-flex items-center justify-center rounded-lg border border-white/30 px-6 py-3 text-sm font-medium text-white transition-all hover:bg-white/10">
          Back to Palestinian Voices
        </a>
      </div>
    </div>
  </section>
</Base>
