---
import Base from '@/layouts/Base.astro';

const cards = [
  {
    icon: 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
    tone: 'primary',
    title: 'German learning path',
    description: 'Self-paced beginner German from the open Grenzenlos Deutsch curriculum, with audio and interactive exercises for use between live sessions.',
    cta: 'Start Learning German',
    href: '/resources/german-async',
  },
  {
    icon: 'M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.5-2.4 3.75-5.4 3.75-9S14.5 5.4 12 3m0 18c-2.5-2.4-3.75-5.4-3.75-9S9.5 5.4 12 3M3.6 9h16.8M3.6 15h16.8',
    tone: 'accent',
    title: 'Language Resources',
    description: 'A curated directory of free resources to study and teach English, French and German — including IELTS preparation.',
    cta: 'Explore Language Resources',
    href: '/resources/language-resources',
  },
  {
    icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
    tone: 'primary',
    title: 'Mental Health Resources for Palestinians',
    description: 'Free and low-cost mental health and psychosocial support resources for Palestinians affected by displacement, loss and war.',
    cta: 'Find Support',
    href: '/resources/mental-health-resources',
  },
  {
    icon: 'M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z',
    tone: 'accent',
    title: 'Palestinian Voices',
    description: 'Read poetry and prose from Palestinian writers, and discover Palestinian voices, stories and art.',
    cta: 'Discover Palestinian Voices',
    href: '/palestinian-voices',
  },
  {
    icon: 'M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342',
    tone: 'primary',
    title: 'Palestine & Arabic Resources',
    description: 'A curated collection of resources to learn about Palestinian history and culture, and to pick up some Arabic along the way.',
    cta: 'Explore These Resources',
    href: '/resources/learning-about-palestine',
  },
];
---

<Base title="Resources" description="A curated collection of language-learning resources and Palestinian voices, shared by Ramzunā Languages.">
  <!-- Page Header -->
  <section class="page-hero py-16 lg:py-24">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Resources</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Free tools, channels and voices to support students, teachers and anyone learning alongside us.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Resources</span>
      </nav>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Learn More
        </div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">Resources</h2>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          cards.map((card) => (
            <div class="flex flex-col rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-md dark:border-gray-700 dark:bg-gray-800">
              <div
                class:list={[
                  'mb-4 flex h-11 w-11 items-center justify-center rounded-lg',
                  card.tone === 'primary'
                    ? 'bg-primary-100 dark:bg-primary-900/50'
                    : 'bg-accent-100 dark:bg-accent-900/50',
                ]}
              >
                <svg class:list={['h-5 w-5', card.tone === 'primary' ? 'text-primary-600 dark:text-primary-300' : 'text-accent-600 dark:text-accent-300']} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={card.icon} /></svg>
              </div>
              <h3 class="text-base font-semibold text-gray-900 dark:text-white">
                {card.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{card.description}</p>
              <a
                href={card.href}
                class:list={[
                  'mt-5 inline-flex w-fit items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium text-white transition-colors',
                  card.tone === 'primary' ? 'bg-primary-600 hover:bg-primary-700' : 'bg-accent-600 hover:bg-accent-700',
                ]}
              >
                {card.cta} <span aria-hidden="true">→</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
