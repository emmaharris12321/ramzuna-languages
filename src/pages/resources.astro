---
import Base from '@/layouts/Base.astro';

const cards = [
  {
    icon: 'DE',
    tone: 'primary',
    title: 'German learning path',
    description: 'Self-paced beginner German from the open Grenzenlos Deutsch curriculum, with audio and interactive exercises for use between live sessions.',
    cta: 'Start Learning German',
    href: '/resources/german-async',
  },
  {
    icon: 'Aa',
    tone: 'accent',
    title: 'Language Resources',
    description: 'A curated directory of free resources to study and teach English, French and German — including IELTS preparation.',
    cta: 'Explore Language Resources',
    href: '/resources/language-resources',
  },
  {
    icon: '+',
    tone: 'primary',
    title: 'Mental Health Resources for Palestinians',
    description: 'Free and low-cost mental health and psychosocial support resources for Palestinians affected by displacement, loss and war.',
    cta: 'Find Support',
    href: '/resources/mental-health-resources',
  },
  {
    icon: 'PS',
    tone: 'accent',
    title: 'Palestinian Voices',
    description: 'Read poetry and prose from Palestinian writers, and discover Palestinian voices, stories and art.',
    cta: 'Discover Palestinian Voices',
    href: '/palestinian-voices',
  },
  {
    icon: 'AR',
    tone: 'primary',
    title: 'Palestine & Arabic Resources',
    description: 'A curated collection of resources to learn about Palestinian history and culture, and to pick up some Arabic along the way.',
    cta: 'Explore These Resources',
    href: '/resources/learning-about-palestine',
  },
];
---

<Base title="Resources" description="A curated collection of language-learning resources and Palestinian voices, shared by Ramzunā Languages.">
  <!-- Page Header -->
  <section class="page-hero py-16 lg:py-24">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Resources</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Free tools, channels and voices to support students, teachers and anyone learning alongside us.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Resources</span>
      </nav>
    </div>
  </section>

  <section class="collection-shell">
    <div class="collection-intro">
      <div><p class="collection-eyebrow">The resource library</p><h2>Find what you need</h2><p>Browse learning materials, discover Palestinian writing, or find support.</p></div>
    </div>
    {[
      { title: 'Language learning', items: cards.slice(0, 2) },
      { title: 'Palestinian voices & culture', items: cards.slice(3) },
      { title: 'Wellbeing & support', items: cards.slice(2, 3) },
    ].map(category => (
      <section class="resource-category">
        <h2>{category.title}</h2>
        <div class="resource-grid">
          {category.items.map(card => (
            <article class="resource-card collection-panel">
              <h3>{card.title}</h3><p>{card.description}</p>
              <a href={card.href}>{card.cta} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
</Base>
