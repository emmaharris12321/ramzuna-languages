---
import Base from '@/layouts/Base.astro';

const waysToPartner = [
  {
    title: 'Schools & Universities',
    description: 'Create service-learning or volunteer pipelines for students and staff, and offer meaningful cross-cultural exchange opportunities.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 0 0-.491 6.347A48.627 48.627 0 0 1 12 20.904a48.627 48.627 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.57 50.57 0 0 0-2.658-.813A59.905 59.905 0 0 1 12 3.493a59.902 59.902 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443" />',
  },
  {
    title: 'NGOs & Nonprofits',
    description: 'Collaborate on shared programmes, cross-refer students and volunteers, or pool training and resources so we can reach further together.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />',
  },
  {
    title: 'In-Kind & Media Support',
    description: 'Contribute technology, translation, design, or hosting, or help amplify our work to reach more students and volunteers.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />',
  },
];

const reasons = [
  {
    title: 'Direct, measurable impact',
    description: 'Every partnership translates into real lessons, for real students, at zero cost to them. We report back on exactly what your support makes possible.',
  },
  {
    title: 'Aligned with global goals',
    description: 'Our work advances UN Sustainable Development Goal 4 (Quality Education), 10 (Reduced Inequalities), and 16 (Peace, Justice and Strong Institutions).',
  },
  {
    title: 'A vetted, global network',
    description: 'We already coordinate volunteer educators from 15+ countries and a dedicated core team, ready to put a partnership into action.',
  },
  {
    title: 'Flexible collaboration',
    description: 'From a one-off donation to an ongoing, co-branded programme, we shape every partnership around what works for both your organisation and ours.',
  },
];
---

<Base title="Partner With Us" description="Partner with Ramzunā Languages to expand free language education for Palestinian students.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Partner With Us</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Join schools and nonprofits helping us expand free language education for Palestinian students.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-white">Partner With Us</span>
      </nav>
    </div>
  </section>

  <!-- Impact stats -->
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">Why Partner With Us</div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          A cause worth <em class="not-italic text-primary-600 dark:text-primary-400">standing behind</em>
        </h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
          Language access is a lifeline for Palestinian students facing displacement and disrupted education. Your organisation can help us reach more students.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-2xl gap-8 sm:grid-cols-3">
        <div class="rounded-2xl bg-cream-100 p-8 text-center shadow-sm dark:bg-gray-900">
          <div class="text-4xl font-bold text-primary-600 dark:text-primary-400">712+</div>
          <div class="mt-2 text-sm font-medium text-gray-600 dark:text-gray-400">Hours Delivered</div>
        </div>
        <div class="rounded-2xl bg-cream-100 p-8 text-center shadow-sm dark:bg-gray-900">
          <div class="text-4xl font-bold text-primary-600 dark:text-primary-400">480</div>
          <div class="mt-2 text-sm font-medium text-gray-600 dark:text-gray-400">Lessons Delivered</div>
        </div>
        <div class="rounded-2xl bg-cream-100 p-8 text-center shadow-sm dark:bg-gray-900">
          <div class="text-4xl font-bold text-primary-600 dark:text-primary-400">15+</div>
          <div class="mt-2 text-sm font-medium text-gray-600 dark:text-gray-400">Countries Represented</div>
        </div>
      </div>

      <div class="mx-auto mt-16 grid max-w-4xl gap-8 sm:grid-cols-2">
        {
          reasons.map((reason) => (
            <div class="rounded-2xl border-t-4 border-accent-500 bg-white p-6 shadow-sm dark:bg-gray-800">
              <h3 class="font-semibold text-gray-900 dark:text-white">{reason.title}</h3>
              <p class="mt-2 text-gray-600 dark:text-gray-400">{reason.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Ways to Partner -->
  <section class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">Ways to Partner</div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">Find the right fit for your organisation</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Every partnership looks different — here are a few ways organisations work with us.</p>
      </div>
      <div class="mx-auto mt-16 grid max-w-5xl gap-8 sm:grid-cols-3">
        {
          waysToPartner.map((way) => (
            <div class="rounded-2xl bg-white p-8 shadow-sm dark:bg-gray-800">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-primary-600 dark:bg-primary-900/50 dark:text-primary-400">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={way.icon} />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{way.title}</h3>
              <p class="mt-3 text-gray-600 dark:text-gray-400">{way.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Let&rsquo;s Start the Conversation</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Tell us about your organisation and what you have in mind — we will get back to you to explore how we can work together.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact" class="inline-flex items-center justify-center rounded-lg bg-white px-8 py-3 font-medium text-primary-600 shadow-lg transition-colors hover:bg-gray-100">
          Contact Us
        </a>
        <a href="mailto:contacteam@ramzunalanguages.org" class="inline-flex items-center justify-center rounded-lg border-2 border-white/30 px-8 py-3 font-medium text-white transition-colors hover:bg-white/10">
          Email the Team
        </a>
      </div>
    </div>
  </section>
</Base>
