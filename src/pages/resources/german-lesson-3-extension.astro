.lesson-two{--ink:#243d35;--muted:#58665d;--paper:#fffdf8;--line:#dce1d6;background:#f7f6ee;color:var(--ink);padding-bottom:70px}.wrap{width:min(960px,calc(100% - 40px));margin:auto}.lesson-hero{background:#edf0e4;padding:30px 0 48px}.back{display:inline-block;margin-bottom:35px;font-size:.85rem}.eyebrow{font-size:.68rem;letter-spacing:.14em;font-weight:700;margin-bottom:12px}h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(2.5rem,5vw,3.8rem);line-height:1.15;letter-spacing:-.035em}h1 em{color:#567047}.intro{font-size:1.1rem;margin-top:22px}.context{font-size:.85rem;max-width:680px;margin-top:16px;color:var(--muted)}nav{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}nav a{border:1px solid #aab89d;border-radius:30px;padding:10px 18px;font-size:.8rem;background:var(--paper)}.lesson-body section{padding-top:48px;scroll-margin-top:90px}h2{font-family:'Playfair Display',Georgia,serif;font-size:2rem;margin-bottom:16px}p{line-height:1.7}section>p{color:var(--muted)}a:hover{text-decoration:underline}p a,.source a{text-decoration:underline;text-underline-offset:3px}.video{aspect-ratio:16/9;background:#17261c;border-radius:18px;overflow:hidden;margin:24px 0 12px}.video iframe{width:100%;height:100%;border:0}.small{font-size:.78rem}.word-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px}.word-grid li{padding:20px;background:var(--paper);border:1px solid var(--line);border-radius:12px}.word-grid li>span{font-size:.7rem;color:var(--muted)}.word-grid h3{font-size:1.05rem;font-weight:600;margin:8px 0 3px}.word-grid p{font-size:.85rem;color:var(--muted)}.subheading{font-weight:600;font-size:1.25rem;margin:30px 0 16px}.numbers{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.numbers li{display:flex;gap:12px;background:var(--paper);padding:12px;border-radius:8px;font-size:.85rem}.numbers span{min-width:22px;color:var(--muted)}.tip{background:#e9eddf;border-left:3px solid #738959;padding:18px 22px;margin:24px 0;font-size:.85re