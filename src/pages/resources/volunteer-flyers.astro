---
import Base from '@/layouts/Base.astro';

interface Flyer {
  title: string;
  tagline: string;
  description: string;
  image: string;
  thumb: string;
  file: string;
  tone: 'primary' | 'accent';
}

const flyers: Flyer[] = [
  {
    title: 'Volunteer as a Conversation Partner',
    tagline: 'Talk. Inspire. Empower.',
    description: 'Share this flyer with friends, colleagues, or on social media to help us find volunteers who can offer 60 minutes of conversation practice a week — no teaching experience needed.',
    image: '/assets/flyers/flyer-conversation-partner.jpg',
    thumb: '/assets/flyers/flyer-conversation-partner-thumb.jpg',
    file: 'ramzuna-volunteer-conversation-partner.jpg',
    tone: 'accent',
  },
  {
    title: 'Volunteer as a Language Teacher',
    tagline: 'Teach. Inspire. Empower.',
    description: 'Share this flyer to help us reach qualified volunteers ready to teach English, French, or German to Palestinian students, remotely, for just 90 minutes a week.',
    image: '/assets/flyers/flyer-language-teacher.jpg',
    thumb: '/assets/flyers/flyer-language-teacher-thumb.jpg',
    file: 'ramzuna-volunteer-language-teacher.jpg',
    tone: 'primary',
  },
];
---

<Base title="Volunteer Flyers" description="Download and share our recruitment flyers to help spread the word about volunteering with Ramzunā Languages.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Volunteer Flyers</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Download these flyers and share them with your network, on social media, or on a noticeboard, to help us find more volunteers.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/resources" class="transition-colors hover:text-white">Resources</a>
        <span>/</span>
        <span class="text-white">Volunteer Flyers</span>
      </nav>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-xl text-center">
        <div class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
          Help Us Spread the Word
        </div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Ready-Made Flyers to Share
        </h2>
        <p class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Every new volunteer starts with someone sharing the word. Download these flyers to post, print, or share wherever you think the right person might see them.
        </p>
      </div>

      <div class="mx-auto mt-16 grid max-w-4xl gap-10 sm:grid-cols-2">
        {
          flyers.map((flyer) => (
            <div class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm dark:bg-gray-800">
              <div class="overflow-hidden bg-cream-100 dark:bg-gray-900">
                <img
                  src={flyer.image}
                  alt={`${flyer.title} — recruitment flyer`}
                  class="h-auto w-full object-contain"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-1 flex-col p-6 sm:p-8">
                <span
                  class:list={[
                    'mb-2 inline-flex w-fit items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
                    flyer.tone === 'primary'
                      ? 'bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300'
                      : 'bg-accent-100 text-accent-700 dark:bg-accent-900/50 dark:text-accent-300',
                  ]}
                >
                  {flyer.tagline}
                </span>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{flyer.title}</h3>
                <p class="mt-2 flex-1 text-gray-600 dark:text-gray-400">{flyer.description}</p>
                <div
                  class:list={[
                    'mt-6 flex items-start gap-3 rounded-xl p-4 text-sm',
                    flyer.tone === 'primary'
                      ? 'bg-primary-50 text-primary-800 dark:bg-primary-900/30 dark:text-primary-200'
                      : 'bg-accent-50 text-accent-800 dark:bg-accent-900/30 dark:text-accent-200',
                  ]}
                >
                  <svg class="mt-0.5 h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  <p>
                    To save: right-click the flyer above and choose &ldquo;Save Image As&rdquo; (on a phone or tablet, press and hold it, then choose &ldquo;Save Image&rdquo; or &ldquo;Download Image&rdquo;).
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mx-auto mt-14 max-w-2xl rounded-2xl border border-dashed border-gray-300 bg-cream-100 p-8 text-center dark:border-gray-700 dark:bg-gray-900">
        <p class="font-medium text-gray-900 dark:text-white">Want a flyer for something else?</p>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
          If you would like a flyer for a specific event, campus, or community group, <a href="/contact" class="font-medium text-accent-600 underline decoration-accent-300 underline-offset-2 hover:text-accent-700 dark:text-accent-400">get in touch</a> and we will happily put one together.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Ready to Volunteer Yourself?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">Teach a language or become a conversation partner — either way, you can make a real difference.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/teach-with-us" class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-medium text-primary-600 shadow-lg transition-all hover:bg-gray-100">
          Teach with Us
        </a>
        <a href="/become-a-conversation-partner" class="inline-flex items-center justify-center rounded-lg border border-white/30 px-6 py-3 text-sm font-medium text-white transition-all hover:bg-white/10">
          Become a Conversation Partner
        </a>
      </div>
    </div>
  </section>
</Base>
