---
import Base from '@/layouts/Base.astro';
import PdfResources from '@/components/PdfResources.astro';
import '@/styles/german-lesson-five.css';
// Adapted from Grenzenlos Deutsch, Einheit 1, Lektion 8: Personen beschreiben.
// The user supplied the MP4 interview and two M4A audio URLs.
// No audio or video is locally bundled; browsers load it from its original host.
const descriptions = [
  {name:'Yasmin',image:'/assets/german/img/Yasmin-223x300.png',audio:'https://grenzenlos-deutsch.com/familie/wp-content/uploads/AUD_Familie_Einheit1_Lektion8_Yasmin.m4a',who:'Timo',text:'Mein Freund Timo ist dreiundzwanzig Jahre alt. Er studiert Literatur und wohnt in München. Er ist klein, schlank und sportlich. Er hat blonde Haare und braune Augen. Ich finde ihn freundlich und sympathisch.',translation:'Yasmin describes her friend Timo, a literature student in Munich. He is short, slim and athletic, with blond hair and brown eyes.'},
  {name:'Max',image:'/assets/german/img/Max.pgn_-211x300.png',audio:'https://grenzenlos-deutsch.com/familie/wp-content/uploads/AUD_Familie_Einheit1_Lektion8_Max.m4a',who:'Meike',text:'Meine Freundin Meike ist groß. Sie hat braune Haare und blaue Augen. Sie reist gern und macht interessante Fotos. Ich finde sie kreativ, lustig, intelligent und motiviert.',translation:'Max describes his friend Meike, who is tall, travels widely, takes interesting photos and has a lively personality.'}
];
const qualities = [
  ['groß','tall'],['klein','short'],['schlank','slim'],['sportlich','sporty'],
  ['jung','young'],['freundlich','friendly'],['sympathisch','likeable'],
  ['lustig','funny'],['intelligent','intelligent'],['kreativ','creative'],
  ['motiviert','motivated'],['blond','blond'],['braun','brown'],['blau','blue']
];
---
<Base title="German Lesson 8: Personen beschreiben | Reading, audio and video" description="Describe friends and family in German with recordings from Yasmin and Max, an interview video, grammar review, speaking practice and printable PDF.">
  <link rel="stylesheet" href="/assets/german/lesson-eight.css" />
  <div class="lesson-five lesson-eight">
    <header class="lesson-hero"><div class="wrap"><a class="back" href="/resources/german-async#e1">← Back to your learning path</a><p class="eyebrow">UNIT 01 · LESSON 08 · MAIN LESSON</p><h1 lang="de">Personen <em>beschreiben.</em></h1><p class="intro">Describe people’s appearance and personality. Read and listen to Yasmin and Max, then practise speaking and possessive adjectives.</p><p class="context">Following <a href="https://grenzenlos-deutsch.com/familie/e1/l8/">Grenzenlos Deutsch, Lektion 8</a>, this page uses the lesson’s reading → speaking → listening → grammar structure. You supplied the media URLs; the recordings remain hosted by the original course.</p><nav class="step-nav" aria-label="Lesson sections"><a href="#read">01 Reading</a><a href="#speak">02 Speaking</a><a href="#listen">03 Listening</a><a href="#structures">04 Grammar</a><a href="#study-resources">05 PDF</a></nav></div></header>
    <div class="wrap lesson-body">
      <section id="read" aria-labelledby="read-title"><p class="eyebrow">01 / LESEN UND HÖREN</p><h2 id="read-title">Meet Timo and Meike.</h2><p>First read the adapted German profile. Then listen to the full original recording of the person describing their friend. The text below is a simplified adaptation, not a verbatim transcript of the recording.</p>
        <div class="profiles">{descriptions.map((person) => <article class="profile"><img src={person.image} alt={`Portrait of ${person.name} from the original course`} loading="lazy" width="211" height="300"/><div class="profile-text"><p class="profile-eyebrow">{person.name} describes {person.who}</p><h3>{person.name} <span aria-hidden="true">→</span> {person.who}</h3><p lang="de">{person.text}</p><p class="translation">{person.translation}</p><audio controls preload="none" src={person.audio} aria-label={`Listen to ${person.name} describing ${person.who}`}>Audio playback is not supported in this browser.</audio><a class="audio-link" href={person.audio} target="_blank" rel="noopener noreferrer">Open original {person.name} audio</a></div></article>)}</div>
        <h3 class="subheading">Vocabulary for describing people</h3><div class="qualities">{qualities.map(([de,en]) => <div><strong lang="de">{de}</strong><span>{en}</span></div>)}</div>
        <h3 class="subheading">Reading comprehension</h3><form class="auto-quiz quiz-form">
          <fieldset data-answer="Timo"><legend>01 · Wer studiert Literatur?</legend><div class="choices"><label><input type="radio" name="q1" value="Timo"/> Timo</label><label><input type="radio" name="q1" value="Meike"/> Meike</label></div><p class="feedback" aria-live="polite"></p></fieldset>
          <fieldset data-answer="Meike"><legend>02 · Wer reist gern und fotografiert?</legend><div class="choices"><label><input type="radio" name="q2" value="Timo"/> Timo</label><label><input type="radio" name="q2" value="Meike"/> Meike</label></div><p class="feedback" aria-live="polite"></p></fieldset>
          <fieldset data-answer="braun"><legend>03 · Welche Augenfarbe hat Timo?</legend><div class="choices"><label><input type="radio" name="q3" value="braun"/> braun</label><label><input type="radio" name="q3" value="blau"/> blau</label></div><p class="feedback" aria-live="polite"></p></fieldset>
          <fieldset data-answer="blau"><legend>04 · Welche Augenfarbe hat Meike?</legend><div class="choices"><label><input type="radio" name="q4" value="grün"/> grün</label><label><input type="radio" name="q4" value="blau"/> blau</label></div><p class="feedback" aria-live="polite"></p></fieldset>
          <div class="quiz-actions"><button type="submit">Check answers</button><button type="reset" class="secondary">Try again</button></div><p class="quiz-score" role="status"></p>
        </form>
      </section>
      <section id="speak" aria-labelledby="speak-title"><p class="eyebrow">02 / SPRECHEN</p><h2 id="speak-title">Describe someone and let a partner guess.</h2><p>Take turns describing someone you both know—or someone from a photograph—without saying the name. Start with appearance and add personality.</p><div class="dialogue"><p lang="de">Die Person ist groß und hat braune Haare.</p><p lang="de">Sie hat blaue Augen. Sie ist kreativ und lustig.</p><p lang="de">Wer ist das?</p></div><ol class="speaking"><li><strong lang="de">Wie sieht die Person aus?</strong><span>Describe height, hair and eyes.</span></li><li><strong lang="de">Wie ist die Person?</strong><span>Describe personality with two adjectives.</span></li><li><strong lang="de">Wer ist die Person?</strong><span>Let your partner guess, then exchange roles.</span></li></ol></section>
      <section id="listen" aria-labelledby="listen-title"><p class="eyebrow">03 / HÖREN</p><h2 id="listen-title">Listen to the video interviews.</h2><p>Play the original Lesson 8 video. On a first listen, identify words about appearance. On a second listen, note words about personality.</p><div class="video"><video controls preload="none" playsinline aria-label="Grenzenlos Deutsch, Unit 1 Lesson 8 interview video"><source src="https://grenzenlos-deutsch.com/familie/wp-content/uploads/familie_video/VID_Familie_Unit-1_Lesson-8.mp4?_=1" type="video/mp4"/>This browser cannot play the supplied video.</video></div><p class="small">This video is streamed from Grenzenlos Deutsch and requires internet access. If it cannot play here, <a href="https://grenzenlos-deutsch.com/familie/wp-content/uploads/familie_video/VID_Familie_Unit-1_Lesson-8.mp4?_=1" target="_blank" rel="noopener noreferrer">open the original MP4 directly</a>. The source host may restrict third-party streaming.</p><h3 class="subheading">After listening</h3><ol class="speaking"><li><strong lang="de">Rollenspiel.</strong><span>Describe someone as if you were one of the interviewees in the film.</span></li><li><strong lang="de">Beschreiben Sie eine Person, die Sie kennen!</strong><span>Interview another learner about someone they know.</span></li><li><strong lang="de">Welche Wörter beschreiben Ihre Familienmitglieder?</strong><span>Use adjectives like <em>lustig, groß, freundlich, intelligent</em>.</span></li></ol></section>
      <section id="structures" aria-labelledby="structures-title"><p class="eyebrow">04 / STRUKTUREN</p><h2 id="structures-title">Return to possessive adjectives.</h2><p>Lesson 8 revisits the possessives introduced in Lesson 7. Use these to talk about other people’s relatives, possessions and characteristics.</p><div class="table-wrap"><table><caption>Possessive adjective bases (nominative examples)</caption><thead><tr><th>Pronoun</th><th>Possessive</th><th>Example</th></tr></thead><tbody><tr><td lang="de">ich</td><td lang="de">mein</td><td lang="de">Mein Freund heißt Timo.</td></tr><tr><td lang="de">du</td><td lang="de">dein</td><td lang="de">Deine Freundin ist nett.</td></tr><tr><td lang="de">er</td><td lang="de">sein</td><td lang="de">Seine Augen sind braun.</td></tr><tr><td lang="de">sie</td><td lang="de">ihr</td><td lang="de">Ihr Freund ist sportlich.</td></tr><tr><td lang="de">wir</td><td lang="de">unser</td><td lang="de">Unsere Freundin studiert.</td></tr><tr><td lang="de">ihr</td><td lang="de">euer</td><td lang="de">Euer Bruder ist freundlich.</td></tr><tr><td lang="de">Sie (formal)</td><td lang="de">Ihr</td><td lang="de">Ist das Ihre Familie?</td></tr></tbody></table></div><p class="tip"><strong>Grammar note:</strong> <span lang="de">mein Freund</span> (masculine) but <span lang="de">meine Freundin</span> (feminine). Here we practise subject phrases; other cases introduce additional endings.</p><form class="auto-quiz quiz-form"><fieldset data-answer="Seine"><legend>01 · Timo has brown eyes: ___ Augen sind braun.</legend><div class="choices"><label><input type="radio" name="g1" value="Sein"/> Sein</label><label><input type="radio" name="g1" value="Seine"/> Seine</label></div><p class="feedback" aria-live="polite"></p></fieldset><fieldset data-answer="Meine"><legend>02 · I have a friend named Meike: ___ Freundin heißt Meike.</legend><div class="choices"><label><input type="radio" name="g2" value="Meine"/> Meine</label><label><input type="radio" name="g2" value="Mein"/> Mein</label></div><p class="feedback" aria-live="polite"></p></fieldset><fieldset data-answer="Ihre"><legend>03 · Her photos are interesting: ___ Fotos sind interessant.</legend><div class="choices"><label><input type="radio" name="g3" value="Ihr"/> Ihr</label><label><input type="radio" name="g3" value="Ihre"/> Ihre</label></div><p class="feedback" aria-live="polite"></p></fieldset><div class="quiz-actions"><button type="submit">Check answers</button><button type="reset" class="secondary">Try again</button></div><p class="quiz-score" role="status"></p></form><a class="next" href="/resources/german-async#e1">Back to all lessons →</a></section>
      <div id="study-resources"><PdfResources lessonNumbers={[8]} /></div>
      <aside class="source"><h2>Source and licence</h2><p>Adapted from <a href="https://grenzenlos-deutsch.com/familie/e1/l8/">Grenzenlos Deutsch: Lektion 8, Personen beschreiben</a>, licensed <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>. It follows the source lesson sequence and uses the three media links supplied by the user. The shortened character descriptions and self-check exercises are adaptations; the full recordings are played from the original website. Media playback has not been confirmed because the host restricts automated fetching.</p></aside>
    </div>
  </div>
</Base>
<script is:inline src="/assets/german/lesson-eight-interactions.js"></script>
