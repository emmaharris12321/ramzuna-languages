---
import Base from '@/layouts/Base.astro';
const letters = 'A Ä B C D E F G H I J K L M N O Ö P Q R S ß T U Ü V W X Y Z'.split(' ');
const available = letters.filter(letter => letter !== 'X');
const audioName: Record<string, string> = { 'Ä': 'AE', 'Ö': 'OE', 'Ü': 'UE', 'ß': 'eszett' };
const questions = [{"prompt": "Wie ___ du das?", "options": ["buchstabierst", "buchstabiert", "buchstabieren"], "answer": "buchstabierst", "why": "With du, use buchstabierst."}, {"prompt": "Ich ___ meinen Namen.", "options": ["schreibst", "schreibe", "schreibt"], "answer": "schreibe", "why": "With ich, use schreibe."}, {"prompt": "Wir ___ das Wort.", "options": ["buchstabiere", "buchstabiert", "buchstabieren"], "answer": "buchstabieren", "why": "With wir, use buchstabieren."}, {"prompt": "Wie ___ man das?", "options": ["schreiben", "schreibt", "schreibst"], "answer": "schreibt", "why": "Man takes the third-person singular form: schreibt."}];
---
<Base title="Lesson 4: das Alphabet" description="Listen to German letter names, practise spelling, and learn how to ask someone to spell a word."><div class="lesson-two"><header class="lesson-hero"><div class="wrap"><a class="back" href="/resources/german-async#e1">← Back to your learning path</a><p class="eyebrow">UNIT 01 · LESSON 04 · THE ALPHABET</p><h1>One letter.<br /><em>A little more confidence.</em></h1><p class="intro">Listen, repeat, and learn to spell names and everyday words in German.</p><p class="context">29 letter recordings are ready, including Ä, Ö, Ü and ß. Only the recording for X is still coming soon.</p><nav aria-label="Lesson steps"><a href="#listen">01 Listen</a><a href="#speak">02 Spell aloud</a><a href="#practice">03 Practise</a></nav></div></header><div class="wrap lesson-body">
<section id="listen" aria-labelledby="listen-title"><p class="eyebrow">01 / LISTEN &amp; REPEAT</p><h2 id="listen-title">Meet the alphabet.</h2><p>Play a letter, listen to its name, then say it aloud. Repeat as often as you need. A letter’s name is not always the sound it makes in a word.</p><h3 class="subheading">Watch and listen.</h3><p>Watch the video, then use the individual recordings below to repeat letters at your own pace.</p><div class="video"><iframe title="German alphabet lesson video" src="https://www.youtube.com/embed/jie6btnPuQs" width="560" height="315" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><p class="small">Internet required. <a href="https://www.youtube.com/watch?v=jie6btnPuQs">Watch on YouTube</a> if the player does not load.</p><h3 class="subheading">Practise one letter at a time.</h3><ul class="letter-grid">{letters.map(letter=><li class:list={['letter-card',{pending:!available.includes(letter)}]}><h3 lang="de">{letter}</h3>{available.includes(letter)?<><audio controls preload="none" aria-label={`Listen to the German letter ${letter}`} src={`/assets/german/alphabet/LET_${audioName[letter] || letter}.mp3`}></audio><a href={`/assets/german/alphabet/LET_${audioName[letter] || letter}.mp3`} download aria-label={`Download audio for ${letter}`}>Download audio</a></>:<p>Audio coming soon</p>}</li>)}</ul><p class="tip">German uses A–Z plus Ä, Ö, Ü and ß. Learn letter combinations in words as well: <span lang="de">ei</span> and <span lang="de">ie</span> sound different. Letter names alone do not tell you how to pronounce every German word.</p></section>
<section id="speak" aria-labelledby="speak-title"><p class="eyebrow">02 / SPELL ALOUD</p><h2 id="speak-title">“How do you spell that?”</h2><div class="dialogue" lang="de"><p><strong>Yasmin:</strong> Wie heißt du?</p><p><strong>Johannes:</strong> Ich heiße Johannes.</p><p><strong>Yasmin:</strong> Wie buchstabierst du das?</p><p><strong>Johannes:</strong> J-O-H-A-N-N-E-S. Wie heißt du?</p><p><strong>Yasmin:</strong> Mein Name ist Yasmin.</p><p><strong>Johannes:</strong> Schreibst du das mit Y oder mit J?</p><p><strong>Yasmin:</strong> Mit Y.</p></div><ol class="speaking"><li>Start with these words: <span lang="de">Name, Bild, Kaffee</span>. Say each letter aloud.</li><li>Practise spelling your name. Use the <a href="https://grenzenlos-deutsch.com/familie/e1/l4/">original lesson</a> for recordings not yet available here.</li><li>With a partner, spell a word while they write it down. Compare, then swap roles. The source suggests <span lang="de">Buch, Fenster, Schwester</span> and <span lang="de">Vater</span>.</li></ol><p class="tip"><span lang="de">Wie schreibt man das?</span> and <span lang="de">Wie buchstabiert man das?</span> both ask how something is spelled.</p></section>
<section id="practice" aria-labelledby="practice-title"><p class="eyebrow">03 / PUT IT INTO WORDS</p><h2 id="practice-title">Spell it. Write it.</h2><p><span lang="de">Buchstabieren</span> means “to spell”; <span lang="de">schreiben</span> means “to write”. Practise their present-tense forms.</p><div class="table-wrap"><table><caption>Present-tense forms</caption><thead><tr><th scope="col">Person</th><th scope="col" lang="de">buchstabieren</th><th scope="col" lang="de">schreiben</th></tr></thead><tbody>{[['ich','buchstabiere','schreibe'],['du','buchstabierst','schreibst'],['er / sie / es','buchstabiert','schreibt'],['wir','buchstabieren','schreiben'],['ihr','buchstabiert','schreibt'],['sie / Sie','buchstabieren','schreiben']].map(row=><tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody></table></div>
 <form id="lesson-quiz">{questions.map((q,i)=><fieldset data-answer={q.answer} data-explanation={q.why}><legend><span>{String(i+1).padStart(2,'0')}</span> <span lang="de">{q.prompt}</span></legend><div class="choices">{q.options.map(option=><label><input type="radio" name={`q${i}`} value={option}/><span lang="de">{option}</span></label>)}</div><p class="feedback" aria-live="polite"></p></fieldset>)}<div class="quiz-actions"><button type="submit">Check my answers</button><button type="reset" class="secondary">Try again</button></div><p id="quiz-score" role="status"></p></form>
 <noscript><p>Interactive checking needs JavaScript. Answer key: {questions.map((q,i)=>`${i+1}. ${q.answer}`).join(' · ')}.</p></noscript>
<p>Finish by asking and answering <span lang="de">“Wie buchstabierst du deinen Namen?”</span> Say your name, then spell it aloud.</p><a class="next" href="/resources/german-lesson-4-extension">Next: extension practice →</a></section><aside class="source"><h2>Source &amp; adaptation</h2><p>Adapted from <a href="https://grenzenlos-deutsch.com/familie/e1/l4/">Grenzenlos Deutsch, Lektion 4: das Alphabet</a>, supplied as a saved-page ZIP, under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>. Dialogue and spelling tasks come from the source. 29 recordings were supplied separately; the recording for X is not included. Explanations are adapted, the present-tense table is expanded, and four new questions replace embedded exercises. The supplied YouTube video requires internet and remains subject to its owner’s rights. This page has no offline-saving feature; individual recordings can be downloaded.</p><p>Original funding: National Endowment for the Humanities and the Mansergh-Stuessy Fund for College Innovation. Ramzunā Languages is not affiliated with the original authors.</p></aside></div></div></Base>
<script>
document.querySelectorAll('audio').forEach(audio => audio.addEventListener('play', () => { document.querySelectorAll('audio').forEach(other => { if (other !== audio) other.pause(); }); }));
const quiz = document.querySelector<HTMLFormElement>('#lesson-quiz');
quiz?.addEventListener('submit',event=>{event.preventDefault();let score=0;const fields=quiz.querySelectorAll<HTMLFieldSetElement>('fieldset');fields.forEach(field=>{const selected=field.querySelector<HTMLInputElement>('input:checked');const correct=selected?.value===field.dataset.answer;if(correct)score++;const feedback=field.querySelector<HTMLElement>('.feedback')!;feedback.textContent=!selected?'Choose an answer first.':`${correct?'Correct.':'Not quite.'} ${field.dataset.explanation}`;field.dataset.result=!selected?'empty':correct?'correct':'incorrect';});document.querySelector('#quiz-score')!.textContent=`${score} of ${fields.length} correct. Review the feedback above and try again whenever you like.`;});
quiz?.addEventListener('reset',()=>{quiz.querySelectorAll<HTMLElement>('.feedback').forEach(el=>el.textContent='');quiz.querySelectorAll<HTMLElement>('fieldset').forEach(el=>delete el.dataset.result);document.querySelector('#quiz-score')!.textContent='';});
</script>
<style>
.letter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:24px}.letter-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:20px;min-width:0}.letter-card h3{font-family:Georgia,serif;font-size:2.3rem;margin-bottom:12px}.letter-card audio{width:100%;display:block}.letter-card a,.letter-card p{display:inline-block;font-size:.75rem;margin-top:12px}.pending{opacity:.8}.dialogue{background:var(--paper);padding:24px;border-radius:16px;margin:24px 0}.dialogue p{margin:8px 0}.table-wrap{overflow-x:auto;margin:24px 0}table{width:100%;border-collapse:collapse;background:var(--paper)}caption{text-align:left;margin-bottom:12px}th,td{text-align:left;padding:12px;border-bottom:1px solid var(--line);font-size:.85rem}@media(max-width:600px){.letter-grid{grid-template-columns:1fr}}
.lesson-two{--ink:#243d35;--muted:#58665d;--paper:#fffdf8;--line:#dce1d6;background:#f7f6ee;color:var(--ink);padding-bottom:70px}.wrap{width:min(960px,calc(100% - 40px));margin:auto}.lesson-hero{background:#edf0e4;padding:30px 0 48px}.back{display:inline-block;margin-bottom:35px;font-size:.85rem}.eyebrow{font-size:.68rem;letter-spacing:.14em;font-weight:700;margin-bottom:12px}h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(2.5rem,5vw,3.8rem);line-height:1.15;letter-spacing:-.035em}h1 em{color:#567047}.intro{font-size:1.1rem;margin-top:22px}.context{font-size:.85rem;max-width:680px;margin-top:16px;color:var(--muted)}nav{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}nav a{border:1px solid #aab89d;border-radius:30px;padding:10px 18px;font-size:.8rem;background:var(--paper)}.lesson-body section{padding-top:48px;scroll-margin-top:90px}h2{font-family:'Playfair Display',Georgia,serif;font-size:2rem;margin-bottom:16px}p{line-height:1.7}section>p{color:var(--muted)}a:hover{text-decoration:underline}p a,.source a{text-decoration:underline;text-underline-offset:3px}.video{aspect-ratio:16/9;background:#17261c;border-radius:18px;overflow:hidden;margin:24px 0 12px}.video iframe{width:100%;height:100%;border:0}.small{font-size:.78rem}.word-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px}.word-grid li{padding:20px;background:var(--paper);border:1px solid var(--line);border-radius:12px}.word-grid li>span{font-size:.7rem;color:var(--muted)}.word-grid h3{font-size:1.05rem;font-weight:600;margin:8px 0 3px}.word-grid p{font-size:.85rem;color:var(--muted)}.subheading{font-weight:600;font-size:1.25rem;margin:30px 0 16px}.numbers{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.numbers li{display:flex;gap:12px;background:var(--paper);padding:12px;border-radius:8px;font-size:.85rem}.numbers span{min-width:22px;color:var(--muted)}.tip{background:#e9eddf;border-left:3px solid #738959;padding:18px 22px;margin:24px 0;font-size:.85rem}.grammar-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.grammar-grid article{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:24px}.grammar-grid h3{font-size:1.3rem;font-weight:600;margin-bottom:10px}.grammar-grid p,.grammar-grid li{font-size:.85rem;line-height:1.7}.grammar-grid ul{margin-top:12px;display:grid;gap:8px}fieldset{margin:22px 0;padding:18px;border:1px solid var(--line);border-radius:12px;background:var(--paper)}legend{font-weight:600;padding:0 8px}legend>span:first-child{color:#986345;font-size:.75rem;margin-right:10px}.choices{display:flex;flex-wrap:wrap;gap:10px}.choices label{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:8px;padding:10px 16px;cursor:pointer}.choices label:has(input:checked){outline:2px solid #738959}input{accent-color:#304e3d}.feedback{font-size:.8rem;margin-top:12px}fieldset[data-result=correct]{border-color:#53783c}fieldset[data-result=incorrect]{border-color:#a45939}.quiz-actions{display:flex;gap:12px;flex-wrap:wrap}button,.next{display:inline-block;background:#304e3d;color:#fff;padding:13px 22px;border-radius:10px;font-weight:600;cursor:pointer}button.secondary{background:var(--paper);color:var(--ink);border:1px solid var(--line)}#quiz-score{margin-top:16px}.speaking{list-style:decimal;padding-left:24px;display:grid;gap:12px;line-height:1.7}.example{font-family:Georgia,serif;font-size:1.5rem;background:var(--paper);padding:24px;border-radius:12px;margin:24px 0}.next{margin-top:24px}.source{border-top:1px solid var(--line);margin-top:48px;padding-top:24px;color:var(--muted)}.source h2{font-family:inherit;font-size:1rem;font-weight:600}.source p{font-size:.75rem;margin-top:10px}:focus-visible{outline:3px solid #a45b3c;outline-offset:4px}:global(.dark) .lesson-two{--ink:#eef1e6;--muted:#bec9bb;--paper:#202d26;--line:#425146;background:#16241d}:global(.dark) .lesson-hero{background:#23372b}:global(.dark) h1 em{color:#b6cca1}:global(.dark) .tip{background:#2c3f2c}@media(max-width:600px){.word-grid,.grammar-grid{grid-template-columns:1fr}.numbers{grid-template-columns:repeat(2,1fr)}h2{font-size:1.6rem}.lesson-body section{padding-top:32px}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
</style>
