---
import Base from '@/layouts/Base.astro';

const root = 'https://grenzenlos-deutsch.com';
const fam = `${root}/familie`;

// Lesson titles and URLs follow the Grenzenlos Deutsch "Familie und Freunde" navigation.
const units = [
  {
    id: 'e1', title: 'Einheit 1: Einführung', blurb: 'Introductions, numbers, the alphabet, family, hobbies, colours and describing people.',
    lessons: [
      'sich vorstellen', 'zählen 1', 'Familie', 'das Alphabet', 'zählen 2',
      'Hobbys', 'Farben', 'Personen beschreiben', 'Freunde', 'Studium',
    ],
    summary: true,
  },
  {
    id: 'e2', title: 'Einheit 2: Das Zusammensein', blurb: 'Family and friendship: spending time together, blended families, and Vienna Pride.',
    lessons: [
      'Familie Wiederholung', 'Zusammensein mit der Familie', 'Patchworkfamilien',
      'Zusammensein mit FreundInnen', 'Freundschaft', 'Freunde und Bekannte', 'Vienna Pride',
    ],
    summary: true,
  },
  {
    id: 'e3', title: 'Einheit 3: Feiertage', blurb: 'Birthdays and holidays through the year.',
    lessons: ['Geburtstage', 'Feiertage im Frühling', '1. Mai', 'Sommerfeiertage', 'Herbstfeiertage'],
    summary: false,
  },
];

const steps = [
  { title: 'Read and listen', text: 'Each lesson opens with short texts and audio. Read first, then listen as many times as you like.' },
  { title: 'Do the exercises', text: 'Interactive exercises give instant feedback and can be repeated. Nobody is marking them.' },
  { title: 'Speak aloud', text: 'Every lesson ends with speaking prompts. Record yourself, or bring your answers to your next live session.' },
  { title: 'Take your questions to class', text: 'Note anything unclear and ask your teacher or conversation partner.' },
];
---

<Base title="German Asynchronous Resources" description="Free self-paced German lessons from the open Grenzenlos Deutsch curriculum, for Ramzunā Languages students to use between live sessions.">
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">German Asynchronous Resources</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Self-paced German (beginner, A1) for use between live sessions, built on the open Grenzenlos Deutsch curriculum.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a><span>/</span>
        <a href="/resources" class="transition-colors hover:text-white">Resources</a><span>/</span>
        <span class="text-white">German Asynchronous</span>
      </nav>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="container mx-auto max-w-4xl px-4 lg:px-8">

      <p class="text-lg text-gray-700 dark:text-gray-300">
        <em>Grenzenlos Deutsch</em> is a free, open-access German course with audio, video and interactive exercises. You can work through it
        on your own schedule, with no login. Lessons on this site are self-contained: the text, audio and exercises are hosted here, so they work without the original website.
      </p>

      <h2 class="mt-12 font-display text-2xl font-semibold text-gray-900 dark:text-white">How to use it</h2>
      <ol class="mt-6 grid gap-4 sm:grid-cols-2">
        {steps.map((s, i) => (
          <li class="rounded-2xl bg-white p-5 shadow-sm dark:bg-gray-800">
            <h3 class="font-semibold text-gray-900 dark:text-white">{i + 1}. {s.title}</h3>
            <p class="mt-1 text-gray-600 dark:text-gray-400">{s.text}</p>
          </li>
        ))}
      </ol>

      <div class="mt-8 rounded-2xl border border-primary-200 bg-primary-50 p-5 dark:border-primary-800 dark:bg-primary-900/30">
        <p class="text-gray-800 dark:text-gray-200">
          <strong>Start here:</strong> Einheit 1, Lektion 1 is ready.
          <a class="font-medium underline" href="/resources/grenzenlos-deutsch">Open Lektion 1</a>.
        </p>
      </div>

      <h2 class="mt-14 font-display text-2xl font-semibold text-gray-900 dark:text-white">Familie und Freunde</h2>
      <p class="mt-2 text-gray-600 dark:text-gray-400">Work through the units in order. More lessons are being added.</p>

      {units.map((u) => (
        <details class="group mt-6 rounded-2xl bg-white shadow-sm dark:bg-gray-800" open={u.id === 'e1'}>
          <summary class="cursor-pointer list-none rounded-2xl p-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-600">
            <span class="block text-lg font-semibold text-gray-900 dark:text-white">{u.title}</span>
            <span class="mt-1 block text-sm text-gray-600 dark:text-gray-400">{u.blurb}</span>
          </summary>
          <ul class="divide-y divide-gray-100 border-t border-gray-100 px-5 dark:divide-gray-700 dark:border-gray-700">
            {u.lessons.map((title, i) => (
              <li class="flex flex-wrap items-center justify-between gap-2 py-3">
                {u.id === 'e1' && i === 0 ? (
                  <a class="font-medium text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" href="/resources/grenzenlos-deutsch">
                    Lektion 1: {title}
                  </a>
                ) : (
                  <span class="text-gray-500 dark:text-gray-400">Lektion {i + 1}: {title}</span>
                )}
                <span class="text-sm text-gray-500 dark:text-gray-400">{u.id === 'e1' && i === 0 ? 'Available now' : 'Coming soon'}</span>
              </li>
            ))}
            {u.summary && (
              <li class="py-3 text-gray-500 dark:text-gray-400">{u.title.split(':')[0]}: Zusammenfassung</li>
            )}
          </ul>
        </details>
      ))}

      <aside id="citation" class="mt-16 rounded-2xl border border-gray-200 p-6 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-400">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white">Source and citation</h2>
        <p class="mt-2">
          These resources come from <a class="underline" href={root}>Grenzenlos Deutsch: an open-access curriculum for beginning German</a>,
          licensed under a <a class="underline" href="https://creativecommons.org/licenses/by-nc-sa/4.0/">Creative Commons
          Attribution-NonCommercial-ShareAlike 4.0 International License</a> (CC BY-NC-SA 4.0).
          Funding for the original was provided in part by the National Endowment for the Humanities and the Mansergh-Stuessy Fund for College Innovation.
        </p>
        <p class="mt-2">
          Text, audio and explanations are reproduced from the original; the interactive exercises are rebuilt as plain HTML with the same content. Changes are noted on each lesson. Adaptations are shared under the same license, for non-commercial use. Ramzunā Languages is not affiliated with the Grenzenlos Deutsch authors.
        </p>
      </aside>
    </div>
  </section>
</Base>
