---
import Base from '@/layouts/Base.astro';

interface Resource {
  title: string;
  url: string;
  description: string;
}

const resources: Resource[] = [
  {
    title: 'Dignity for Palestinians Campaign',
    url: 'https://dignity4palestine.org/mental-health-psychosocial-support/',
    description: 'Remote and hybrid trauma-informed counselling, psychoeducation and psychological first aid for people in Gaza, delivered by WhatsApp, phone and video call.',
  },
  {
    title: 'The Pocket Project – Trauma-Informed Support Sessions',
    url: 'https://pocketproject.org/trauma-informed-support-sessions/',
    description: 'Free, confidential one-to-one support sessions for people affected by war and displacement, with trained facilitators available in Arabic and English.',
  },
  {
    title: 'Healing for Gaza',
    url: 'https://healingforgaza.org/',
    description: 'Remote psychotherapy, training and clinical support for children, families and frontline workers affected by the war in Gaza.',
  },
  {
    title: 'Free Palestine Mental Health Support',
    url: 'https://freepalestinementalhealthsupport.mystrikingly.com',
    description: 'A directory connecting Palestinians with mental health practitioners offering free or low-cost support.',
  },
  {
    title: 'Catharsis Holistic Healing in Palestine',
    url: 'https://www.ashirapremrachana.com/catharsis-holistic-healing-palestine',
    description: 'Free trauma-healing sessions using breathwork, somatic therapy and yoga, with a focus on Palestinian women and children.',
  },
  {
    title: 'Gaza Community Mental Health Programme',
    url: 'https://gcmhp.org/contact',
    description: 'A Gaza-based mental health organisation offering counselling through community centres and a free telephone helpline.',
  },
  {
    title: 'Palestinian Council for Mental Health',
    url: 'https://pcmh-gaza.org',
    description: 'A non-profit providing free psychological, social, legal and rights support to Palestinian society.',
  },
];
---

<Base title="Mental Health Resources for Palestinians" description="Free and low-cost mental health and psychosocial support resources for Palestinians, especially those affected by the war in Gaza.">
  <!-- Page Header -->
  <section class="bg-primary-600 py-16 lg:py-24 dark:bg-primary-900">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Mental Health Resources for Palestinians</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        Free and low-cost mental health and psychosocial support, for Palestinians affected by displacement, loss and war.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-200" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/resources" class="transition-colors hover:text-white">Resources</a>
        <span>/</span>
        <span class="text-white">Mental Health Resources</span>
      </nav>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2">
        {
          resources.map((res) => (
            <article class="group flex flex-col rounded-2xl bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-soft-lg dark:bg-gray-800">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-accent-100 text-lg dark:bg-accent-900/50">💛</div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                <a href={res.url} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary-600 dark:hover:text-primary-400">
                  {res.title}
                </a>
              </h3>
              <p class="mt-2 flex-1 text-gray-600 dark:text-gray-400">{res.description}</p>
              <a
                href={res.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex w-fit items-center gap-1 text-sm font-medium text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300"
              >
                Visit resource <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))
        }
      </div>

      <p class="mx-auto mt-12 max-w-2xl text-center text-gray-600 dark:text-gray-400">
        If you or someone you know is in crisis, please reach out to a local emergency service or a trusted person as soon as possible.
      </p>
    </div>
  </section>
</Base>
