.lesson-two{--ink:#243d35;--muted:#58665d;--paper:#fffdf8;--line:#dce1d6;background:#f7f6ee;color:var(--ink);padding-bottom:70px}.wrap{width:min(960px,calc(100% - 40px));margin:auto}.lesson-hero{background:#edf0e4;padding:30px 0 48px}.back{display:inline-block;margin-bottom:35px;font-size:.85rem}.eyebrow{font-size:.68rem;letter-spacing:.14em;font-weight:700;margin-bottom:12px}h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(2.5rem,5vw,3.8rem);line-height:1.15;letter-spacing:-.035em}h1 em{color:#567047}.intro{font-size:1.1rem;margin-top:22px}.context{font-size:.85rem;max-width:680px;margin-top:16px;color:var(--muted)}nav{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}nav a{border:1px solid #aab89d;border-radius:30px;padding:10px 18px;font-size:.8rem;background:var(--paper)}.lesson-body section{padding-top:48px;scroll-margin-top:90px}h2{font-family:'Playfair Display',Georgia,serif;font-size:2rem;margin-bottom:16px}p{line-height:1.7}section>p{color:var(--muted)}a:hover{text-decoration:underline}p a,.source a{text-decoration:underline;text-underline-offset:3px}.video{aspect-ratio:16/9;background:#17261c;border-radius:18px;overflow:hidden;margin:24px 0 12px}.video iframe{width:100%;height:100%;border:0}.small{font-size:.78rem}.word-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px}.word-grid li{padding:20px;background:var(--paper);border:1px solid var(--line);border-radius:12px}.word-grid li>span{font-size:.7rem;color:var(--muted)}.word-grid h3{font-size:1.05rem;font-weight:600;margin:8px 0 3px}.word-grid p{font-size:.85rem;color:var(--muted)}.subheading{font-weight:600;font-size:1.25rem;margin:30px 0 16px}.numbers{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.numbers li{display:flex;gap:12px;background:var(--paper);padding:12px;border-radius:8px;font-size:.85rem}.numbers span{min-width:22px;color:var(--muted)}.tip{background:#e9eddf;border-left:3px solid #738959;padding:18px 22px;margin:24px 0;font-size:.85rem}.grammar-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.grammar-grid article{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:24px}.grammar-grid h3{font-size:1.3rem;font-weight:600;margin-bottom:10px}.grammar-grid p,.grammar-grid li{font-size:.85rem;line-height:1.7}.grammar-grid ul{margin-top:12px;display:grid;gap:8px}fieldset{margin:22px 0;padding:18px;border:1px solid var(--line);border-radius:12px;background:var(--paper)}legend{font-weight:600;padding:0 8px}legend>span:first-child{color:#986345;font-size:.75rem;margin-right:10px}.choices{display:flex;flex-wrap:wrap;gap:10px}.choices label{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:8px;padding:10px 16px;cursor:pointer}.choices label:has(input:checked){outline:2px solid #738959}input{accent-color:#304e3d}.feedback{font-size:.8rem;margin-top:12px}fieldset[data-result=correct]{border-color:#53783c}fieldset[data-result=incorrect]{border-color:#a45939}.quiz-actions{display:flex;gap:12px;flex-wrap:wrap}button,.next{display:inline-block;background:#304e3d;color:#fff;padding:13px 22px;border-radius:10px;font-weight:600;cursor:pointer}button.secondary{background:var(--paper);color:var(--ink);border:1px solid var(--line)}#quiz-score{margin-top:16px}.speaking{list-style:decimal;padding-left:24px;display:grid;gap:12px;line-height:1.7}.example{font-family:Georgia,serif;font-size:1.5rem;background:var(--paper);padding:24px;border-radius:12px;margin:24px 0}.next{margin-top:24px}.source{border-top:1px solid var(--line);margin-top:48px;padding-top:24px;color:var(--muted)}.source h2{font-family:inherit;font-size:1rem;font-weight:600}.source p{font-size:.75rem;margin-top:10px}:focus-visible{outline:3px solid #a45b3c;outline-offset:4px}:global(.dark) .lesson-two{--ink:#eef1e6;--muted:#bec9bb;--paper:#202d26;--line:#425146;background:#16241d}:global(.dark) .lesson-hero{background:#23372b}:global(.dark) h1 em{color:#b6cca1}:global(.dark) .tip{background:#2c3f2c}@media(max-width:600px){.word-grid,.grammar-grid{grid-template-columns:1fr}.numbers{grid-template-columns:repeat(2,1fr)}h2{font-size:1.6rem}.lesson-body section{padding-top:32px}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
