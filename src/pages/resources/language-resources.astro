// "Start here" suggestion shown for each language, so a student who is unsure
// where to begin has one clear first click. Edit freely: any resource from the
// directory above (or another link) can be used here.
const startHere: Record<Collection, { title: string; url: string; note: string }> = {
  English: { title: 'BBC Learning English', url: 'https://www.bbc.co.uk/learningenglish/english/home', note: 'Lessons, news, listening and grammar in one place.' },
  IELTS: { title: 'IELTS Liz', url: 'https://ieltsliz.com', note: 'Tips and practice for the IELTS exam.' },
  French: { title: 'Easy French (YouTube)', url: 'https://www.youtube.com/@easyfrench', note: 'Video lessons and real-life French conversations.' },
  German: { title: 'Deutsche Welle – Learn German', url: 'https://learngerman.dw.com/en/learn-german/s-9528', note: 'Free German courses to follow step by step.' },
  Italian: { title: 'Coffee Break Italian', url: 'https://coffeebreaklanguages.com/coffeebreakitalian/', note: 'Short podcast lessons you can listen to anywhere.' },
};

const langCards: Record<Collection, { icon: string; blurb: string }> = {
  English: { icon: '🇬🇧', blurb: 'Courses, news, podcasts and speaking practice.' },
  IELTS: { icon: '🎓', blurb: 'Practice tests, listening and writing help for the exam.' },
  French: { icon: '🇫🇷', blurb: 'Podcasts, videos, grammar and exam preparation.' },
  German: { icon: '🇩🇪', blurb: 'Courses, videos, slow podcasts and easy reading.' },
  Italian: { icon: '🇮🇹', blurb: 'Podcasts, courses and videos for beginners.' },
};

const formatIcon: Record<Format, string> = { Website: '🌐', Video: '▶', Podcast: '🎧', PDF: '📄', Document: '📄' };

const formatHelp: Record<Format, string> = {
  Website: 'Read or practise online',
  Video: 'Watch on YouTube',
  Podcast: 'Listen',
  PDF: 'Download or read a PDF',
  Document: 'Open a shared document',
};

const sections = collections.map(collection => ({
  collection,
  groups: Object.entries(directory[collection]).map(([name, entries]) => ({
    name,
    entries: entries.map(entry => Array.isArray(entry)
      ? { name: '', links: [{ title: entry[0], url: entry[1], group: name, format: entry[2] ?? 'Website' }] }
      : { name: entry.name, links: entry.links.map(([title, url, goal, format]) => ({
          title, url, group: goal ?? name, format: format ?? 'Website',
        })) })
      .sort((a, b) => (a.name || a.links[0].title).localeCompare(b.name || b.links[0].title)),
  })),
}));
const resources = sections.flatMap(section => section.groups.flatMap(group =>
  group.entries.flatMap(entry => entry.links.map(link => ({ ...link, collection: section.collection })))
));

---

<Base title="Language Resources" description="Free language learning and IELTS preparation resources. Choose a language, choose what you want to practise, then open a resource.">
  <section class="bg-primary-600 py-10 dark:bg-primary-900 lg:py-14">
    <div class="container mx-auto px-4 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap gap-2 text-sm text-primary-100">
        <a href="/" class="hover:text-white">Home</a><span aria-hidden="true">/</span>
        <a href="/resources" class="hover:text-white">Resources</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-white">Language Resources</span>
      </nav>
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl">Language Resources</h1>
      <p class="mt-3 max-w-2xl text-base text-primary-100">
        Websites, videos and podcasts to help you study on your own.
      </p>
    </div>
  </section>

  <section data-language-directory class="py-10 lg:py-14">
    <div class="container mx-auto max-w-5xl px-4 lg:px-8">

      <!-- Step 1 -->
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white">Choose a language</h2>
        <p class="mt-3 text-base text-gray-600 dark:text-gray-400">Select a language to see websites, videos and podcasts for it. Everything opens in a new tab.</p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="group" aria-label="Choose a language">
        {collections.map((collection, i) => (
          <button type="button" data-collection-filter={collection} aria-pressed="false"
            class="lang-card flex flex-col rounded-2xl bg-white p-6 text-left shadow-sm transition-all hover:-translate-y-1 hover:shadow-soft-lg dark:bg-gray-800">
            <span class:list={['mb-4 flex h-12 w-12 items-center justify-center rounded-xl text-2xl', i % 2 === 0 ? 'bg-primary-100 dark:bg-primary-900/50' : 'bg-accent-100 dark:bg-accent-900/50']} aria-hidden="true">{langCards[collection].icon}</span>
            <span class="text-lg font-semibold text-gray-900 dark:text-white">{collection}</span>
            <span class="mt-1 flex-1 text-gray-600 dark:text-gray-400">{langCards[collection].blurb}</span>
            <span class:list={['mt-5 inline-flex w-fit items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium text-white shadow-sm', i % 2 === 0 ? 'bg-primary-600' : 'bg-accent-600']}>
              See {resources.filter(r => r.collection === collection).length} resources <span aria-hidden="true">→</span>
            </span>
          </button>
        ))}
      </div>

      <!-- Step 2: the chosen language -->
      <div id="language-panel" class="mt-14 scroll-mt-28" aria-live="polite">
        <p data-lang-hint class="text-center text-gray-500 dark:text-gray-400">Resources for your language will appear here.</p>

        <div data-lang-panel hidden>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 data-lang-title class="font-display text-2xl font-semibold text-gray-900 dark:text-white"></h2>
            <button type="button" data-lang-clear class="text-sm font-medium text-primary-700 underline-offset-2 hover:underline dark:text-primary-300">← Choose another language</button>
          </div>

          {collections.map(collection => (
            <div data-start-here={collection} hidden class="mt-5 flex flex-col gap-3 rounded-2xl border border-primary-200 bg-primary-50 p-5 sm:flex-row sm:items-center sm:justify-between dark:border-primary-800 dark:bg-primary-900/20">
              <div>
                <p class="text-sm font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">Not sure where to start?</p>
                <p class="mt-1 text-gray-800 dark:text-gray-200"><strong>{startHere[collection].title}</strong>. {startHere[collection].note}</p>
              </div>
              <a href={startHere[collection].url} target="_blank" rel="noopener noreferrer"
                class="inline-flex flex-shrink-0 items-center justify-center gap-2 rounded-lg bg-primary-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-primary-700">
                Open it <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
              </a>
            </div>
          ))}

          <!-- Optional filters -->
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            <div>
              <label for="resource-group" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">I want to practise</label>
              <select id="resource-group" data-group-filter class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-base text-gray-900 dark:border-gray-700 dark:bg-gray-800 dark:text-white">
                <option value="All">Everything</option>
                {[...new Set(resources.map(r => r.group))].sort().map(group => <option value={group}>{group}</option>)}
              </select>
            </div>
            <div>
              <label for="resource-format" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">I prefer to</label>
              <select id="resource-format" data-format-filter class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-base text-gray-900 dark:border-gray-700 dark:bg-gray-800 dark:text-white">
                <option value="All">Use any type</option>
                {[...new Set(resources.map(r => r.format))].sort().map(format => <option value={format}>{formatHelp[format]}</option>)}
              </select>
            </div>
            <div>
              <label for="resource-search" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Or search by name</label>
              <input id="resource-search" data-search type="search" placeholder="For example: grammar"
                class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-base text-gray-900 placeholder-gray-400 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-gray-700 dark:bg-gray-800 dark:text-white" />
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between gap-4">
            <p data-result-count role="status" class="text-sm text-gray-600 dark:text-gray-400"></p>
            <button type="button" data-reset class="text-sm font-medium text-primary-700 underline-offset-2 hover:underline dark:text-primary-300">Clear filters</button>
          </div>

          <div class="mt-6 space-y-10">
            {sections.map(section => (
              <div data-collection={section.collection} hidden class="space-y-10">
                {section.groups.map(group => (
                  <section data-group-section={group.name}>
                    <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{group.name}</h3>
                    <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                      {group.entries.map(entry => (
                        <div data-entry class="flex flex-col rounded-2xl bg-white p-5 shadow-sm transition-shadow hover:shadow-soft-lg dark:bg-gray-800">
                          {entry.name && <h4 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">{entry.name}</h4>}
                          <ul class="flex flex-1 flex-col gap-2">
                            {entry.links.map(resource => (
                              <li data-resource data-group={resource.group} data-format={resource.format} class="flex-1"
                                data-search-text={`${entry.name} ${resource.title} ${section.collection} ${resource.group} ${resource.format}`.toLowerCase()}>
                                <a href={resource.url} target="_blank" rel="noopener noreferrer"
                                  class="group flex h-full flex-col rounded-xl p-3 transition-colors hover:bg-primary-50 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-500 dark:hover:bg-primary-900/20">
                                  <span class="flex items-center gap-2">
                                    <span class={`format-badge format-${resource.format.toLowerCase()}`}><span aria-hidden="true">{formatIcon[resource.format]}</span> {resource.format}</span>
                                  </span>
                                  <span class="mt-2 font-medium text-gray-900 group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">{resource.title}</span>
                                  {resource.group !== group.name && (
                                    <span class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">For: {resource.group}</span>
                                  )}
                                  <span class="mt-3 text-sm font-medium text-primary-700 dark:text-primary-300">Open <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            ))}
          </div>

          <div data-empty hidden class="mt-6 rounded-2xl border border-dashed border-gray-300 p-8 text-center text-gray-600 dark:border-gray-700 dark:text-gray-400">
            No resources match. Select &ldquo;Clear filters&rdquo; to see them all again.
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  [data-language-directory] [hidden] { display: none !important; }
  .lang-card { cursor: pointer; }
  .lang-card[aria-pressed="true"] { outline: 2px solid #38664f; outline-offset: 2px; }
  .collection-filter { color: #374151; background: #e5e7eb; }
  .collection-filter:hover { background: #d1d5db; }
  .collection-filter[aria-pressed="true"] { background: #38664f; color: #fff; }
  :global(.dark) .collection-filter { color: #d1d5db; background: #374151; }
  :global(.dark) .collection-filter:hover { background: #4b5563; }
  :global(.dark) .collection-filter[aria-pressed="true"] { background: #38664f; color: #fff; }

  .format-badge {
    flex-shrink: 0;
    border-radius: 9999px;
    padding: 0.125rem 0.625rem;
    font-size: var(--rz-text-small);
    font-weight: 600;
    background: #eef5f0;
    color: #2c5240;
  }
  .format-video { background: #f5e9e9; color: #7a222b; }
  .format-podcast { background: #efe4cf; color: #5c4a1f; }
  .format-pdf, .format-document { background: #e5e7eb; color: #374151; }
  :global(.dark) .format-badge { background: rgba(56, 102, 79, 0.35); color: #d9e6da; }
  :global(.dark) .format-video { background: rgba(122, 34, 43, 0.35); color: #f5e9e9; }
  :global(.dark) .format-podcast { background: rgba(239, 228, 207, 0.15); color: #efe4cf; }
  :global(.dark) .format-pdf, :global(.dark) .format-document { background: #374151; color: #d1d5db; }
</style>

<script>
  function initialiseDirectory(root: HTMLElement) {
    if (root.dataset.initialised) return;
    root.dataset.initialised = 'true';

    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const objective = root.querySelector<HTMLSelectElement>('[data-group-filter]')!;
    const format = root.querySelector<HTMLSelectElement>('[data-format-filter]')!;
    const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-collection-filter]')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-collection]')];
    const startBoxes = [...root.querySelectorAll<HTMLElement>('[data-start-here]')];
    const hint = root.querySelector<HTMLElement>('[data-lang-hint]')!;
    const panel = root.querySelector<HTMLElement>('[data-lang-panel]')!;
    const title = root.querySelector<HTMLElement>('[data-lang-title]')!;
    const resultCount = root.querySelector<HTMLElement>('[data-result-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let active: string | null = null;

    function updateObjectives() {
      const available = new Set(sections
        .filter(section => section.dataset.collection === active)
        .flatMap(section => [...section.querySelectorAll<HTMLElement>('[data-resource]')].map(item => item.dataset.group!)));
      for (const option of Array.from(objective.options)) {
        option.hidden = option.value !== 'All' && !available.has(option.value);
        option.disabled = option.hidden;
      }
      if (objective.selectedOptions[0]?.disabled) objective.value = 'All';
    }

    function update() {
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let total = 0;
      for (const section of sections) {
        const isActive = section.dataset.collection === active;
        let sectionCount = 0;
        for (const group of section.querySelectorAll<HTMLElement>('[data-group-section]')) {
          let groupCount = 0;
          for (const item of group.querySelectorAll<HTMLElement>('[data-resource]')) {
            const matches = isActive
              && (objective.value === 'All' || item.dataset.group === objective.value)
              && (format.value === 'All' || item.dataset.format === format.value)
              && terms.every(term => item.dataset.searchText?.includes(term));
            item.hidden = !matches;
            if (matches) groupCount++;
          }
          group.hidden = groupCount === 0;
          for (const entry of group.querySelectorAll<HTMLElement>('[data-entry]')) {
            entry.hidden = !entry.querySelector('[data-resource]:not([hidden])');
          }
          sectionCount += groupCount;
        }
        section.hidden = !isActive;
        if (isActive) total = sectionCount;
      }
      cards.forEach(card => card.setAttribute('aria-pressed', String(card.dataset.collectionFilter === active)));
      startBoxes.forEach(box => { box.hidden = box.dataset.startHere !== active; });
      hint.hidden = active !== null;
      panel.hidden = active === null;
      title.textContent = active ? `${active} resources` : '';
      resultCount.textContent = `${total} resource${total === 1 ? '' : 's'}`;
      empty.hidden = active === null || total !== 0;
    }

    function choose(collection: string | null, scroll: boolean) {
      active = collection;
      search.value = '';
      objective.value = 'All';
      format.value = 'All';
      updateObjectives();
      update();
      const target = collection ? root.querySelector('#language-panel') : root;
      if (scroll) target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    cards.forEach(card => card.addEventListener('click', () => choose(card.dataset.collectionFilter!, true)));
    root.querySelector('[data-lang-clear]')?.addEventListener('click', () => choose(null, true));
    search.addEventListener('input', update);
    objective.addEventListener('change', update);
    format.addEventListener('change', update);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      search.value = '';
      objective.value = 'All';
      format.value = 'All';
      update();
    });
    choose(null, false);
  }

  const init = () => document.querySelectorAll<HTMLElement>('[data-language-directory]').forEach(initialiseDirectory);
  init();
  document.addEventListener('astro:page-load', init);
</script>
