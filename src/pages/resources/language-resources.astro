      ["Learn German Original – A1 Course","https://www.youtube.com/watch?v=RuGmc662HDg&list=PLF9mJC4RrjIhS4MMm0x72-qWEn1LRvPuW","Video"],
    ],
    "Speaking & videos": [
      ["YouTube – German Learning Channel","https://www.youtube.com/channel/UCbxb2fqe9oNgglAoYqsYOtQ","Video"],
      ["GermanTalks","https://www.youtube.com/@TalksGerman","Video"],
      ["Daily Deutsch","https://www.youtube.com/@Daily_Deutsch","Video"],
      ["DialogDE","https://www.youtube.com/@DialogDE-j8j","Video"],
    ],
    "Listening & podcasts": [
      ["Coffee Break German","https://coffeebreaklanguages.com/coffeebreakgerman/","Podcast"],
      ["Slow German","https://www.slowgerman.com/","Podcast"],
      ["News in Slow German","https://www.newsinslowgerman.com/","Podcast"],
      ["GermanPod101","https://www.youtube.com/channel/UCTobWZV_HWGSoaRrhHyrJ-A","Video"],
    ],
    "Reading & news": [
      ["StoryLearning German","https://www.storylearning.com/"],
      ["Learn Out Live","https://learnoutlive.com/"],
      ["EasyReaders.eu","https://www.easyreaders.eu/"],
