      { name: "Deutsche Welle", links: [
        ["Learn German","https://learngerman.dw.com/en/learn-german/s-9528",null,null],
        ["German news","https://www.dw.com/de/","Reading & news",null],
      ] },
      { name: "Goethe-Institut", links: [
        ["Deutsch für dich","https://www.goethe.de/prj/dfd/en/home.cfm",null,null],
        ["Exams","https://www.goethe.de/ins/mm/en/spr/prf.html","Exam preparation",null],
      ] },
      ["VHS Lernportal","https://www.vhs-lernportal.de/wws/9.php"],
      ["Pressbooks – German 101","https://una.pressbooks.pub/gr101/chapter/section-1-1/"],
      ["Mein Deutschbuch","https://mein-deutschbuch.de/"],
      ["German Is Easy","https://www.germanveryeasy.com/"],
