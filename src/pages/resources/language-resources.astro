---
import Base from '@/layouts/Base.astro';

const collections = ['English', 'IELTS', 'French', 'German', 'Italian'] as const;
type Collection = (typeof collections)[number];
type Format = 'Website' | 'Video' | 'Podcast' | 'PDF' | 'Document';
type Single = [title: string, url: string, format?: Format];
type Provider = { name: string; links: [title: string, url: string, objective: string | null, format: Format | null][] };
type Entry = Single | Provider;

// Collection and objective are inherited from the enclosing group.
const directory: Record<Collection, Record<string, Entry[]>> = {
  "English": {
    "Courses & general learning": [
