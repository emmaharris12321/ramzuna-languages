const sections = collections.map(collection => ({
  collection,
  groups: Object.entries(directory[collection]).map(([name, entries]) => ({
    name,
    entries: entries.map(entry => Array.isArray(entry)
      ? { name: '', links: [{ title: entry[0], url: entry[1], group: name, format: entry[2] ?? 'Website' }] }
      : { name: entry.name, links: entry.links.map(([title, url, goal, format]) => ({
          title, url, group: goal ?? name, format: format ?? 'Website',
        })) })
      .sort((a, b) => (a.name || a.links[0].title).localeCompare(b.name || b.links[0].title)),
  })),
}));
const resources = sections.flatMap(section => section.groups.flatMap(group =>
  group.entries.flatMap(entry => entry.links.map(link => ({ ...link, collection: section.collection })))
));

---

<Base title="Language Resources" description="Browse language learning and IELTS preparation resources by subject and format.">
  <section class="bg-primary-600 py-10 dark:bg-primary-900 lg:py-14">
    <div class="container mx-auto px-4 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap gap-2 text-sm text-primary-100">
        <a href="/" class="hover:text-white">Home</a><span aria-hidden="true">/</span>
        <a href="/resources" class="hover:text-white">Resources</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-white">Languages</span>
      </nav>
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl">Language Resources</h1>
      <p class="mt-3 max-w-2xl text-primary-100">
        Explore {resources.length} resources for language learning, teaching and IELTS preparation.
      </p>
    </div>
  </section>

  <section data-language-directory class="py-8 lg:py-12">
    <div class="container mx-auto max-w-5xl px-4 lg:px-8">
      <div class="mb-6">
        <label for="resource-search" class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Find a resource</label>
        <input id="resource-search" data-search type="search" placeholder="Search titles, skills or formats..."
          class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-gray-700 dark:bg-gray-800 dark:text-white" />
      </div>
      <div aria-label="Resource collections" class="flex flex-wrap gap-2 border-b border-gray-200 pb-4 dark:border-gray-700">
        {['All', ...collections].map(collection => (
          <button type="button" data-collection-filter={collection} aria-pressed={collection === 'English'}
            class="collection-filter rounded-lg px-4 py-2 text-sm font-medium transition-colors">
            {collection}
            <span class="ml-1 text-xs opacity-75">{collection === 'All' ? resources.length : resources.filter(r => r.collection === collection).length}</span>
          </button>
        ))}
      </div>
      <div class="my-5 flex flex-wrap items-end gap-3">
        <div>
          <label for="resource-group" class="mb-1 block text-xs font-medium text-gray-600 dark:text-gray-300">Learning objective</label>
          <select id="resource-group" data-group-filter class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-gray-800 dark:text-white">
            <option value="All">All objectives</option>
            {[...new Set(resources.map(r => r.group))].sort().map(group => <option value={group}>{group}</option>)}
          </select>
        </div>
        <div>
          <label for="resource-format" class="mb-1 block text-xs font-medium text-gray-600 dark:text-gray-300">Format</label>
          <select id="resource-format" data-format-filter class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-gray-800 dark:text-white">
            <option value="All">All formats</option>
            {[...new Set(resources.map(r => r.format))].sort().map(format => <option value={format}>{format}</option>)}
          </select>
        </div>
        <button type="button" data-reset class="rounded-lg px-3 py-2 text-sm font-medium text-primary-700 hover:underline dark:text-primary-300">Reset filters</button>
        <p data-result-count role="status" class="ml-auto py-2 text-sm text-gray-500 dark:text-gray-400">{resources.length} resources</p>
      </div>

      <div class="space-y-10">
        {sections.map(section => (
          <section data-collection={section.collection} class="space-y-5">
            <h2 data-collection-heading class="font-display text-2xl font-semibold text-gray-900 dark:text-white">{section.collection}</h2>
            {section.groups.map(group => (
              <section data-group-section={group.name}>
                <div class="mb-2 flex items-center justify-between gap-2">
                  <h3 class="font-semibold text-gray-800 dark:text-gray-200">{group.name}</h3>
                </div>
                <ul class="divide-y divide-gray-200 overflow-hidden rounded-lg border border-gray-200 bg-white dark:divide-gray-700 dark:border-gray-700 dark:bg-gray-800">
                  {group.entries.map(entry => (
                    <li data-entry>
                      {entry.name && <h4 class="px-4 pt-3 text-sm font-semibold text-gray-900 dark:text-white">{entry.name}</h4>}
                      <ul>
                        {entry.links.map(resource => (
                          <li data-resource data-group={resource.group} data-format={resource.format}
                            data-search-text={`${entry.name} ${resource.title} ${section.collection} ${resource.group} ${resource.format}`.toLowerCase()}>
                            <a href={resource.url} target="_blank" rel="noopener noreferrer"
                              class:list={["group flex items-center gap-3 px-4 text-sm transition-colors hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-500 dark:hover:bg-gray-700/50", entry.name ? "py-1.5 pl-6 text-gray-600 dark:text-gray-300" : "py-3 font-medium text-gray-900 dark:text-white"]}>
                              <span class="min-w-0 flex-1 group-hover:text-primary-700 dark:group-hover:text-primary-300">{resource.title}</span>
                              <span aria-hidden="true" class="shrink-0 text-gray-400">↗</span>
                              <span class="sr-only">(opens in a new tab)</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </section>
        ))}
      </div>
      <div data-empty hidden class="rounded-lg border border-dashed border-gray-300 p-8 text-center text-gray-500 dark:border-gray-700 dark:text-gray-400">
        No resources match your filters. Try another search or reset the filters.
      </div>
    </div>
  </section>
</Base>

<style>
  [data-language-directory] [hidden] { display: none !important; }
  .collection-filter { color: #6b7280; }
  .collection-filter:hover { background: rgb(128 128 128 / 0.12); }
  .collection-filter[aria-pressed="true"] {
    background: #e5e7eb;
    color: #111827;
  }
  :global(.dark) .collection-filter { color: #d1d5db; }
  :global(.dark) .collection-filter[aria-pressed="true"] { background: #374151; color: white; }
</style>

<script>
  function initialiseDirectory(root: HTMLElement) {
    if (root.dataset.initialised) return;
    root.dataset.initialised = 'true';

    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const objective = root.querySelector<HTMLSelectElement>('[data-group-filter]')!;
    const format = root.querySelector<HTMLSelectElement>('[data-format-filter]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-collection-filter]')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-collection]')];
    const resultCount = root.querySelector<HTMLElement>('[data-result-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let active = 'English';

    function updateObjectives() {
      const available = new Set(sections
        .filter(section => active === 'All' || section.dataset.collection === active)
        .flatMap(section => [...section.querySelectorAll<HTMLElement>('[data-resource]')]
          .map(item => item.dataset.group!)));
      for (const option of Array.from(objective.options)) {
        option.hidden = option.value !== 'All' && !available.has(option.value);
        option.disabled = option.hidden;
      }
      if (objective.selectedOptions[0]?.disabled) objective.value = 'All';
    }

    function update() {
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let total = 0;
      for (const section of sections) {
        let sectionCount = 0;
        const collectionMatches = active === 'All' || section.dataset.collection === active;
        for (const group of section.querySelectorAll<HTMLElement>('[data-group-section]')) {
          let groupCount = 0;
          for (const item of group.querySelectorAll<HTMLElement>('[data-resource]')) {
            const matches = collectionMatches
              && (objective.value === 'All' || item.dataset.group === objective.value)
              && (format.value === 'All' || item.dataset.format === format.value)
              && terms.every(term => item.dataset.searchText?.includes(term));
            item.hidden = !matches;
            if (matches) groupCount++;
          }
          group.hidden = groupCount === 0;
          for (const entry of group.querySelectorAll<HTMLElement>('[data-entry]')) {
            entry.hidden = !entry.querySelector('[data-resource]:not([hidden])');
          }
          sectionCount += groupCount;
        }
        section.hidden = sectionCount === 0;
        section.querySelector<HTMLElement>('[data-collection-heading]')!.hidden = active !== 'All';
        total += sectionCount;
      }
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.collectionFilter === active)));
      resultCount.textContent = `${total} resource${total === 1 ? '' : 's'}`;
      empty.hidden = total !== 0;
    }

    buttons.forEach(button => button.addEventListener('click', () => {
      active = button.dataset.collectionFilter!;
      objective.value = 'All';
      updateObjectives();
      update();
    }));
    search.addEventListener('input', update);
    objective.addEventListener('change', update);
    format.addEventListener('change', update);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      active = 'All';
      search.value = '';
      objective.value = 'All';
      format.value = 'All';
      updateObjectives();
      update();
    });
    updateObjectives();
    update();
  }

  const init = () => document.querySelectorAll<HTMLElement>('[data-language-directory]').forEach(initialiseDirectory);
  init();
  document.addEventListener('astro:page-load', init);
</script>

