const sections = collections.map(collection => ({
  collection,
  groups: Object.entries(directory[collection]).map(([name, entries]) => ({
    name,
    entries: entries.map(entry => Array.isArray(entry)
      ? { name: '', links: [{ title: entry[0], url: entry[1], group: name, format: entry[2] ?? 'Website' }] }
      : { name: entry.name, links: entry.links.map(([title, url, goal, format]) => ({
          title, url, group: goal ?? name, format: format ?? 'Website',
        })) })
      .sort((a, b) => (a.name || a.links[0].title).localeCompare(b.name || b.links[0].title)),
  })),
}));
const resources = sections.flatMap(section => section.groups.flatMap(group =>
  group.entries.flatMap(entry => entry.links.map(link => ({ ...link, collection: section.collection })))
));

const host = (url: string) => { try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; } };
const formatStyle: Record<string, string> = {
  Website: 'bg-primary-50 text-primary-700 dark:bg-primary-900/40 dark:text-primary-200',
  Video: 'bg-accent-50 text-accent-700 dark:bg-accent-900/40 dark:text-accent-200',
  Podcast: 'bg-amber-50 text-amber-800 dark:bg-amber-900/30 dark:text-amber-200',
  PDF: 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200',
  Document: 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200',
};
const blurb: Record<string, string> = {
  English: 'Courses, news, podcasts and videos for every level.',
  IELTS: 'Practice materials and tips for each IELTS paper.',
  French: 'Listening, pronunciation and grammar, plus DELF/DALF.',
  German: 'Courses, podcasts and easy-reading, plus Goethe exams.',
  Italian: 'A starter set of podcasts, courses and videos.',
};

const slug = (v: string) => v.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const countLinks = (entries: { links: unknown[] }[]) => entries.reduce((n, e) => n + e.links.length, 0);
---

<Base title="Language Resources" description="Free websites, podcasts and videos for learning English, French, German and Italian, and for IELTS preparation.">
  <section class="page-hero py-12 lg:py-16">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Language Resources</h1>
      <p class="mx-auto mt-3 max-w-xl text-lg text-primary-100">Free websites, podcasts and videos, chosen by our team. Pick a language to start.</p>
      <nav aria-label="Breadcrumb" class="mt-5 flex flex-wrap items-center justify-center gap-2 text-sm text-primary-200">
        <a href="/" class="hover:text-white">Home</a><span aria-hidden="true">/</span>
        <a href="/resources" class="hover:text-white">Resources</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-white">Languages</span>
      </nav>
    </div>
  </section>

  <section data-language-directory class="collection-shell">
    <div>
      <div class="collection-intro"><div><p class="collection-eyebrow">Language learning</p><h2>Browse the directory</h2><p>Choose a language, then explore resources by skill. Search covers every language.</p></div></div>

      <div class="directory-languages" role="group" aria-label="Language">
        {collections.map(collection => (
          <button type="button" data-collection-filter={collection} aria-pressed={collection === 'English'} class="lang-tab">
            {collection}<span>{resources.filter(r => r.collection === collection).length}</span>
          </button>
        ))}
      </div>
      <div class="collection-toolbar collection-panel">
        <div class="collection-field"><label for="resource-search">Search resources</label><input id="resource-search" data-search type="search" placeholder="Name, language or skill" /></div>
        <div class="collection-field"><label for="resource-format">Format</label><select id="resource-format" data-format-filter><option value="">All formats</option>{['Website', 'Video', 'Podcast', 'PDF', 'Document'].map(format => <option value={format}>{format}</option>)}</select></div>
        <button type="button" data-reset class="directory-reset">Reset filters</button>
      </div>
      <div class="directory-summary"><p data-collection-description>{blurb.English}</p><p data-result-count role="status" aria-live="polite"></p></div>
      <div class="mt-8 grid gap-10 lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-8">

        <!-- Step 2 (optional): jump to a skill -->
        <aside class="min-w-0">
          <div class="lg:sticky lg:top-28" data-nav-wrap>
            {sections.map(section => (
              <nav data-collection-nav={section.collection} aria-label={`${section.collection} topics`}>
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Jump to</p>
                <ul class="grid grid-cols-2 gap-1 lg:block lg:space-y-1 border-l-2 border-gray-200 dark:border-gray-700">
                  {section.groups.map(group => (
                    <li>
                      <a href={`#${slug(section.collection)}-${slug(group.name)}`} class="-ml-0.5 flex items-center justify-between gap-2 border-l-2 border-transparent py-1.5 pl-4 pr-1 text-sm text-gray-600 transition-colors hover:border-primary-600 hover:text-primary-700 dark:text-gray-400 dark:hover:border-primary-400 dark:hover:text-primary-300">
                        <span>{group.name}</span>
                        <span class="text-xs text-gray-400">{countLinks(group.entries)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))}
          </div>
        </aside>

        <!-- The list -->
        <div class="min-w-0 space-y-12">
          {sections.map(section => (
            <section data-description={blurb[section.collection]} data-collection={section.collection} class="space-y-10">
              <h2 data-collection-heading hidden class="font-display text-3xl font-semibold text-gray-900 dark:text-white">{section.collection}</h2>
              {section.groups.map(group => (
                <section id={`${slug(section.collection)}-${slug(group.name)}`} data-group-section class="scroll-mt-24">
                  <h3 class="mb-3 flex items-baseline gap-2 font-sans text-lg font-semibold text-gray-900 dark:text-white">
                    {group.name}
                    <span data-group-count class="font-sans text-sm font-normal text-gray-400">{countLinks(group.entries)}</span>
                  </h3>
                  <ul class="collection-panel divide-y divide-gray-200 overflow-hidden dark:divide-gray-700">
                    {group.entries.map(entry => (
                      <li data-entry>
                        {entry.name && <p class="bg-cream-50 px-5 py-2.5 text-sm font-bold text-gray-900 dark:bg-gray-900/50 dark:text-white">{entry.name}</p>}
                        <ul class:list={[entry.name && 'divide-y divide-gray-100 dark:divide-gray-700']}>
                          {entry.links.map(resource => (
                            <li data-resource data-group={resource.group} data-format={resource.format}
                              data-search-text={`${entry.name} ${resource.title} ${section.collection} ${resource.group} ${resource.format}`.toLowerCase()}>
                              <a href={resource.url} target="_blank" rel="noopener noreferrer"
                                class:list={["group flex items-center gap-4 px-5 py-3 transition-colors hover:bg-primary-50/50 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-500 dark:hover:bg-gray-700/50", entry.name && 'pl-8']}>
                                <span class="min-w-0 flex-1">
                                  <span class="block text-sm font-medium text-gray-900 group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">{resource.title}</span>
                                  {!entry.name && <span class="block truncate text-xs text-gray-500 dark:text-gray-400">{host(resource.url)}</span>}
                                </span>
                                {resource.format !== 'Website' && <span class="shrink-0 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300">{resource.format}</span>}
                                <span aria-hidden="true" class="shrink-0 text-gray-400 group-hover:text-primary-600">↗</span>
                                <span class="sr-only">(opens in a new tab)</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </section>
          ))}
          <div data-empty hidden class="rounded-xl border border-dashed border-gray-300 p-10 text-center text-gray-500 dark:border-gray-700 dark:text-gray-400">
            No resources match these filters. Try another search or use Reset to browse again.
          </div>
        </div>
      </div>

      <p class="mt-14 text-center text-sm text-gray-500 dark:text-gray-400">
        Know a great free resource we have missed? <a href="/contact" class="font-semibold text-primary-700 underline hover:no-underline dark:text-primary-300">Let us know</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  [data-language-directory] [hidden] { display: none !important; }
  .directory-languages { display:flex; flex-wrap:wrap; gap:.25rem; border-bottom:1px solid #cbd1c8; margin-bottom:1.5rem; }
  .lang-tab { padding:.8rem 1rem; border-bottom:2px solid transparent; font-size:.9375rem; font-weight:500; color:#626b63; }
  .lang-tab span { margin-left:.5rem; font-size:.75rem; opacity:.7; }
  .lang-tab[aria-pressed="true"] { color:#294936; border-color:#38664f; font-weight:600; }
  .directory-reset { padding:.7rem .4rem; color:#38664f; font-size:.875rem; text-decoration:underline; text-underline-offset:4px; }
  .directory-summary { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.5rem; font-size:.8125rem; color:#626b63; }
  :global(.dark) .directory-summary, :global(.dark) .lang-tab { color:#b6c2b8; }
  :global(.dark) .directory-reset { color:#b4d2bf; }

  :global(.dark) .lang-tab[aria-pressed="true"] { color: #a7cdb8; border-color: #a7cdb8; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>

<script>
  function initialiseDirectory(root: HTMLElement) {
    if (root.dataset.initialised) return;
    root.dataset.initialised = 'true';

    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-collection-filter]')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-collection]')];
    const navs = [...root.querySelectorAll<HTMLElement>('[data-collection-nav]')];
    const status = root.querySelector<HTMLElement>('[data-result-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const format = root.querySelector<HTMLSelectElement>('[data-format-filter]')!;
    const description = root.querySelector<HTMLElement>('[data-collection-description]')!;
    let active = 'English';

    function update() {
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const searching = terms.length > 0;   // searching looks across every language
      let total = 0;
      for (const section of sections) {
        let sectionCount = 0;
        const inScope = searching || section.dataset.collection === active;
        for (const group of section.querySelectorAll<HTMLElement>('[data-group-section]')) {
          let groupCount = 0;
          for (const item of group.querySelectorAll<HTMLElement>('[data-resource]')) {
            const matches = inScope && (!format.value || item.dataset.format === format.value) && terms.every(t => item.dataset.searchText?.includes(t));
            item.hidden = !matches;
            if (matches) groupCount++;
          }
          group.hidden = groupCount === 0;
          const badge = group.querySelector<HTMLElement>('[data-group-count]');
          if (badge) badge.textContent = String(groupCount);
          for (const entry of group.querySelectorAll<HTMLElement>('[data-entry]')) {
            entry.hidden = !entry.querySelector('[data-resource]:not([hidden])');
          }
          sectionCount += groupCount;
        }
        section.hidden = sectionCount === 0;
        section.querySelector<HTMLElement>('[data-collection-heading]')!.hidden = !searching;
        total += sectionCount;
      }
      tabs.forEach(t => t.setAttribute('aria-pressed', String(!searching && t.dataset.collectionFilter === active)));
      navs.forEach(n => (n.hidden = searching || n.dataset.collectionNav !== active));
      description.textContent = searching ? 'Search results across all languages and topics.' : sections.find(s => s.dataset.collection === active)?.dataset.description ?? '';
      status.textContent = `${total} resource${total === 1 ? '' : 's'} ${searching ? 'across all languages' : 'in ' + active}${format.value ? ' · ' + format.value : ''}`;
      empty.hidden = total !== 0;
    }

    tabs.forEach(t => t.addEventListener('click', () => {
      active = t.dataset.collectionFilter!;
      search.value = '';
      update();
    }));
    format.addEventListener('change', update);
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      search.value = '';
      format.value = '';
      update();
      search.focus();
    });
    search.addEventListener('input', update);
    update();
  }

  const init = () => document.querySelectorAll<HTMLElement>('[data-language-directory]').forEach(initialiseDirectory);
  init();
  document.addEventListener('astro:page-load', init);
</script>
