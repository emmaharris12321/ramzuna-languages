const sections = collections.map(collection => ({
  collection,
  groups: Object.entries(directory[collection]).map(([name, entries]) => ({
    name,
    entries: entries.map(entry => Array.isArray(entry)
      ? { name: '', links: [{ title: entry[0], url: entry[1], group: name, format: entry[2] ?? 'Website' }] }
      : { name: entry.name, links: entry.links.map(([title, url, goal, format]) => ({
          title, url, group: goal ?? name, format: format ?? 'Website',
        })) })
      .sort((a, b) => (a.name || a.links[0].title).localeCompare(b.name || b.links[0].title)),
  })),
}));
const resources = sections.flatMap(section => section.groups.flatMap(group =>
  group.entries.flatMap(entry => entry.links.map(link => ({ ...link, collection: section.collection })))
));

const host = (url: string) => { try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; } };
const formatStyle: Record<string, string> = {
  Website: 'bg-primary-50 text-primary-700 dark:bg-primary-900/40 dark:text-primary-200',
  Video: 'bg-accent-50 text-accent-700 dark:bg-accent-900/40 dark:text-accent-200',
  Podcast: 'bg-amber-50 text-amber-800 dark:bg-amber-900/30 dark:text-amber-200',
  PDF: 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200',
  Document: 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200',
};
const blurb: Record<string, string> = {
  English: 'Courses, news, podcasts and videos for every level.',
  IELTS: 'Practice materials and tips for each IELTS paper.',
  French: 'Listening, pronunciation and grammar, plus DELF/DALF.',
  German: 'Courses, podcasts and easy-reading, plus Goethe exams.',
  Italian: 'A starter set of podcasts, courses and videos.',
};

---

<Base title="Language Resources" description="Browse free language learning and IELTS preparation resources by language, skill and format.">
  <section class="page-hero py-14 lg:py-20">
    <div class="container mx-auto px-4 text-center lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Language Resources</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
        {resources.length} hand-picked resources for learning and teaching English, French, German and Italian, and for IELTS preparation.
      </p>
      <nav aria-label="Breadcrumb" class="mt-6 flex flex-wrap items-center justify-center gap-2 text-sm text-primary-200">
        <a href="/" class="hover:text-white">Home</a><span aria-hidden="true">/</span>
        <a href="/resources" class="hover:text-white">Resources</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-white">Languages</span>
      </nav>
    </div>
  </section>

  <section data-language-directory class="py-10 lg:py-14">
    <div class="container mx-auto max-w-6xl px-4 lg:px-8">

      <!-- Language picker -->
      <div aria-label="Resource collections" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {['All', ...collections].map(collection => (
          <button type="button" data-collection-filter={collection} aria-pressed={collection === 'English'}
            class="collection-filter group rounded-xl border p-4 text-left transition-all hover:-translate-y-0.5 hover:shadow-md">
            <span class="block font-display text-2xl font-semibold leading-none">{collection === 'All' ? resources.length : resources.filter(r => r.collection === collection).length}</span>
            <span class="mt-2 block text-sm font-semibold">{collection === 'All' ? 'All resources' : collection}</span>
          </button>
        ))}
      </div>

      <!-- Search & filters -->
      <div class="mt-6 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm sm:p-5 dark:border-gray-700 dark:bg-gray-800">
        <label for="resource-search" class="sr-only">Find a resource</label>
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" /></svg>
          <input id="resource-search" data-search type="search" placeholder="Search by title, skill or format…"
            class="w-full rounded-xl border border-gray-300 bg-cream-50 py-3 pl-12 pr-4 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-gray-600 dark:bg-gray-900 dark:text-white" />
        </div>
        <div class="mt-4 flex flex-wrap items-end gap-3">
          <div>
            <label for="resource-group" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Skill</label>
            <select id="resource-group" data-group-filter class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white">
              <option value="All">All skills</option>
              {[...new Set(resources.map(r => r.group))].sort().map(group => <option value={group}>{group}</option>)}
            </select>
          </div>
          <div>
            <label for="resource-format" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Format</label>
            <select id="resource-format" data-format-filter class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white">
              <option value="All">All formats</option>
              {[...new Set(resources.map(r => r.format))].sort().map(format => <option value={format}>{format}</option>)}
            </select>
          </div>
          <button type="button" data-reset class="rounded-lg px-3 py-2 text-sm font-semibold text-primary-700 hover:underline dark:text-primary-300">Reset filters</button>
          <p data-result-count role="status" class="ml-auto rounded-full bg-primary-50 px-3 py-1 text-sm font-semibold text-primary-700 dark:bg-primary-900/40 dark:text-primary-200">{resources.length} resources</p>
        </div>
      </div>

      <!-- Results -->
      <div class="mt-12 space-y-14">
        {sections.map(section => (
          <section data-collection={section.collection} aria-label={`${section.collection} resources`}>
            <div data-collection-heading class="mb-6 flex items-end justify-between gap-4 border-b-2 border-primary-600 pb-3 dark:border-primary-500">
              <h2 class="font-display text-3xl font-semibold text-gray-900 dark:text-white">{section.collection}</h2>
              <p class="hidden text-sm text-gray-500 sm:block dark:text-gray-400">{blurb[section.collection]}</p>
            </div>
            <div class="space-y-9">
              {section.groups.map(group => (
                <section data-group-section={group.name}>
                  <h3 class="mb-3 flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-accent-600 dark:text-accent-300">
                    {group.name}
                    <span data-group-count class="rounded-full bg-accent-50 px-2 py-0.5 text-xs font-semibold normal-case tracking-normal text-accent-700 dark:bg-accent-900/40 dark:text-accent-200">{group.entries.reduce((n, e) => n + e.links.length, 0)}</span>
                  </h3>
                  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    {group.entries.map(entry => (
                      <li data-entry class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md dark:border-gray-700 dark:bg-gray-800">
                        {entry.name && (
                          <h4 class="border-b border-gray-100 bg-cream-50 px-4 py-2.5 text-sm font-bold text-gray-900 dark:border-gray-700 dark:bg-gray-900/60 dark:text-white">{entry.name}</h4>
                        )}
                        <ul class:list={[entry.name && 'divide-y divide-gray-100 dark:divide-gray-700', !entry.name && 'h-full']}>
                          {entry.links.map(resource => (
                            <li data-resource data-group={resource.group} data-format={resource.format}
                              class:list={[!entry.name && 'h-full']}
                              data-search-text={`${entry.name} ${resource.title} ${section.collection} ${resource.group} ${resource.format}`.toLowerCase()}>
                              <a href={resource.url} target="_blank" rel="noopener noreferrer"
                                class:list={["group flex gap-3 px-4 transition-colors hover:bg-primary-50/60 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-500 dark:hover:bg-gray-700/50",
                                  entry.name ? "items-center justify-between py-2.5 text-sm" : "h-full flex-col justify-between py-4"]}>
                                <span class="min-w-0">
                                  <span class:list={["block font-semibold leading-snug text-gray-900 group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300", !entry.name && "text-[0.95rem]"]}>{resource.title}</span>
                                  {!entry.name && <span class="mt-1 block truncate text-xs text-gray-500 dark:text-gray-400">{host(resource.url)}</span>}
                                </span>
                                <span class:list={["flex shrink-0 items-center gap-2", !entry.name && "mt-3 justify-between"]}>
                                  <span class:list={["rounded-full px-2 py-0.5 text-xs font-semibold", formatStyle[resource.format]]}>{resource.format}</span>
                                  <span aria-hidden="true" class="text-gray-400 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
                                </span>
                                <span class="sr-only">(opens in a new tab)</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </section>
        ))}
      </div>
      <div data-empty hidden class="mt-10 rounded-2xl border border-dashed border-gray-300 p-10 text-center text-gray-500 dark:border-gray-700 dark:text-gray-400">
        No resources match your filters. Try another search or reset the filters.
      </div>

      <p class="mt-14 text-center text-sm text-gray-500 dark:text-gray-400">
        Know a great free resource we have missed? <a href="/contact" class="font-semibold text-primary-700 underline hover:no-underline dark:text-primary-300">Let us know</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  [data-language-directory] [hidden] { display: none !important; }
  .collection-filter {
    background: #fff;
    border-color: #e5e7eb;
    color: #374151;
  }
  .collection-filter[aria-pressed="true"] {
    background: #38664f;
    border-color: #38664f;
    color: #fff;
    box-shadow: 0 6px 16px -6px rgba(56, 102, 79, 0.6);
  }
  :global(.dark) .collection-filter { background: #1f2937; border-color: #374151; color: #d1d5db; }
  :global(.dark) .collection-filter[aria-pressed="true"] { background: #38664f; border-color: #4b7d65; color: #fff; }
</style>

<script>
  function initialiseDirectory(root: HTMLElement) {
    if (root.dataset.initialised) return;
    root.dataset.initialised = 'true';

    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const objective = root.querySelector<HTMLSelectElement>('[data-group-filter]')!;
    const format = root.querySelector<HTMLSelectElement>('[data-format-filter]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-collection-filter]')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-collection]')];
    const resultCount = root.querySelector<HTMLElement>('[data-result-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let active = 'English';

    function updateObjectives() {
      const available = new Set(sections
        .filter(section => active === 'All' || section.dataset.collection === active)
        .flatMap(section => [...section.querySelectorAll<HTMLElement>('[data-resource]')]
          .map(item => item.dataset.group!)));
      for (const option of Array.from(objective.options)) {
        option.hidden = option.value !== 'All' && !available.has(option.value);
        option.disabled = option.hidden;
      }
      if (objective.selectedOptions[0]?.disabled) objective.value = 'All';
    }

    function update() {
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let total = 0;
      for (const section of sections) {
        let sectionCount = 0;
        const collectionMatches = active === 'All' || section.dataset.collection === active;
        for (const group of section.querySelectorAll<HTMLElement>('[data-group-section]')) {
          let groupCount = 0;
          for (const item of group.querySelectorAll<HTMLElement>('[data-resource]')) {
            const matches = collectionMatches
              && (objective.value === 'All' || item.dataset.group === objective.value)
              && (format.value === 'All' || item.dataset.format === format.value)
              && terms.every(term => item.dataset.searchText?.includes(term));
            item.hidden = !matches;
            if (matches) groupCount++;
          }
          group.hidden = groupCount === 0;
          const badge = group.querySelector<HTMLElement>('[data-group-count]');
          if (badge) badge.textContent = String(groupCount);
          for (const entry of group.querySelectorAll<HTMLElement>('[data-entry]')) {
            entry.hidden = !entry.querySelector('[data-resource]:not([hidden])');
          }
          sectionCount += groupCount;
        }
        section.hidden = sectionCount === 0;
        section.querySelector<HTMLElement>('[data-collection-heading]')!.hidden = false;
        total += sectionCount;
      }
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.collectionFilter === active)));
      resultCount.textContent = `${total} resource${total === 1 ? '' : 's'}`;
      empty.hidden = total !== 0;
    }

    buttons.forEach(button => button.addEventListener('click', () => {
      active = button.dataset.collectionFilter!;
      objective.value = 'All';
      updateObjectives();
      update();
    }));
    search.addEventListener('input', update);
    objective.addEventListener('change', update);
    format.addEventListener('change', update);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      active = 'All';
      search.value = '';
      objective.value = 'All';
      format.value = 'All';
      updateObjectives();
      update();
    });
    updateObjectives();
    update();
  }

  const init = () => document.querySelectorAll<HTMLElement>('[data-language-directory]').forEach(initialiseDirectory);
  init();
  document.addEventListener('astro:page-load', init);
</script>

