---
interface Props {
  badge?: string;
  title: string;
  titleHighlight?: string;
  titleRotate?: string[];
  description: string;
  primaryCta?: { text: string; url: string };
  secondaryCta?: { text: string; url: string; icon?: boolean };
  stats?: { value: string; label: string }[];
  image?: string;
  note?: string;
}

const {
  badge,
  title,
  titleHighlight,
  titleRotate,
  description,
  primaryCta,
  secondaryCta,
  stats,
  image,
  note,
} = Astro.props;
---

<section
  class="relative overflow-hidden bg-gradient-to-b from-primary-50 to-white dark:from-gray-900 dark:to-gray-950"
>
  <div class="container mx-auto px-4 py-20 lg:px-8 lg:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Content -->
      <div>
        {
          badge && (
            <div
              class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary-200 bg-primary-50 px-4 py-1.5 text-sm font-medium text-primary-700 dark:border-primary-800 dark:bg-primary-900/50 dark:text-primary-300"
              data-animate="fade-in-up"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              {badge}
            </div>
          )
        }

        <h1
          class="font-display text-3xl font-semibold text-gray-900 sm:text-4xl lg:text-5xl dark:text-white"
          data-animate="fade-in-up"
          data-delay="100"
        >
          <Fragment set:html={title} />
          {
            titleHighlight && (
              <>
                <br />
                <span class="text-gradient" data-typewriter={titleRotate ? JSON.stringify(titleRotate) : undefined}>{titleHighlight}</span>
              </>
            )
          }
        </h1>

        <p
          class="mt-6 max-w-xl text-lg text-gray-600 dark:text-gray-400"
          data-animate="fade-in-up"
          data-delay="200"
        >
          {description}
        </p>

        <div
          class="mt-10 flex flex-col gap-4 sm:flex-row"
          data-animate="fade-in-up"
          data-delay="300"
        >
          {
            primaryCta && (
              <a
                href={primaryCta.url}
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent-500 px-7 py-3.5 text-base font-medium text-white shadow-lg shadow-accent-500/25 transition-all hover:bg-accent-600 hover:shadow-xl hover:shadow-accent-500/30"
              >
                {primaryCta.text}
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            )
          }
          {
            secondaryCta && (
              <a
                href={secondaryCta.url}
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-7 py-3.5 text-base font-medium text-gray-700 transition-colors hover:bg-cream-100 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800"
              >
                <svg
                  class="h-5 w-5 text-primary-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  />
                </svg>
                {secondaryCta.text}
              </a>
            )
          }
        </div>

        {
          note && (
            <p
              class="mt-4 text-sm text-gray-500 dark:text-gray-500"
              data-animate="fade-in-up"
              data-delay="350"
            >
              {note}
            </p>
          )
        }

        {
          stats && stats.length > 0 && (
            <div
              class="mt-14 grid grid-cols-2 gap-6 sm:grid-cols-4"
              data-animate="fade-in-up"
              data-delay="400"
            >
              {stats.map((stat) => (
                <div>
                  <div class="text-3xl font-bold text-gray-900 dark:text-white">
                    {stat.value}
                  </div>
                  <div class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                    {stat.label}
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </div>

      <!-- Hero Image -->
      {
        image && (
          <div
            class="relative"
            data-animate="fade-in-up"
            data-delay="300"
          >
            <div class="relative overflow-hidden rounded-2xl shadow-2xl ring-1 ring-gray-200 dark:ring-gray-800">
              <img
                src={image}
                alt="Students learning languages online with volunteer educators"
                class="h-auto w-full object-cover"
                loading="eager"
              />
            </div>
            <!-- Floating badge -->
            <div class="absolute -bottom-4 -left-4 rounded-xl bg-white p-4 shadow-lg dark:bg-gray-800 sm:-bottom-6 sm:-left-6">
              <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-100 dark:bg-primary-900/50">
                  <svg class="h-6 w-6 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-900 dark:text-white">100% Free</div>
                  <div class="text-xs text-gray-500 dark:text-gray-400">No cost to students, ever</div>
                </div>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
