---
interface Props {
  badge?: string;
  title: string;
  titleHighlight?: string;
  titleRotate?: string[];
  description: string;
  primaryCta?: { text: string; url: string };
  secondaryCta?: { text: string; url: string; icon?: boolean };
  stats?: { value: string; label: string }[];
  image?: string;
  note?: string;
}

const {
  badge,
  title,
  titleHighlight,
  titleRotate,
  description,
  primaryCta,
  secondaryCta,
  stats,
  image,
  note,
} = Astro.props;
---

<section
  class="relative overflow-hidden bg-gradient-to-b from-primary-50 via-cream-100 to-cream-200 dark:from-gray-900 dark:via-gray-900 dark:to-gray-950"
>
  <div class="container mx-auto px-4 py-10 sm:py-12 lg:px-8 lg:py-14">
    <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
      <!-- Content -->
      <div>
        {
          badge && (
            <div
              class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary-200 bg-primary-50 px-4 py-1.5 text-sm font-medium text-primary-700 dark:border-primary-800 dark:bg-primary-900/50 dark:text-primary-300"
              data-animate="fade-in-up"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              {badge}
            </div>
          )
        }

        <h1
          class="font-display text-[2rem] font-semibold leading-[1.15] tracking-tight text-gray-900 sm:text-4xl lg:text-5xl dark:text-white"
          data-animate="fade-in-up"
          data-delay="100"
        >
          <Fragment set:html={title} />
          {
            titleHighlight && (
              <>
                <br />
                <span class="text-gradient" data-typewriter={titleRotate ? JSON.stringify(titleRotate) : undefined}>{titleHighlight}</span>
              </>
            )
          }
        </h1>

        <p
          class="mt-6 max-w-xl text-lg leading-relaxed text-gray-700 lg:text-xl lg:leading-relaxed dark:text-gray-300"
          data-animate="fade-in-up"
          data-delay="200"
        >
          {description}
        </p>

        <div
          class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4 lg:mt-10"
          data-animate="fade-in-up"
          data-delay="300"
        >
          {
            primaryCta && (
              <a
                href={primaryCta.url}
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent-500 px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-accent-500/25 transition-all hover:-translate-y-0.5 hover:bg-accent-600 hover:shadow-xl hover:shadow-accent-500/30 focus-visible:outline-accent-500"
              >
                {primaryCta.text}
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            )
          }
          {
            secondaryCta && (
              <a
                href={secondaryCta.url}
                target={secondaryCta.url.startsWith('http') ? '_blank' : undefined}
                rel={secondaryCta.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-7 py-3.5 text-base font-semibold text-gray-800 transition-all hover:-translate-y-0.5 hover:border-gray-400 hover:bg-white hover:shadow-md dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:bg-gray-800"
              >
                {
                  secondaryCta.icon && (
                    <svg
                      class="h-5 w-5 text-primary-600"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                      />
                    </svg>
                  )
                }
                {secondaryCta.text}
              </a>
            )
          }
        </div>

        {
          note && (
            <div
              class="mt-6 flex max-w-xl gap-3 rounded-xl border border-accent-200 bg-white/70 p-4 text-sm leading-relaxed text-gray-700 shadow-sm dark:border-accent-900/60 dark:bg-gray-800/60 dark:text-gray-300"
              role="note"
              data-animate="fade-in-up"
              data-delay="350"
            >
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-accent-500 dark:text-accent-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p>{note}</p>
            </div>
          )
        }

        {
          stats && stats.length > 0 && (
            <div
              class="mt-10 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-gray-200 pt-8 sm:grid-cols-4 lg:mt-12 dark:border-gray-800"
              data-animate="fade-in-up"
              data-delay="400"
            >
              {stats.map((stat) => (
                <div>
                  <div class="font-display text-3xl font-semibold text-primary-600 dark:text-primary-300">
                    {stat.value}
                  </div>
                  <div class="mt-1 text-sm leading-snug text-gray-600 dark:text-gray-400">
                    {stat.label}
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </div>

      <!-- Hero Image -->
      {
        image && (
          <div
            class="relative"
            data-animate="fade-in-up"
            data-delay="300"
          >
            <div class="relative overflow-hidden rounded-2xl shadow-soft-xl ring-1 ring-black/5 dark:ring-white/10">
              <img
                src={image}
                alt="Students learning languages online with volunteer educators"
                class="h-auto w-full object-cover"
                loading="eager"
              />
            </div>
            <!-- Floating badge -->
            <div class="absolute -bottom-5 left-4 rounded-xl bg-white p-3.5 shadow-soft-lg ring-1 ring-black/5 sm:p-4 lg:-left-6 dark:bg-gray-800 dark:ring-white/10">
              <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-100 dark:bg-primary-900/50">
                  <svg class="h-6 w-6 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-900 dark:text-white">100% Free</div>
                  <div class="text-xs text-gray-500 dark:text-gray-400">No cost to students, ever</div>
                </div>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
