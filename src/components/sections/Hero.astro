---
interface Props {
  badge?: string;
  title: string;
  titleHighlight?: string;
  titleRotate?: string[];
  description: string;
  primaryCta?: { text: string; url: string };
  secondaryCta?: { text: string; url: string; icon?: boolean };
  stats?: { value: string; label: string }[];
  image?: string;
  note?: string;
}
const { badge, title, titleHighlight, description, primaryCta, secondaryCta, stats, image, note } = Astro.props;
---
<section class="home-hero">
  <div class="hero-wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        {badge && <p class="hero-eyebrow"><span aria-hidden="true"></span>{badge}</p>}
        <h1><Fragment set:html={title} />{titleHighlight && <span>{titleHighlight}</span>}</h1>
        <p class="hero-description">{description}</p>
        <div class="hero-actions">
          {primaryCta && <a class="hero-primary" href={primaryCta.url}>{primaryCta.text}<span aria-hidden="true">→</span></a>}
          {secondaryCta && <a class="hero-secondary" href={secondaryCta.url}>{secondaryCta.text}<span aria-hidden="true">↗</span></a>}
        </div>
        {note && <p class="hero-note">{note}</p>}
      </div>
      {image && <figure class="hero-art">
        <img src={image} alt="English, French and German language bubbles around a globe" width="800" height="600" loading="eager" fetchpriority="high" />
        <figcaption>Connecting Palestinian students with educators worldwide.</figcaption>
      </figure>}
    </div>
    {stats && stats.length > 0 && <dl class="hero-stats">
      {stats.map(stat => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
    </dl>}
  </div>
</section>
<style>
  .home-hero { background: #fbf8f3; border-bottom: 1px solid #e5e5dc; }
  .hero-wrap { width: min(1120px, calc(100% - 48px)); margin: auto; padding-top: clamp(36px, 5vw, 68px); }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .hero-eyebrow { display: flex; align-items: center; gap: 9px; color: #38664f; font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 18px; }
  .hero-eyebrow span { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  h1 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(2.15rem, 3.5vw, 3rem); font-weight: 500; line-height: 1.15; letter-spacing: -.035em; color: #282e28; text-wrap: balance; }
  h1 span { display: block; color: #38664f; }
  .hero-description { max-width: 31rem; margin-top: 20px; font-size: 1.0625rem; line-height: 1.75; color: #535c54; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 26px; }
  .hero-actions a { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 44px; font-size: .875rem; font-weight: 600; text-decoration: none; }
  .hero-primary { background: #7a222b; color: white; padding: 12px 20px; border-radius: 6px; }
  .hero-primary:hover { background: #621c23; }
  .hero-secondary { color: #38664f; padding: 10px 0; }
  .hero-secondary:hover { text-decoration: underline; text-underline-offset: 4px; }
  .hero-note { max-width: 31rem; margin-top: 22px; padding-left: 12px; border-left: 2px solid #c9b6a5; font-size: .8125rem; line-height: 1.6; color: #65645e; }
  .hero-art { margin: 0; }
  .hero-art img { display: block; width: 100%; height: auto; border: 1px solid #e7e0d4; border-radius: 12px; }
  figcaption { margin-top: 12px; font-size: .75rem; line-height: 1.5; color: #65645e; text-align: center; }
  .hero-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 40px; padding: 24px 0; border-top: 1px solid #e0e2d8; }
  .hero-stats div { display: flex; flex-direction: column-reverse; gap: 3px; }
  .hero-stats dt { font-size: .75rem; color: #65645e; }
  .hero-stats dd { font-size: 1.625rem; font-weight: 500; line-height: 1.2; color: #38664f; font-variant-numeric: tabular-nums; }
  :global(.dark) .home-hero { background: #17241e; border-color: #34473a; }
  :global(.dark) h1 { color: #f7f1e8; }
  :global(.dark) :is(h1 span, .hero-eyebrow, .hero-secondary, .hero-stats dd) { color: #afcdb4; }
  :global(.dark) :is(.hero-description, .hero-note, figcaption, .hero-stats dt) { color: #bdc8be; }
  :global(.dark) .hero-stats { border-color: #34473a; }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .hero-art { max-width: 400px; width: 100%; margin-inline: auto; }
    .hero-stats { grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 28px; }
  }
</style>
