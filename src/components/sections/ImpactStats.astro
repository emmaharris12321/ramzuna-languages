---
// Big, high-contrast impact numbers shown directly under the hero.
// Real values are rendered in the HTML (works without JS); a small script
// counts numeric values up when the band scrolls into view.
interface Item {
  value: string;
  label: string;
  note?: string;
  icon?: 'clock' | 'book' | 'globe' | 'group';
}

interface Props {
  badge?: string;
  title?: string;
  description?: string;
  items: Item[];
  link?: { text: string; url: string };
}

const { badge, title, description, items, link } = Astro.props;

const icons: Record<string, string> = {
  clock: 'M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z',
  book: 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
  globe: 'M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.5-2.4 3.75-5.4 3.75-9S14.5 5.4 12 3m0 18c-2.5-2.4-3.75-5.4-3.75-9S9.5 5.4 12 3M3.6 9h16.8M3.6 15h16.8',
  group: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
};

// Split "930" -> numeric 930 (animatable); "1:4" stays static text.
const parse = (v: string) => {
  const m = v.match(/^(\d+(?:\.\d+)?)(\D*)$/);
  return m ? { n: m[1], suffix: m[2] } : null;
};
---

<section id="impact" class="impact-band py-6 text-white lg:py-7" aria-label={title || 'Our impact'}>
  <div class="container mx-auto px-4 lg:px-8">
    <ul class="grid grid-cols-2 gap-y-5 sm:grid-cols-4 sm:divide-x sm:divide-white/20">
      {
        items.map((item) => {
          const parsed = parse(item.value);
          return (
            <li class="px-3 text-center" title={item.note}>
              <p class="font-display text-2xl font-semibold leading-none text-white sm:text-3xl">
                {parsed ? (
                  <span data-impact-count={parsed.n} data-suffix={parsed.suffix}>{item.value}</span>
                ) : (
                  <span>{item.value}</span>
                )}
              </p>
              <p class="mt-1.5 text-xs font-medium uppercase tracking-wide text-white/85 sm:text-sm">{item.label}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* Same deep green + maroon rule as the page headers, so the band reads as
     part of one system but stands out clearly from the cream hero above it. */
  .impact-band {
    background-color: #38664f;
    background-image:
      radial-gradient(48rem 22rem at 90% -20%, rgba(255, 255, 255, 0.14), transparent 62%),
      radial-gradient(36rem 20rem at -5% 120%, rgba(0, 0, 0, 0.2), transparent 60%),
      linear-gradient(180deg, #3d6c55 0%, #38664f 60%, #315c47 100%);
    border-top: 3px solid #7a222b;
    border-bottom: 3px solid #7a222b;
  }
  :global(.dark) .impact-band {
    background-image:
      radial-gradient(48rem 22rem at 90% -20%, rgba(255, 255, 255, 0.08), transparent 62%),
      linear-gradient(180deg, #2f5742 0%, #29503b 100%);
  }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-impact-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (els.length && !reduce && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.impactCount || '0');
      const suffix = el.dataset.suffix || '';
      const start = performance.now();
      const dur = 1600;
      const tick = (now: number) => {
        const p = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased) + (p < 1 ? '' : suffix);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = target + suffix;
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            run(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    els.forEach((el) => io.observe(el));
  }
</script>
