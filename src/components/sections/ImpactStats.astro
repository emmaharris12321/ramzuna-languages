---
// Big, high-contrast impact numbers shown directly under the hero.
// Real values are rendered in the HTML (works without JS); a small script
// counts numeric values up when the band scrolls into view.
interface Item {
  value: string;
  label: string;
  note?: string;
  icon?: 'clock' | 'book' | 'globe' | 'group';
}

interface Props {
  badge?: string;
  title?: string;
  description?: string;
  items: Item[];
  link?: { text: string; url: string };
}

const { badge, title, description, items, link } = Astro.props;

const icons: Record<string, string> = {
  clock: 'M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z',
  book: 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
  globe: 'M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.5-2.4 3.75-5.4 3.75-9S14.5 5.4 12 3m0 18c-2.5-2.4-3.75-5.4-3.75-9S9.5 5.4 12 3M3.6 9h16.8M3.6 15h16.8',
  group: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
};

// Split "930" -> numeric 930 (animatable); "1:4" stays static text.
const parse = (v: string) => {
  const m = v.match(/^(\d+(?:\.\d+)?)(\D*)$/);
  return m ? { n: m[1], suffix: m[2] } : null;
};
---

<section id="impact" class="impact-band relative overflow-hidden py-12 text-white lg:py-16" aria-labelledby="impact-title">
  <div class="container relative mx-auto px-4 lg:px-8">
    {
      (badge || title || description) && (
        <div class="mx-auto max-w-3xl text-center">
          {badge && (
            <div class="mb-4 inline-flex items-center rounded-full border border-white/25 bg-white/10 px-3 py-1 text-sm font-medium text-white">
              {badge}
            </div>
          )}
          {title && (
            <h2 id="impact-title" class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              {title}
            </h2>
          )}
          {description && <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-white/85">{description}</p>}
        </div>
      )
    }

    <ul class="mt-10 grid grid-cols-2 gap-4 sm:gap-5 lg:mt-12 lg:grid-cols-4">
      {
        items.map((item, i) => {
          const parsed = parse(item.value);
          return (
            <li
              class="impact-card group relative flex flex-col rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur-sm sm:p-6"
              data-animate="fade-in-up"
              data-delay={i * 100}
            >
              {item.icon && icons[item.icon] && (
                <span class="mb-3 flex h-9 w-9 items-center justify-center rounded-full bg-white/15 text-white">
                  <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={icons[item.icon]} />
                  </svg>
                </span>
              )}
              <p class="order-1 font-display text-4xl font-semibold leading-none tracking-tight text-white sm:text-5xl">
                {parsed ? (
                  <span data-impact-count={parsed.n} data-suffix={parsed.suffix}>{item.value}</span>
                ) : (
                  <span>{item.value}</span>
                )}
              </p>
              <p class="order-2 mt-2.5 text-base font-semibold text-white">{item.label}</p>
              {item.note && <p class="order-3 mt-1.5 text-sm leading-snug text-white/75">{item.note}</p>}
              <span class="order-4 mt-4 block h-1 w-10 rounded-full bg-accent-300 transition-all group-hover:w-16" aria-hidden="true" />
            </li>
          );
        })
      }
    </ul>

    {
      link && (
        <p class="mt-10 text-center">
          <a href={link.url} class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/10">
            {link.text} <span aria-hidden="true">→</span>
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  /* Same deep green + maroon rule as the page headers, so the band reads as
     part of one system but stands out clearly from the cream hero above it. */
  .impact-band {
    background-color: #38664f;
    background-image:
      radial-gradient(48rem 22rem at 90% -20%, rgba(255, 255, 255, 0.14), transparent 62%),
      radial-gradient(36rem 20rem at -5% 120%, rgba(0, 0, 0, 0.2), transparent 60%),
      linear-gradient(180deg, #3d6c55 0%, #38664f 60%, #315c47 100%);
    border-top: 3px solid #7a222b;
    border-bottom: 3px solid #7a222b;
  }
  .impact-card {
    transition: transform 0.25s ease, background-color 0.25s ease;
  }
  .impact-card:hover {
    transform: translateY(-3px);
    background-color: rgba(255, 255, 255, 0.16);
  }
  :global(.dark) .impact-band {
    background-image:
      radial-gradient(48rem 22rem at 90% -20%, rgba(255, 255, 255, 0.08), transparent 62%),
      linear-gradient(180deg, #2f5742 0%, #29503b 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .impact-card { transition: none; }
    .impact-card:hover { transform: none; }
  }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-impact-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (els.length && !reduce && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.impactCount || '0');
      const suffix = el.dataset.suffix || '';
      const start = performance.now();
      const dur = 1600;
      const tick = (now: number) => {
        const p = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased) + (p < 1 ? '' : suffix);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = target + suffix;
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            run(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    els.forEach((el) => io.observe(el));
  }
</script>
