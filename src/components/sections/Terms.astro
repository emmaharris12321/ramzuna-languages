---
interface Term {
  name: string;
  dates: string;
  tbd?: boolean;
}

interface Props {
  badge?: string;
  title: string;
  description: string;
  terms: Term[];
}

const { badge, title, description, terms } = Astro.props;

---
<section id="terms" class="teaching-year">
  <div class="terms-wrap">
    <header>
      {badge && <p class="terms-eyebrow">{badge}</p>}
      <h2>{title}</h2>
      <p class="terms-description">{description}</p>
    </header>
    <dl class="terms-list">
      {terms.map(term => <div>
        <dt>{term.name}</dt>
        <dd class:list={{ 'is-pending': term.tbd }}>{term.dates}</dd>
      </div>)}
    </dl>
  </div>
</section>
<style>
  .teaching-year { background: #fbf8f3; border-block: 1px solid #e3e4da; padding: 36px 0; }
  .terms-wrap { width: min(1120px, calc(100% - 48px)); margin: auto; display: grid; grid-template-columns: 1fr 1.6fr; align-items: center; gap: 40px; }
  .terms-eyebrow { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; font-weight: 600; color: #38664f; margin-bottom: 8px; }
  h2 { font: 500 1.75rem/1.2 'Playfair Display', Georgia, serif; color: #282e28; }
  .terms-description { font-size: .875rem; line-height: 1.65; color: #535c54; margin-top: 12px; }
  .terms-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .terms-list div { padding-left: 16px; border-left: 2px solid #d3dfd3; }
  dt { font-size: .9375rem; font-weight: 600; color: #38664f; }
  dd { margin-top: 8px; font-size: .8125rem; line-height: 1.6; color: #535c54; }
  .is-pending { font-style: italic; }
  :global(.dark) .teaching-year { background: #17241e; border-color: #34473a; }
  :global(.dark) :is(h2, dt, .terms-eyebrow) { color: #afcdb4; }
  :global(.dark) :is(dd, .terms-description) { color: #bdc8be; }
  @media (max-width: 800px) { .terms-wrap { grid-template-columns: 1fr; gap: 24px; } }
  @media (max-width: 480px) { .terms-list { grid-template-columns: 1fr; gap: 20px; } }
</style>
