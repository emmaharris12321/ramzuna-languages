---
interface Props {
  showTeach?: boolean;
  showInvolved?: boolean;
}

const { showTeach = true, showInvolved = true } = Astro.props;
---

<style>
  .ramzuna-programmes,
  .ramzuna-programmes * {
    box-sizing: border-box;
  }

  .ramzuna-programmes {
    width: min(1120px, calc(100% - 48px));
    max-width: 1120px;
    margin: 0 auto;
    background: #f7f1e8;
    color: #2a2622;
    font-family: 'Outfit', system-ui, sans-serif;
    -webkit-text-size-adjust: 100%;
    container-type: inline-size;
  }

  .ramzuna-programmes .rz-section {
    width: 100%;
    padding: 48px 0;
  }

  .ramzuna-programmes .rz-wrap {
    width: 100%;
    margin: 0 auto;
  }

  .ramzuna-programmes .rz-head {
    margin: 0 0 28px;
    text-align: center;
  }

  .ramzuna-programmes .rz-eyebrow {
    display: inline-flex;
    align-items: center;
    margin: 0 0 10px;
    padding: 0;
    border-radius: 9999px;
    background: transparent;
    color: #38664f;
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    font-weight: 500;
    line-height: 1.5;
  }

  .ramzuna-programmes .rz-head h2 {
    margin: 0;
    color: #38664f;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.25;
  }

  @media (min-width: 640px) {
    .ramzuna-programmes .rz-head h2 {
      font-size: 2rem;
    }
  }

  .ramzuna-programmes .rz-closed-note {
    margin: 10px 0 0;
    color: #7a222b;
    font-size: 14px;
    font-weight: 600;
  }

  .ramzuna-programmes .rz-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 20px;
    width: 100%;
  }

  .ramzuna-programmes .rz-card {
    --rz-accent: #7a222b;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    padding: 24px;
    border: 1px solid rgba(122, 34, 43, 0.12);
    border-radius: 10px;
    background: #fffdfa;
    box-shadow: 0 4px 14px rgba(42, 38, 34, 0.035);
  }

  .ramzuna-programmes .rz-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    margin-bottom: 16px;
    border-radius: 12px;
    background: rgba(122, 34, 43, 0.08);
    font-size: 23px;
    line-height: 1;
  }

  .ramzuna-programmes .rz-card h3 {
    margin: 0 0 12px;
    color: var(--rz-accent);
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-description {
    margin: 0 0 20px;
    color: #514b44;
    font-size: 16px;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: auto;
  }

  .ramzuna-programmes .rz-links::before {
    content: "";
    display: block;
    width: 36px;
    height: 2px;
    margin-bottom: 10px;
    background: var(--rz-accent);
    opacity: 0.35;
  }

  .ramzuna-programmes .rz-link {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 9px;
    width: fit-content;
    min-height: 44px;
    padding: 10px 0;
    color: var(--rz-accent);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    touch-action: manipulation;
  }

  .ramzuna-programmes .rz-link-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: 9px;
    width: fit-content;
    max-width: 100%;
    min-height: 44px;
    margin-top: auto;
    padding: 10px 15px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--rz-accent);
    color: #fff;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    touch-action: manipulation;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-arrow {
    flex-shrink: 0;
    font-size: 19px;
    line-height: 1;
  }

  .ramzuna-programmes .rz-link:focus-visible,
  .ramzuna-programmes .rz-button:focus-visible {
    outline: 3px solid var(--rz-accent);
    outline-offset: 4px;
  }

  .ramzuna-programmes .rz-green {
    --rz-accent: #38664f;
    background: #eaf0e9;
    border-color: #d3dfd3;
  }

  .ramzuna-programmes .rz-green .rz-icon {
    background: #d9e6da;
  }

  .ramzuna-programmes .rz-maroon {
    background: #7a222b;
    border-color: #7a222b;
  }

  .ramzuna-programmes .rz-maroon .rz-icon {
    background: rgba(255, 255, 255, 0.12);
  }

  .ramzuna-programmes .rz-maroon h3 {
    color: #fff;
  }

  .ramzuna-programmes .rz-maroon .rz-description {
    color: #f5e9e9;
  }

  .ramzuna-programmes .rz-maroon .rz-button {
    background: #fffdfa;
    color: #7a222b;
  }

  .ramzuna-programmes .rz-maroon .rz-button:focus-visible {
    outline-color: #fff;
  }

  @container (max-width: 879px) {
    .ramzuna-programmes .rz-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ramzuna-programmes .rz-card {
      padding: 24px 20px;
    }
  }

  @media (max-width: 600px) {
    .ramzuna-programmes .rz-section {
      padding: 30px 0;
    }

    .ramzuna-programmes .rz-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ramzuna-programmes .rz-card {
      padding: 24px 20px;
    }
  }

  @supports not (container-type: inline-size) {
    @media (max-width: 960px) {
      .ramzuna-programmes .rz-grid {
        grid-template-columns: 1fr;
      }
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .ramzuna-programmes .rz-link:hover,
    .ramzuna-programmes .rz-button:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  :global(.dark) .ramzuna-programmes { background: #030712; color: #e5e7eb; }
  :global(.dark) .ramzuna-programmes .rz-card { background: #18251e; border-color: #34473a; }
  :global(.dark) .ramzuna-programmes :is(h3, .rz-link, .rz-eyebrow, .rz-head h2) { color: #afcdb4; }
  :global(.dark) .ramzuna-programmes .rz-description { color: #c2cdc4; }
  :global(.dark) .ramzuna-programmes .rz-maroon { background: #64232a; }
  .ramzuna-programmes .rz-icon { color: var(--rz-accent); }
  .ramzuna-programmes .rz-maroon .rz-icon { color: white; }
</style>

<div class="ramzuna-programmes">
  {showTeach && (
    <section class="rz-section" aria-label="How we teach">
      <div class="rz-wrap">
        <header class="rz-head">
          <p class="rz-eyebrow">Language Lab</p>
          <h2>How We Teach</h2>
        </header>

        <div class="rz-grid">
          <article class="rz-card">
            <div class="rz-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-5 9 5-9 5-9-5Zm4 3v5c3 3 7 3 10 0v-5M21 9v7" /></svg></div>
            <h3>Language Lessons & Conversations</h3>
            <p class="rz-description">
              Empowering Palestinian students through general, conversation, academic
              and business language lessons.
            </p>
            <div class="rz-links">
              <a href="/english-classes" class="rz-link">
                <span class="rz-link-label">English Classes</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/french-classes" class="rz-link">
                <span class="rz-link-label">French Classes</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/german-classes" class="rz-link">
                <span class="rz-link-label">German Classes</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>

      
          <article class="rz-card rz-green">
            <div class="rz-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-6 3V6a2 2 0 0 1 2-2Z" /></svg></div>
            <h3>Asynchronous Learning</h3>
            <p class="rz-description">
              Self-paced asynchronous learning for students whose internet
              does not enable them to join live lessons.
            </p>
            <div class="rz-links">
              <a href="/services" class="rz-link">
                <span class="rz-link-label">Asynchronous Learning</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/resources" class="rz-link">
                <span class="rz-link-label">Resources</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>

          <article class="rz-card">
            <div class="rz-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10v4h4l10 5V5L8 10H4Zm4 4 2 6h3l-2-5M21 9v6" /></svg></div>
            <h3>Palestinian Poetry &amp; Storytelling</h3>
            <p class="rz-description">
              Publishing Palestinian literature, poetry and art from
              our students and wider community.
            </p>
            <div class="rz-links">
              <a href="/palestinian-voices" class="rz-link">
                <span class="rz-link-label">Palestinian Voices</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  )}

  {showInvolved && (
    <section class="rz-section" aria-label="Get involved">
      <div class="rz-wrap">
        <header class="rz-head">
          <p class="rz-eyebrow">Join the effort</p>
          <h2>Get Involved</h2>
          
        </header>

        <div class="rz-grid">
          <article class="rz-card">
            <div class="rz-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M17 4a4 4 0 0 1 0 8M22 21v-2a4 4 0 0 0-3-4" /></svg></div>
            <h3>Teach with Us</h3>
            <p class="rz-description">
              Share your knowledge and teach English, French or German
              to Palestinian students. Applications are closed for the
              autumn term — read about the role for when they reopen.
            </p>
            <a href="/teach-with-us" class="rz-button">
              Explore Teaching
              <span class="rz-arrow" aria-hidden="true">→</span>
            </a>
          </article>

          <article class="rz-card rz-green">
            <div class="rz-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-5 9 5-9 5-9-5Zm4 3v5c3 3 7 3 10 0v-5M21 9v7" /></svg></div>
            <h3>Get your Work Published</h3>
            <p class="rz-description">
              Send us your art pieces, articles, poems, essays and we will publish them on our     
              website and social media channels.
            </p>
            <a href="/palestinian-voices" class="rz-button">
              Explore Palestinian Voices
              <span class="rz-arrow" aria-hidden="true">→</span>
            </a>
          </article>

          <article class="rz-card rz-maroon">
            <div class="rz-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 5c-2-2-5-1-8 2-3-3-6-4-8-2-4 4 2 10 8 14 6-4 12-10 8-14Z" /></svg></div>
            <h3>Make a Donation</h3>
            <p class="rz-description">
              Help us continue our work and reach more students.
            </p>
            <a href="/donate" class="rz-button">
              Donate Now
              <span class="rz-arrow" aria-hidden="true">→</span>
            </a>
          </article>
        </div>
      </div>
    </section>
  )}
</div>
