---
interface Props {
  showTeach?: boolean;
  showInvolved?: boolean;
}

const { showTeach = true, showInvolved = true } = Astro.props;
---

<style>
  /* How We Teach: three vertical cards on wider screens */
  @container (min-width: 880px) {
    .ramzuna-programmes .rz-section:first-child .rz-grid {
      max-width: 960px;
      margin-inline: auto;
    }

    .ramzuna-programmes .rz-section:first-child .rz-card {
      min-height: 440px;
      padding: 30px 24px;
    }
  }

  .ramzuna-programmes,
  .ramzuna-programmes * {
    box-sizing: border-box;
  }

  .ramzuna-programmes {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    background: #f7f1e8;
    color: #2a2622;
    font-family: 'Outfit', system-ui, sans-serif;
    -webkit-text-size-adjust: 100%;
    container-type: inline-size;
  }

  .ramzuna-programmes .rz-section {
    width: 100%;
    padding: 36px 0;
  }

  .ramzuna-programmes .rz-wrap {
    width: 100%;
    margin: 0 auto;
  }

  .ramzuna-programmes .rz-head {
    margin: 0 0 28px;
    text-align: center;
  }

  .ramzuna-programmes .rz-eyebrow {
    display: inline-flex;
    align-items: center;
    margin: 0 0 16px;
    padding: 4px 12px;
    border-radius: 9999px;
    background: #d9e6da;
    color: #38664f;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
  }

  .ramzuna-programmes .rz-head h2 {
    margin: 0;
    color: #38664f;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.25;
  }

  @media (min-width: 640px) {
    .ramzuna-programmes .rz-head h2 {
      font-size: 2.25rem;
    }
  }

  .ramzuna-programmes .rz-closed-note {
    margin: 10px 0 0;
    color: #7a222b;
    font-size: 14px;
    font-weight: 600;
  }

  .ramzuna-programmes .rz-head::after {
    content: "";
    display: block;
    width: 42px;
    height: 2px;
    margin: 18px auto 0;
    background: #7a222b;
    opacity: 0.35;
  }

  .ramzuna-programmes .rz-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 20px;
    width: 100%;
  }

  .ramzuna-programmes .rz-card {
    --rz-accent: #7a222b;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    padding: 26px;
    border: 1px solid rgba(122, 34, 43, 0.12);
    border-radius: 16px;
    background: #fffdfa;
    box-shadow: 0 4px 14px rgba(42, 38, 34, 0.035);
  }

  .ramzuna-programmes .rz-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    margin-bottom: 16px;
    border-radius: 12px;
    background: rgba(122, 34, 43, 0.08);
    font-size: 23px;
    line-height: 1;
  }

  .ramzuna-programmes .rz-card h3 {
    margin: 0 0 12px;
    color: var(--rz-accent);
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-description {
    margin: 0 0 20px;
    color: #514b44;
    font-size: 17px;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: auto;
  }

  .ramzuna-programmes .rz-links::before {
    content: "";
    display: block;
    width: 36px;
    height: 2px;
    margin-bottom: 10px;
    background: var(--rz-accent);
    opacity: 0.35;
  }

  .ramzuna-programmes .rz-link {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 9px;
    width: fit-content;
    min-height: 44px;
    padding: 10px 0;
    color: var(--rz-accent);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    touch-action: manipulation;
  }

  .ramzuna-programmes .rz-link-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: 9px;
    width: fit-content;
    max-width: 100%;
    min-height: 44px;
    margin-top: auto;
    padding: 10px 15px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--rz-accent);
    color: #fff;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    touch-action: manipulation;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-arrow {
    flex-shrink: 0;
    font-size: 19px;
    line-height: 1;
  }

  .ramzuna-programmes .rz-link:focus-visible,
  .ramzuna-programmes .rz-button:focus-visible {
    outline: 3px solid var(--rz-accent);
    outline-offset: 4px;
  }

  .ramzuna-programmes .rz-green {
    --rz-accent: #38664f;
    background: #eaf0e9;
    border-color: #d3dfd3;
  }

  .ramzuna-programmes .rz-green .rz-icon {
    background: #d9e6da;
  }

  .ramzuna-programmes .rz-maroon {
    background: #7a222b;
    border-color: #7a222b;
  }

  .ramzuna-programmes .rz-maroon .rz-icon {
    background: rgba(255, 255, 255, 0.12);
  }

  .ramzuna-programmes .rz-maroon h3 {
    color: #fff;
  }

  .ramzuna-programmes .rz-maroon .rz-description {
    color: #f5e9e9;
  }

  .ramzuna-programmes .rz-maroon .rz-button {
    background: #fffdfa;
    color: #7a222b;
  }

  .ramzuna-programmes .rz-maroon .rz-button:focus-visible {
    outline-color: #fff;
  }

  @container (max-width: 879px) {
    .ramzuna-programmes .rz-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ramzuna-programmes .rz-card {
      padding: 24px 20px;
    }
  }

  @media (max-width: 600px) {
    .ramzuna-programmes .rz-section {
      padding: 30px 0;
    }

    .ramzuna-programmes .rz-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ramzuna-programmes .rz-card {
      padding: 24px 20px;
    }
  }

  @supports not (container-type: inline-size) {
    @media (max-width: 960px) {
      .ramzuna-programmes .rz-grid {
        grid-template-columns: 1fr;
      }
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .ramzuna-programmes .rz-link:hover,
    .ramzuna-programmes .rz-button:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  /* Bigger, roomier cards on desktop — mobile stays exactly as-is */
  @media (min-width: 1280px) {
    .ramzuna-programmes {
      max-width: 1120px;
    }

    .ramzuna-programmes .rz-card {
      padding: 34px 30px;
      border-radius: 20px;
    }

    .ramzuna-programmes .rz-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      font-size: 27px;
    }

    .ramzuna-programmes .rz-card h3 {
      font-size: 1.3rem;
    }

    .ramzuna-programmes .rz-description {
      font-size: 18px;
      line-height: 1.7;
    }

    .ramzuna-programmes .rz-link,
    .ramzuna-programmes .rz-button {
      font-size: 16px;
    }
  }
</style>

<div class="ramzuna-programmes">
  {showTeach && (
    <section class="rz-section" aria-label="How we teach">
      <div class="rz-wrap">
        <header class="rz-head">
          <p class="rz-eyebrow">Language Lab</p>
          <h2>How We Teach</h2>
        </header>

        <div class="rz-grid">
          <article class="rz-card">
            <div class="rz-icon" aria-hidden="true">🎓</div>
            <h3>Language Lessons</h3>
            <p class="rz-description">
              Empowering Palestinian students through general, academic
              and business language lessons.
            </p>
            <div class="rz-links">
              <a href="/english-classes" class="rz-link">
                <span class="rz-link-label">English Classes</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/french-classes" class="rz-link">
                <span class="rz-link-label">French Classes</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/german-classes" class="rz-link">
                <span class="rz-link-label">German Classes</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>

          <article class="rz-card rz-green">
            <div class="rz-icon" aria-hidden="true">💬</div>
            <h3>Conversations &amp; Asynchronous Learning</h3>
            <p class="rz-description">
              Weekly, one-on-one conversation practice with no fixed curriculum,
              plus self-paced asynchronous learning for students whose internet
              does not enable them to join live lessons.
            </p>
            <div class="rz-links">
              <a href="/services" class="rz-link">
                <span class="rz-link-label">Conversation Sessions</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/services" class="rz-link">
                <span class="rz-link-label">Asynchronous Learning</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/resources" class="rz-link">
                <span class="rz-link-label">Resources</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>

          <article class="rz-card">
            <div class="rz-icon" aria-hidden="true">📢</div>
            <h3>Palestinian Poetry &amp; Storytelling</h3>
            <p class="rz-description">
              Publishing Palestinian literature, poetry and art from
              our students and wider community.
            </p>
            <div class="rz-links">
              <a href="/services" class="rz-link">
                <span class="rz-link-label">Storytelling Classes</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/palestinian-voices" class="rz-link">
                <span class="rz-link-label">Palestinian Voices</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  )}

  {showInvolved && (
    <section class="rz-section" aria-label="Get involved">
      <div class="rz-wrap">
        <header class="rz-head">
          <p class="rz-eyebrow">Join the effort</p>
          <h2>Get Involved</h2>
          <p class="rz-closed-note">Student enrolment and volunteer applications are currently closed for the autumn term.</p>
        </header>

        <div class="rz-grid">
          <article class="rz-card">
            <div class="rz-icon" aria-hidden="true">👥</div>
            <h3>Teach with Us</h3>
            <p class="rz-description">
              Share your knowledge and teach English, French or German
              to Palestinian students. Applications are closed for the
              autumn term — read about the role for when they reopen.
            </p>
            <a href="/teach-with-us" class="rz-button">
              Learn More
              <span class="rz-arrow" aria-hidden="true">→</span>
            </a>
          </article>

          <article class="rz-card rz-green">
            <div class="rz-icon" aria-hidden="true">🎓</div>
            <h3>Become a Language Partner</h3>
            <p class="rz-description">
              Support Palestinian students as they improve their
              conversation skills. Applications are closed for the
              autumn term — read about the role for when they reopen.
            </p>
            <a href="/become-a-conversation-partner" class="rz-button">
              Learn More
              <span class="rz-arrow" aria-hidden="true">→</span>
            </a>
          </article>

          <article class="rz-card rz-maroon">
            <div class="rz-icon" aria-hidden="true">🤝</div>
            <h3>Make a Donation</h3>
            <p class="rz-description">
              Help us continue our work and reach more students — this stays open any time.
            </p>
            <a href="/donate" class="rz-button">
              Donate Now
              <span class="rz-arrow" aria-hidden="true">→</span>
            </a>
          </article>
        </div>
      </div>
    </section>
  )}
</div>
