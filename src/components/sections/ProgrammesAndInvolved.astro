---
interface Props {
  showTeach?: boolean;
  showInvolved?: boolean;
  homepage?: boolean;
  enrolmentNote?: string;
}

const { showTeach = true, showInvolved = true, homepage = false, enrolmentNote } = Astro.props;
---

<style>
  /* How We Teach: three vertical cards on wider screens */
  @container (min-width: 880px) {
    .ramzuna-programmes .rz-section[aria-label="How we teach"] .rz-card {
      min-height: 0;
      padding: 28px 26px;
    }

    .ramzuna-programmes .rz-section[aria-label="How we teach"] .rz-icon {
      width: 56px;
      height: 56px;
      font-size: 30px;
      margin-bottom: 18px;
    }

    .ramzuna-programmes .rz-section[aria-label="How we teach"] h3 {
      font-size: 1.375rem;
      margin-bottom: 14px;
    }

    .ramzuna-programmes .rz-section[aria-label="How we teach"] .rz-description {
      font-size: 18px;
    }
  }

  .ramzuna-programmes,
  .ramzuna-programmes * {
    box-sizing: border-box;
  }

  .ramzuna-programmes {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    background: transparent;
    color: #2a2622;
    font-family: 'Outfit', system-ui, sans-serif;
    -webkit-text-size-adjust: 100%;
    container-type: inline-size;
  }

  .ramzuna-programmes .rz-section {
    width: 100%;
    padding: 56px 24px;
  }

  .ramzuna-programmes .rz-wrap {
    width: 100%;
    margin: 0 auto;
  }

  .ramzuna-programmes .rz-head {
    margin: 0 0 28px;
    text-align: center;
  }

  .ramzuna-programmes .rz-eyebrow {
    display: inline-flex;
    align-items: center;
    margin: 0 0 16px;
    padding: 4px 12px;
    border-radius: 9999px;
    background: #d9e6da;
    color: #38664f;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
  }

  .ramzuna-programmes .rz-head h2 {
    margin: 0;
    color: #38664f;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.25;
  }

  @media (min-width: 640px) {
    .ramzuna-programmes .rz-head h2 {
      font-size: 2.25rem;
    }
  }

  .ramzuna-programmes .rz-closed-note {
    margin: 10px 0 0;
    color: #7a222b;
    font-size: 14px;
    font-weight: 600;
  }

  .ramzuna-programmes .rz-head::after {
    content: "";
    display: block;
    width: 42px;
    height: 2px;
    margin: 18px auto 0;
    background: #7a222b;
    opacity: 0.35;
  }

  .ramzuna-programmes .rz-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 20px;
    width: 100%;
  }

  .ramzuna-programmes .rz-card {
    --rz-accent: #7a222b;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    padding: 26px;
    border: 1px solid rgba(122, 34, 43, 0.12);
    border-radius: 16px;
    background: #fffdfa;
    box-shadow: 0 4px 14px rgba(42, 38, 34, 0.035);
  }

  .ramzuna-programmes .rz-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    margin-bottom: 16px;
    border-radius: 12px;
    background: rgba(122, 34, 43, 0.08);
    font-size: 23px;
    line-height: 1;
  }

  .ramzuna-programmes .rz-card h3 {
    margin: 0 0 12px;
    color: var(--rz-accent);
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-description {
    margin: 0 0 20px;
    color: #514b44;
    font-size: 17px;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: auto;
  }

  .ramzuna-programmes .rz-links::before {
    content: "";
    display: block;
    width: 36px;
    height: 2px;
    margin-bottom: 10px;
    background: var(--rz-accent);
    opacity: 0.35;
  }

  .ramzuna-programmes .rz-link {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 9px;
    width: fit-content;
    min-height: 44px;
    padding: 10px 0;
    color: var(--rz-accent);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    touch-action: manipulation;
  }

  .ramzuna-programmes .rz-link-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: 9px;
    width: fit-content;
    max-width: 100%;
    min-height: 44px;
    margin-top: auto;
    padding: 10px 15px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--rz-accent);
    color: #fff;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    touch-action: manipulation;
    overflow-wrap: anywhere;
  }

  .ramzuna-programmes .rz-arrow {
    flex-shrink: 0;
    font-size: 19px;
    line-height: 1;
  }

  .ramzuna-programmes .rz-link:focus-visible,
  .ramzuna-programmes .rz-button:focus-visible {
    outline: 3px solid var(--rz-accent);
    outline-offset: 4px;
  }

  .ramzuna-programmes .rz-green {
    --rz-accent: #38664f;
    background: #eaf0e9;
    border-color: #d3dfd3;
  }

  .ramzuna-programmes .rz-green .rz-icon {
    background: #d9e6da;
  }

  .ramzuna-programmes .rz-maroon {
    background: #7a222b;
    border-color: #7a222b;
  }

  .ramzuna-programmes .rz-maroon .rz-icon {
    background: rgba(255, 255, 255, 0.12);
  }

  .ramzuna-programmes .rz-maroon h3 {
    color: #fff;
  }

  .ramzuna-programmes .rz-maroon .rz-description {
    color: #f5e9e9;
  }

  .ramzuna-programmes .rz-maroon .rz-button {
    background: #fffdfa;
    color: #7a222b;
  }

  .ramzuna-programmes .rz-maroon .rz-button:focus-visible {
    outline-color: #fff;
  }

  @container (max-width: 879px) {
    .ramzuna-programmes .rz-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ramzuna-programmes .rz-card {
      padding: 24px 20px;
    }
  }

  @media (max-width: 600px) {
    .ramzuna-programmes .rz-section {
      padding: 40px 16px;
    }

    .ramzuna-programmes .rz-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ramzuna-programmes .rz-card {
      padding: 24px 20px;
    }
  }

  @supports not (container-type: inline-size) {
    @media (max-width: 960px) {
      .ramzuna-programmes .rz-grid {
        grid-template-columns: 1fr;
      }
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .ramzuna-programmes .rz-link:hover,
    .ramzuna-programmes .rz-button:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  /* Bigger, roomier cards on desktop — mobile stays exactly as-is */
  @media (min-width: 1280px) {
    .ramzuna-programmes {
      max-width: 1200px;
    }

    .ramzuna-programmes .rz-card {
      padding: 34px 30px;
      border-radius: 20px;
    }

    .ramzuna-programmes .rz-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      font-size: 26px;
    }

    .ramzuna-programmes .rz-card h3 {
      font-size: 1.3rem;
    }

    .ramzuna-programmes .rz-description {
      font-size: 17px;
      line-height: 1.7;
    }

    .ramzuna-programmes .rz-link,
    .ramzuna-programmes .rz-button {
      font-size: 15px;
    }
  }

  .rz-icon { color: var(--rz-accent); }
  .rz-maroon .rz-icon { color: #fff; }
  @container (min-width: 880px) {
    .rz-homepage .rz-section[aria-label="Get involved"] .rz-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  }
  @container (min-width: 1100px) {
    .rz-homepage .rz-section[aria-label="Get involved"] .rz-grid { grid-template-columns: repeat(4, minmax(0,1fr)); }
    .rz-homepage .rz-section[aria-label="Get involved"] .rz-card { padding: 24px 20px; }
  }
  :global(.dark) .ramzuna-programmes .rz-head h2 { color: #f7f1e8; }
  :global(.dark) .ramzuna-programmes .rz-closed-note { color: #e8b7bd; }
  :global(.dark) .ramzuna-programmes .rz-card:not(.rz-maroon) {
    --rz-accent: #b7d7bd; background: #202923; border-color: #45594a;
  }
  :global(.dark) .ramzuna-programmes .rz-card:not(.rz-maroon) .rz-description { color: #e3e7e2; }
  :global(.dark) .ramzuna-programmes .rz-card:not(.rz-maroon) .rz-icon { background: #34493a; }
  :global(.dark) .ramzuna-programmes .rz-card:not(.rz-maroon) .rz-button { color: #14251b; }
</style>

<div class:list={["ramzuna-programmes", homepage && "rz-homepage"]}>
  {showTeach && (
    <section class="rz-section" aria-label="How we teach">
      <div class="rz-wrap">
        <header class="rz-head">
          <p class="rz-eyebrow">Language Lab</p>
          <h2>How We Teach</h2>
        </header>

        <div class="rz-grid">
          <article class="rz-card">
            <div class="rz-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m2 9 10-5 10 5-10 5-10-5Zm4 2v6c4 3 8 3 12 0v-6m4-2v7"/></svg></div>
            <h3>Language Lessons & Conversations</h3>
            <p class="rz-description">
              Empowering Palestinian students through general, conversation, academic
              and business language lessons.
            </p>
            <div class="rz-links">
              <a href="/english-classes" class="rz-link">
                <span class="rz-link-label">English Classes</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/french-classes" class="rz-link">
                <span class="rz-link-label">French Classes</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/german-classes" class="rz-link">
                <span class="rz-link-label">German Classes</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>

      
          <article class="rz-card rz-green">
            <div class="rz-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11a9 9 0 0 1-9 9H4l2-4a9 9 0 1 1 15-5Z"/><path d="M8 11h8"/></svg></div>
            <h3>Asynchronous Learning</h3>
            <p class="rz-description">
              Self-paced asynchronous learning for students whose internet
              does not enable them to join live lessons.
            </p>
            <div class="rz-links">
              <a href="/services" class="rz-link">
                <span class="rz-link-label">Asynchronous Learning</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/resources" class="rz-link">
                <span class="rz-link-label">Resources</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>

          <article class="rz-card">
            <div class="rz-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 15-6v16L3 14v-4Zm4 6 2 5m12-13v8"/></svg></div>
            <h3>Palestinian Poetry &amp; Storytelling</h3>
            <p class="rz-description">
              Publishing Palestinian literature, poetry and art from
              our students and wider community.
            </p>
            <div class="rz-links">
              <a href="/palestinian-voices" class="rz-link">
                <span class="rz-link-label">Palestinian Voices</span>
                <span class="rz-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  )}

  {showInvolved && (
    <section class="rz-section" aria-label="Get involved">
      <div class="rz-wrap">
        <header class="rz-head">
          <p class="rz-eyebrow">Join the effort</p>
          <h2>Get Involved</h2>
          <p class="rz-closed-note">{enrolmentNote || "Student enrolment and volunteer applications are currently closed for the autumn term."}</p>
        </header>

        <div class="rz-grid">
          {homepage && (
            <article class="rz-card rz-green">
              <div class="rz-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14M3 18V4c4-1 7 0 9 3 2-3 5-4 9-3v14c-4-1-7 0-9 3-2-3-5-4-9-3Z"/></svg></div>
              <h3>Study With Us</h3>
              <p class="rz-description">Discover our free lessons, how enrolment works and learning resources you can use now.</p>
              <a href="/study-with-us" class="rz-button">Study With Us <span class="rz-arrow" aria-hidden="true">→</span></a>
            </article>
          )}
          <article class="rz-card">
            <div class="rz-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 20v-3a6 6 0 0 1 12 0v3m2-15a3 3 0 0 1 0 6m1 3a5 5 0 0 1 3 5v1"/></svg></div>
            <h3>Teach with Us</h3>
            <p class="rz-description">
              Share your knowledge and teach English, French or German
              to Palestinian students. {!homepage && "Applications are closed for the autumn term — read about the role for when they reopen."}
            </p>
            <a href="/teach-with-us" class="rz-button">
              Explore Teaching
              <span class="rz-arrow" aria-hidden="true">→</span>
            </a>
          </article>

          <article class="rz-card rz-green">
            <div class="rz-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m2 9 10-5 10 5-10 5-10-5Zm4 2v6c4 3 8 3 12 0v-6m4-2v7"/></svg></div>
            <h3>{homepage ? "Share Your Voice" : "Get your Work Published"}</h3>
            <p class="rz-description">
              Share your art, articles, poems and essays through Palestinian Voices.
            </p>
            <a href="/palestinian-voices" class="rz-button">
              Explore Palestinian Voices
              <span class="rz-arrow" aria-hidden="true">→</span>
            </a>
          </article>

          <article class="rz-card rz-maroon">
            <div class="rz-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 8.6c0 4-8.8 10-8.8 10s-8.8-6-8.8-10a4.5 4.5 0 0 1 8.8-1 4.5 4.5 0 0 1 8.8 1Z"/></svg></div>
            <h3>Make a Donation</h3>
            <p class="rz-description">
              Help us continue our work and reach more students.
            </p>
            <a href="/donate" class="rz-button">
              Donate Now
              <span class="rz-arrow" aria-hidden="true">→</span>
            </a>
          </article>
        </div>
      </div>
    </section>
  )}
</div>
