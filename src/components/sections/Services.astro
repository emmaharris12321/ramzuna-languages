---
interface ServiceLink {
  text: string;
  url: string;
}

interface Service {
  icon: string;
  title: string;
  description: string;
  highlight?: boolean;
  links?: ServiceLink[];
}

interface Props {
  badge?: string;
  title: string;
  description: string;
  services: Service[];
}

const { badge, title, description, services } = Astro.props;

const icons: Record<string, string> = {
  local:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />',
  longDistance:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />',
  commercial:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />',
  packing:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />',
  storage:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />',
  specialty:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />',
  graduation:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422A12.083 12.083 0 0118 14.5m-6-.5v6m0-6l-6.16-3.422A12.083 12.083 0 006 14.5m6-.5c-2.21 0-4-.895-4-2s1.79-2 4-2 4 .895 4 2-1.79 2-4 2z" />',
  chat:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />',
  megaphone:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />',
};
---

<section id="services" class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      {
        badge && (
          <div
            class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300"
            data-animate="fade-in-up"
          >
            {badge}
          </div>
        )
      }
      <h2
        class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
        data-animate="fade-in-up"
        data-delay="100"
      >
        {title}
      </h2>
      <p
        class="mt-4 text-lg text-gray-600 dark:text-gray-400"
        data-animate="fade-in-up"
        data-delay="200"
      >
        {description}
      </p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, index) => (
          <div
            class={`group relative rounded-2xl p-8 shadow-soft transition-all hover:shadow-soft-lg ${service.highlight ? 'bg-primary-50 dark:bg-primary-900/20' : 'bg-white dark:bg-gray-800'}`}
            data-animate="fade-in-up"
            data-delay={100 + index * 50}
          >
            <div class="mb-5 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-primary-100 text-primary-600 transition-colors group-hover:bg-primary-600 group-hover:text-white dark:bg-primary-900/50 dark:text-primary-400">
              <svg
                class="h-7 w-7"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                set:html={icons[service.icon] || icons.local}
              />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              {service.title}
            </h3>
            <p class="mt-3 text-gray-600 dark:text-gray-400">
              {service.description}
            </p>
            {
              service.links && service.links.length > 0 && (
                <div class="mt-6 space-y-3 border-t border-gray-200 pt-5 dark:border-gray-700">
                  {service.links.map((link) => (
                    <a
                      href={link.url}
                      class="flex items-center gap-1.5 text-sm font-bold text-primary-700 transition-colors hover:text-primary-800 dark:text-primary-400 dark:hover:text-primary-300"
                    >
                      {link.text}
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        ))
      }
    </div>
  </div>
</section>
