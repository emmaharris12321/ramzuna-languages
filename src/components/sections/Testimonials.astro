---
interface Testimonial {
  quote: string;
  author: string;
  role: string;
  rating?: number;
}

interface Props {
  badge?: string;
  title: string;
  description: string;
  testimonials: Testimonial[];
}

const { badge, title, description, testimonials } = Astro.props;
---

<section id="testimonials" class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      {
        badge && (
          <div
            class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300"
            data-animate="fade-in-up"
          >
            {badge}
          </div>
        )
      }
      <h2
        class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
        data-animate="fade-in-up"
        data-delay="100"
      >
        {title}
      </h2>
      <p
        class="mt-4 text-lg text-gray-600 dark:text-gray-400"
        data-animate="fade-in-up"
        data-delay="200"
      >
        {description}
      </p>
    </div>

    <div class="relative mt-16" data-carousel>
      <div class="overflow-hidden">
      <div class="flex transition-transform duration-500 ease-out" data-carousel-track>
      {
        testimonials.map((testimonial, index) => (
          <div class="flex-shrink-0 px-3" data-carousel-slide>
          <div
            class="rounded-2xl bg-white p-8 shadow-soft dark:bg-gray-800"
            data-animate="fade-in-up"
            data-delay={100 + index * 100}
          >
            {testimonial.rating && (
              <div class="mb-6 flex gap-1">
                {Array.from({ length: testimonial.rating }).map(() => (
                  <svg
                    class="h-5 w-5 text-yellow-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
            )}
            <blockquote class="text-lg font-medium text-gray-900 dark:text-white">
              &ldquo;{testimonial.quote}&rdquo;
            </blockquote>
            <div class="mt-6 flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-100 text-lg font-semibold text-primary-600 dark:bg-primary-900 dark:text-primary-400">
                {testimonial.author.charAt(0).toUpperCase()}
              </div>
              <div>
                <div class="font-semibold text-gray-900 dark:text-white">
                  {testimonial.author}
                </div>
                <div class="text-sm text-gray-600 dark:text-gray-400">
                  {testimonial.role}
                </div>
              </div>
            </div>
          </div>
          </div>
        ))
      }
    </div>
    </div>
    <!-- Navigation arrows -->
    <button type="button" data-carousel-prev class="absolute -left-4 top-1/2 hidden -translate-y-1/2 items-center justify-center rounded-full bg-white p-2 shadow-lg transition-colors hover:bg-cream-100 dark:bg-gray-800 dark:hover:bg-gray-700 lg:flex" aria-label="Previous testimonial">
      <svg class="h-5 w-5 text-gray-600 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <button type="button" data-carousel-next class="absolute -right-4 top-1/2 hidden -translate-y-1/2 items-center justify-center rounded-full bg-white p-2 shadow-lg transition-colors hover:bg-cream-100 dark:bg-gray-800 dark:hover:bg-gray-700 lg:flex" aria-label="Next testimonial">
      <svg class="h-5 w-5 text-gray-600 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    </button>
    <!-- Dots -->
    <div class="mt-8 flex justify-center gap-2" data-carousel-dots></div>
    </div>
  </div>
</section>
