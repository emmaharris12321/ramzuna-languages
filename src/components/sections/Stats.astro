---
interface Props {
  stats: { value: string; label: string }[];
}
const { stats } = Astro.props;
---
<section aria-labelledby="impact-title" class="bg-primary-700 py-10 text-white lg:py-14">
  <div class="container mx-auto px-4 lg:px-8">
    <h2 id="impact-title" class="text-center font-display text-2xl font-semibold sm:text-3xl">Our Impact in Numbers</h2>
    <dl class="mx-auto mt-8 grid max-w-5xl grid-cols-2 gap-x-4 gap-y-7 text-center md:grid-cols-4">
      {stats.map(stat => (
        <div class="flex flex-col-reverse">
          <dt class="mt-2 text-sm font-medium text-white">{stat.label}</dt>
          <dd class="text-3xl font-bold tabular-nums sm:text-4xl">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
