---
interface Area {
  city: string;
  detail: string;
}

interface Props {
  badge?: string;
  title: string;
  description: string;
  localAreas: Area[];
  longDistanceRoutes: Area[];
}

const { badge, title, description, localAreas, longDistanceRoutes } = Astro.props;
---

<section id="areas" class="bg-cream-100 py-20 lg:py-28 dark:bg-gray-900">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      {
        badge && (
          <div
            class="mb-4 inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300"
            data-animate="fade-in-up"
          >
            {badge}
          </div>
        )
      }
      <h2
        class="font-display text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
        data-animate="fade-in-up"
        data-delay="100"
      >
        {title}
      </h2>
      <p
        class="mt-4 text-lg text-gray-600 dark:text-gray-400"
        data-animate="fade-in-up"
        data-delay="200"
      >
        {description}
      </p>
    </div>

    <div class="mt-16 grid gap-8 lg:grid-cols-2">
      <!-- Local Moves -->
      <div
        class="rounded-2xl bg-white p-8 shadow-soft dark:bg-gray-800"
        data-animate="fade-in-up"
        data-delay="100"
      >
        <div class="mb-6 flex items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-primary-600 dark:bg-primary-900/50 dark:text-primary-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-display text-2xl font-semibold text-gray-900 dark:text-white">Students in Palestine</h3>
        </div>
        <p class="mb-6 text-gray-600 dark:text-gray-400">Active learning programs reaching students across the region.</p>
        <ul class="space-y-4">
          {
            localAreas.map((area) => (
              <li class="flex items-center justify-between rounded-lg border border-gray-100 px-4 py-3 transition-colors hover:border-primary-200 hover:bg-primary-50/50 dark:border-gray-700 dark:hover:border-primary-800 dark:hover:bg-primary-900/20">
                <div class="flex items-center gap-3">
                  <svg class="h-5 w-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="font-medium text-gray-900 dark:text-white">{area.city}</span>
                </div>
                <span class="text-sm text-gray-500 dark:text-gray-400">{area.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Long Distance -->
      <div
        class="rounded-2xl bg-white p-8 shadow-soft dark:bg-gray-800"
        data-animate="fade-in-up"
        data-delay="200"
      >
        <div class="mb-6 flex items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-100 text-accent-600 dark:bg-accent-900/50 dark:text-accent-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </div>
          <h3 class="font-display text-2xl font-semibold text-gray-900 dark:text-white">Volunteer Educators Worldwide</h3>
        </div>
        <p class="mb-6 text-gray-600 dark:text-gray-400">A global network of volunteer educators teaching from every timezone.</p>
        <ul class="space-y-4">
          {
            longDistanceRoutes.map((route) => (
              <li class="flex items-center justify-between rounded-lg border border-gray-100 px-4 py-3 transition-colors hover:border-accent-200 hover:bg-accent-50/50 dark:border-gray-700 dark:hover:border-accent-800 dark:hover:bg-accent-900/20">
                <div class="flex items-center gap-3">
                  <svg class="h-5 w-5 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                  <span class="font-medium text-gray-900 dark:text-white">{route.city}</span>
                </div>
                <span class="text-sm text-gray-500 dark:text-gray-400">{route.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
