---
import Base from '@/layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  category: string;
  image: string;
  readTime: string;
  author: {
    name: string;
    role: string;
    image: string;
  };
  relatedPosts?: {
    id: string;
    data: {
      title: string;
      description: string;
      date: string;
      category: string;
      image: string;
      readTime: string;
      author: {
        name: string;
        role: string;
        image: string;
      };
    };
  }[];
}

const { title, description, date, category, image, readTime, author, relatedPosts } = Astro.props;
---

<Base title={title} description={description}>
  <article>
    <!-- Article Header -->
    <div class="bg-white pt-8 dark:bg-gray-950">
      <div class="container mx-auto px-4 lg:px-8">
        <div class="mx-auto max-w-3xl">
          <a href="/blog" class="inline-flex items-center gap-2 text-sm font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Blog
          </a>
          <nav class="mt-4 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400" aria-label="Breadcrumb">
            <a href="/" class="transition-colors hover:text-gray-900 dark:hover:text-white">Home</a>
            <span>/</span>
            <a href="/blog" class="transition-colors hover:text-gray-900 dark:hover:text-white">Blog</a>
            <span>/</span>
            <span class="text-gray-900 dark:text-white">Article</span>
          </nav>
          <div class="mt-6">
            <span class="inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-xs font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">{category}</span>
          </div>
          <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl dark:text-white">{title}</h1>
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">{description}</p>
          <div class="mt-6 flex items-center gap-4 border-b border-gray-200 pb-8 dark:border-gray-800">
            <img src={author.image} alt={author.name} class="h-10 w-10 rounded-full object-cover" />
            <div>
              <div class="text-sm font-medium text-gray-900 dark:text-white">{author.name}</div>
              <div class="text-sm text-gray-500 dark:text-gray-400">{date} &middot; {readTime}</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Image -->
    <div class="bg-white dark:bg-gray-950">
      <div class="container mx-auto px-4 py-8 lg:px-8">
        <div class="mx-auto max-w-4xl overflow-hidden rounded-2xl">
          <img src={image} alt={title} class="h-auto w-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>

    <!-- Article Content -->
    <div class="bg-white py-8 lg:py-12 dark:bg-gray-950">
      <div class="container mx-auto px-4 lg:px-8">
        <div class="prose prose-lg mx-auto max-w-3xl dark:prose-invert prose-headings:font-bold prose-a:text-primary-600 dark:prose-a:text-primary-400">
          <slot />
        </div>
      </div>
    </div>

    <!-- Social Sharing -->
    <div class="bg-white py-8 dark:bg-gray-950">
      <div class="container mx-auto px-4 lg:px-8">
        <div class="mx-auto max-w-3xl border-t border-gray-200 pt-8 dark:border-gray-800">
          <p class="text-sm font-medium text-gray-900 dark:text-white">Share this article</p>
          <div class="mt-4 flex gap-3">
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition-colors hover:bg-[#1DA1F2] hover:text-white dark:bg-gray-800 dark:text-gray-400" aria-label="Share on X"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition-colors hover:bg-[#1877F2] hover:text-white dark:bg-gray-800 dark:text-gray-400" aria-label="Share on Facebook"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
            <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition-colors hover:bg-[#0A66C2] hover:text-white dark:bg-gray-800 dark:text-gray-400" aria-label="Share on LinkedIn"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
            <button type="button" data-copy-link class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition-colors hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-400" aria-label="Copy link"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg></button>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Related Articles -->
  {relatedPosts && relatedPosts.length > 0 && (
    <div class="bg-cream-100 py-16 lg:py-20 dark:bg-gray-900/50">
      <div class="container mx-auto px-4 lg:px-8">
        <div class="mx-auto max-w-5xl">
          <h2 class="font-display text-2xl font-semibold text-gray-900 dark:text-white">Related Articles</h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map((rp) => (
              <a href={`/blog/${rp.id}`} class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-200 transition-all hover:shadow-lg dark:bg-gray-900 dark:ring-gray-800">
                <div class="aspect-[3/2] overflow-hidden">
                  <img src={rp.data.image} alt={rp.data.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                </div>
                <div class="p-5">
                  <span class="inline-flex items-center rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">{rp.data.category}</span>
                  <h3 class="mt-2 text-base font-bold text-gray-900 transition-colors group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">{rp.data.title}</h3>
                  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{rp.data.date}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}
</Base>
